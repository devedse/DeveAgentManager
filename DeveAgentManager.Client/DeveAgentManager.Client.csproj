<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- The Portal: runs in the browser (WebAssembly) and talks to the Manager only through its API, its live hub
       and terminal WebSockets. Nothing here can reach a Runner, the database or a secret by itself. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.10.0" />
    <PackageReference Include="XtermBlazor" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeveAgentManager.Contracts\DeveAgentManager.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API's data is (de)serialized by reflection: keep every member of the shared types when trimming. -->
    <TrimmerRootAssembly Include="DeveAgentManager.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeveAgentManager.Tests" />
  </ItemGroup>

</Project>
