@inject ManagerApi Api

<MudDialog>
    <TitleContent><div class="help-heading"><MudText Typo="Typo.h6">New conversation</MudText>
        <HelpTip Label="New conversation"><p>Saves and stops the current conversation in this workspace, then starts a fresh conversation in the same folder. Other workspace agents keep running. This does not create a worktree or copy files.</p></HelpTip></div></TitleContent>
    <DialogContent>
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
        <MudTextField @bind-Value="_title" Label="Conversation name (optional)" MaxLength="200" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
    </DialogContent>
    <DialogActions><MudButton OnClick="() => Dialog.Cancel()" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="CreateAsync" Disabled="_busy">@(_busy ? "Starting…" : "Start new conversation")</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
    private string? _title, _error;
    private bool _busy;
    private async Task CreateAsync()
    {
        _busy = true; _error = null;
        try { await Api.SelectSessionAsync(Agent.Id, null, _title); Dialog.Close(DialogResult.Ok(true)); }
        catch (ApiException ex) { _error = ex.Message; }
        catch (HttpRequestException) { _error = LoadingSection.Unreachable; }
        finally { _busy = false; }
    }
}
