@inherits LiveComponent
@inject IDialogService Dialogs
@inject SignedInUser Me

<MudDialog>
    <DialogContent>
        <AccessList People="People" UserId="_userId" Loaded="Loaded" Error="@LoadError" Retry="RetryAsync" CanAdd="true" Busy="_busy" Add="AddAsync">
            <Help>
                <p>Use permits choosing this login and making it a personal default. Manage also permits reconnecting, granting access and removing the login. At least one enabled manager must remain.</p>
                <p>Removing Use stops affected agents. Permission to prompt another person's shared agent is separate.</p>
            </Help>
            <Actions Context="person">
                @{ var grant = _grants.Single(g => g.UserId == person.Id && g.AgentId?.ToString() == person.Key); }
                <AccessMenu Disabled="_busy" Label="@($"Access for {person.Username}")">
                    @if (grant.AgentId is null)
                    {
                        <MudMenuItem Icon="@Icons.Material.Rounded.Tune" OnClick="() => SetAsync(grant.UserId, grant.Access == AccountAccess.Use ? AccountAccess.Manage : AccountAccess.Use)">Change to @(grant.Access == AccountAccess.Use ? "Manage" : "Use")</MudMenuItem>
                    }
                    <MudMenuItem Icon="@Icons.Material.Rounded.PersonRemove" IconColor="Color.Error" OnClick="() => RemoveAsync(grant)">@(grant.UserId == _userId ? "Leave access…" : "Remove access…")</MudMenuItem>
                </AccessMenu>
            </Actions>
        </AccessList>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => Dialog.Close()">Done</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public AccountDto Account { get; set; } = default!;
    private List<AccountGrantDto> _grants = [];
    private Guid _userId;
    private bool _busy;
    private IReadOnlyList<AccessPerson> People => _grants.Select(g => new AccessPerson(g.UserId, g.Username, g.DisplayName,
        g.AgentId is null ? g.Access.ToString() : "Use · existing agent only", Disabled: g.Disabled, Key: g.AgentId?.ToString())).ToList();
    protected override async Task LoadAsync()
    {
        _userId = (await Me.GetAsync()).Id;
        _grants = await Api.ListAccountGrantsAsync(Account.Id);
    }
    private async Task SetAsync(Guid userId, AccountAccess level)
    {
        if (_busy) return;
        _busy = true;
        try { await Api.SetAccountGrantAsync(Account.Id, userId, level); await ReloadAsync(); }
        catch (ApiException e) { Snackbar.Add(e.Message, Severity.Error); }
        catch (HttpRequestException) { Snackbar.Add(LoadingSection.Unreachable, Severity.Error); }
        finally { _busy = false; }
    }
    private async Task RemoveAsync(AccountGrantDto grant)
    {
        if (_busy) return;
        if (!await AccountImpactDialog.ConfirmAsync(Dialogs, Account, grant.UserId, $"Remove {grant.DisplayName}'s access", "Remove")) return;
        _busy = true;
        try
        {
            if (grant.AgentId is { } agentId) await Api.RemoveLegacyLoginGrantAsync(Account.Id, agentId);
            else await Api.RemoveAccountGrantAsync(Account.Id, grant.UserId);
            if (grant.UserId == (await Me.GetAsync()).Id) Dialog.Close();
            else await ReloadAsync();
        }
        catch (ApiException e) { Snackbar.Add(e.Message, Severity.Error); }
        catch (HttpRequestException) { Snackbar.Add(LoadingSection.Unreachable, Severity.Error); }
        finally { _busy = false; }
    }
    private async Task AddAsync()
    {
        var dialog = await Dialogs.ShowAsync<ChooseUserDialog>("Give login access", new DialogParameters<ChooseUserDialog>
        {
            { d => d.Exclude, _grants.Where(g => g.AgentId is null).Select(g => g.UserId).ToList() },
            { d => d.Confirm, "Add" },
            { d => d.Level, (int)AccountAccess.Use },
            { d => d.Levels, new List<(int, string, string)> {
                ((int)AccountAccess.Use, "Use", "Run agents with this login."),
                ((int)AccountAccess.Manage, "Manage", "Also reconnect, share, disable and remove it.") } }
        });
        if (await dialog.Result is { Canceled: false, Data: ChooseUserDialog.ChosenUser choice })
            await SetAsync(choice.UserId, (AccountAccess)choice.Level);
    }
}
