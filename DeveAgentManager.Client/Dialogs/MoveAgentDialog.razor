@inject ManagerApi Api
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <div class="help-heading">
            <MudText Typo="Typo.subtitle1">Destination runner</MudText>
            <HelpTip Label="Moving a project">
                <p>All project agents stop, then Main, every workspace folder, native histories and referenced attachments transfer together. Conversations, sharing and shared files keep their identities.</p>
                <p>The working path stays the same. Existing destination folders are never overwritten. Choose a ready runner with the same SSH username, the required harness and permission to use it.</p>
                <p>Only agents that were running resume after file verification. A failed transfer falls back to the source. If the Manager cannot establish whether a process stopped or started, it retains the source and offers recovery instead of starting a second copy.</p>
                <p>Workspaces move with Main, including stopped ones. Kept workspace folders, linked Git worktrees made outside the Manager and folders shared with another project block a move. Source files are removed after all required destination agents start successfully.</p>
            </HelpTip>
        </div>
        <LoadingSection Loaded="_runnersLoaded" Error="@_runnersError" Retry="LoadRunnersAsync" Label="Loading destination runners">
            <Placeholder><SkeletonForm Fields="1" /></Placeholder>
            <ChildContent>
                @if (_runners.Count == 0)
                {
                    <MudText Typo="Typo.body2">No eligible runner. Give this agent's owner access to a ready runner with @Agent.HarnessId installed.</MudText>
                }
                else
                {
                    <MudSelect T="Guid?" @bind-Value="_target" Label="Runner" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                        @foreach (var runner in _runners)
                        {
                            <MudSelectItem T="Guid?" Value="runner.Id">@runner.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudText Typo="Typo.caption" Class="mt-2">@(_project.FirstOrDefault(a => !a.IsClone)?.WorkingDirectory ?? Agent.WorkingDirectory)</MudText>
                }
                @if (_project.Count(a => a.IsClone) is > 0 and var clones)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">Main and its @clones @(clones == 1 ? "workspace move" : "workspaces move") together.</MudText>
                }
            </ChildContent>
        </LoadingSection>
        <div class="help-heading mt-4">
            <MudText Typo="Typo.subtitle1">Processes</MudText>
            <HelpTip Label="Stopping processes for a move">
                <p>These processes were started by agents in this project and are still running outside its current terminal. They may use the working folder, so they must stop before files can move.</p>
                <p>Stop processes and move asks the listed processes to exit, waits ten seconds, then force-stops any that remain. In-memory work can be lost. Their files stay, but these background commands are not restarted on either runner if the move succeeds or falls back.</p>
                <p>The Manager rechecks the process identities and ownership before stopping them. New processes require another review. The project's live terminals and other projects' processes are excluded.</p>
            </HelpTip>
            <MudIconButton Icon="@Icons.Material.Rounded.Refresh" Size="Size.Small" Disabled="_busy || _checking" OnClick="RefreshProcessesAsync" aria-label="Refresh background processes" />
        </div>
        <LoadingSection Loaded="_processesLoaded" Error="@_processesError" Retry="RefreshProcessesAsync" Label="Checking background processes">
            <Placeholder><SkeletonList Rows="2" /></Placeholder>
            <ChildContent>
                @if (_processesError is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_processesError</MudAlert>
                }
                @if (_processes.Count == 0 && _processesError is null)
                {
                    <MudText Typo="Typo.body2">No blocking processes.</MudText>
                }
                else if (_processes.Count > 0)
                {
                    <MudText Typo="Typo.body2">Stop these processes to move.</MudText>
                    <div class="move-process-list">
                        @foreach (var process in _processes)
                        {
                            <div class="move-process">
                                <MudText Typo="Typo.body2"><strong>@process.Name</strong> · PID @process.Identity.Pid</MudText>
                                @if (process.WorkingDirectory is not null)
                                {
                                    <MudText Typo="Typo.caption" Class="mono mud-text-secondary">@process.WorkingDirectory</MudText>
                                }
                            </div>
                        }
                    </div>
                }
            </ChildContent>
        </LoadingSection>
    </DialogContent>
    <DialogActions>
        <MudButton Disabled="_busy" OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="@(_processes.Count > 0 ? Color.Error : Color.Primary)" Disabled="@(_busy || _checking || !_processesLoaded || _processesError is not null || _target is null)" OnClick="MoveAsync">@(_busy ? "Starting move…" : _processes.Count > 0 ? "Stop processes and move" : "Move")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
    private List<RunnerDto> _runners = [];
    /// <summary>Main and its workspaces, which all move.</summary>
    private List<AgentDto> _project = [];
    private Guid? _target;
    private bool _busy;
    private bool _runnersLoaded, _processesLoaded, _checking;
    private string? _runnersError, _processesError;
    private List<AgentMoveProcessDto> _processes = [];

    protected override Task OnInitializedAsync() => Task.WhenAll(LoadRunnersAsync(), RefreshProcessesAsync());

    private async Task LoadRunnersAsync()
    {
        try
        {
            _runnersError = null;
            var runners = await Api.ListRunnersAsync();
            var workspaces = (await Api.ListAgentsAsync()).Where(a => WorkspaceGroups.ProjectKey(a) == WorkspaceGroups.ProjectKey(Agent)).ToList();
            var current = runners.FirstOrDefault(r => r.Id == Agent.RunnerId);
            _project = workspaces;
            _runners = runners.Where(r => r.Id != Agent.RunnerId && r.State == RunnerState.Ready && r.Operation is null
                && r.Access >= RunnerAccess.Use && r.Username == current?.Username && workspaces.All(a => r.HarnessIds.Contains(a.HarnessId)))
                .OrderBy(r => r.Name).ToList();
            _runnersLoaded = true;
        }
        catch (ApiException e) { _runnersError = e.Message; }
        catch (HttpRequestException) { _runnersError = LoadingSection.Unreachable; }
        finally { await InvokeAsync(StateHasChanged); }
    }

    private async Task RefreshProcessesAsync()
    {
        _checking = true;
        try
        {
            _processesError = null;
            _processes = await Api.ListMoveProcessesAsync(Agent.Id);
            _processesLoaded = true;
        }
        catch (ApiException e) { _processesError = e.Message; }
        catch (HttpRequestException) { _processesError = LoadingSection.Unreachable; }
        finally { _checking = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task MoveAsync()
    {
        _busy = true;
        try
        {
            var reviewed = _processes.Select(p => p.Identity).ToHashSet();
            await RefreshProcessesAsync();
            if (_processesError is not null) return;
            if (_processes.Any(p => !reviewed.Contains(p.Identity)))
            {
                Snackbar.Add("Background processes changed. Review the updated list before moving.", Severity.Info);
                return;
            }
            await Api.MoveAgentAsync(Agent.Id, _target!.Value, _processes.Select(p => p.Identity).ToList());
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException e) { Snackbar.Add(e.Message, Severity.Error); await RefreshProcessesAsync(); }
        catch (HttpRequestException) { Snackbar.Add(LoadingSection.Unreachable, Severity.Error); }
        finally { _busy = false; }
    }
    /// <summary>
    /// For an agent's own menu. A workspace's moves its whole project; Main's is just "Move", like an agent without
    /// workspaces: the dialog says when workspaces move with it. A project's heading has "Move project" instead.
    /// </summary>
    public static string MenuLabel(AgentDto agent) => agent.IsClone ? "Move project to another runner…" : "Move to another runner…";

    public static async Task ShowAsync(IDialogService dialogs, AgentDto agent) =>
        await (await dialogs.ShowAsync<MoveAgentDialog>($"Move {WorkspaceGroups.ProjectName(agent)} to another runner", new DialogParameters<MoveAgentDialog> { { d => d.Agent, agent } },
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small })).Result;
}
