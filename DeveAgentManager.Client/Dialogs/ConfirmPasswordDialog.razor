@inject ManagerApi Api

@* Asked before an admin action when the password was last entered a while ago (see ManagerApi.ConfirmPassword).
   Closes with true once the Manager accepted it; the action then runs. *@
<MudDialog>
    <TitleContent>
        <div class="dialog-title">
            <MudIcon Icon="@Icons.Material.Rounded.Lock" Color="Color.Primary" />
            <span>Enter your password</span>
            <HelpTip Label="Enter your password">
                <p>Admin actions, like managing users, changing Manager settings or viewing a Runner's password, ask for your
                password again when you last entered it more than 10 minutes ago.</p>
                <p>So someone who finds your signed-in browser can't make those changes without it.</p>
            </HelpTip>
        </div>
    </TitleContent>
    <DialogContent>
        <form id="confirm-password" @onsubmit="ConfirmAsync">
            <MudTextField @bind-Value="_password" Label="Password" InputType="InputType.Password" Variant="Variant.Outlined"
                          Margin="Margin.Dense" AutoFocus="true" Immediate="true" UserAttributes="@(new() { ["autocomplete"] = "current-password" })" />
            @if (WithCode)
            {
                <MudTextField @bind-Value="_code" Label="Code from your authenticator app, or a recovery code" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Class="mt-3" Immediate="true" UserAttributes="@(new() { ["autocomplete"] = "one-time-code" })" />
            }
            @if (_error is not null)
            {
                <MudText Color="Color.Error" Typo="Typo.body2" Class="mt-3">@_error</MudText>
            }
        </form>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="confirm-password" Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@(_busy || string.IsNullOrEmpty(_password) || WithCode && string.IsNullOrWhiteSpace(_code))">Continue</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public bool WithCode { get; set; }
    private string _password = "", _code = "";
    private string? _error;
    private bool _busy;

    private async Task ConfirmAsync()
    {
        if (_busy || string.IsNullOrEmpty(_password)) return;
        _busy = true;
        _error = null;
        try
        {
            await Api.ConfirmPasswordAsync(_password, WithCode ? _code.Trim() : null);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
