@using System.Security.Cryptography

@* Asks for a new password (or makes one up), shown so it can be copied. Returns the password as the dialog's data. *@
<MudDialog>
    <DialogContent>
        @if (Intro is not null)
        {
            <MudText Typo="Typo.body2" Class="mb-3">@Intro</MudText>
        }
        <div class="form-row form-row-center">
            <MudTextField @bind-Value="_password" Label="New password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1 mono-input" Immediate="true"
                          InputType="@(_show ? InputType.Text : InputType.Password)" AutoFocus="true" autocomplete="new-password"
                          Error="@(_password.Length > 0 && _password.Length < MinLength)" ErrorText="@($"At least {MinLength} characters.")" />
            <MudIconButton Icon="@(_show ? Icons.Material.Rounded.VisibilityOff : Icons.Material.Rounded.Visibility)" Size="Size.Small" OnClick="() => _show = !_show"
                           aria-label="@(_show ? "Hide password" : "Show password")" />
        </div>
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Casino" OnClick="Generate">Make one up</MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_password.Length < MinLength" OnClick="() => MudDialog.Close(DialogResult.Ok(_password))">@Confirm</MudButton>
    </DialogActions>
</MudDialog>

@code {
    // No characters that look alike, so it can be read from the screen and typed.
    private const string Alphabet = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789";

    private string _password = "";
    private bool _show;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? Intro { get; set; }

    [Parameter]
    public string Confirm { get; set; } = "Set password";

    [Parameter]
    public int MinLength { get; set; } = 8;

    private void Generate()
    {
        _password = RandomNumberGenerator.GetString(Alphabet, 20);
        _show = true;
    }
}
