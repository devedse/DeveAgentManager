@inject ManagerApi Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<MudDialog>
    <TitleContent>
        <div class="dialog-title">
            <MudIcon Icon="@Icons.Material.Rounded.AddToQueue" Color="Color.Primary" />
            <span>New Runner</span>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_providers.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                No provider is configured. Set the PROXMOX_* variables in the compose file, or add an existing machine.
            </MudAlert>
        }
        else
        {
            <MudForm @ref="_form" Class="dialog-form">
                <MudText Typo="Typo.overline" Class="mud-text-secondary">Where</MudText>
                <div class="choice-grid">
                    @foreach (var provider in _providers)
                    {
                        <button type="button" class="choice-card @(provider == _provider ? "selected" : "")" @onclick="() => SelectProvider(provider)">
                            <MudIcon Icon="@(provider.Capabilities.RequiresConnectionDetails ? Icons.Material.Rounded.Lan : Icons.Material.Rounded.Cloud)" />
                            <div>
                                <div class="choice-title">@provider.DisplayName</div>
                                <div class="choice-text">@(provider.Capabilities.RequiresConnectionDetails ? "A Linux machine you already have" : "Clone a new VM from a template")</div>
                            </div>
                        </button>
                    }
                </div>

                @if (_provider is not null && _provider.Capabilities.SupportsTemplates && _templates.Count > 0)
                {
                    <MudText Typo="Typo.overline" Class="mud-text-secondary mt-4">Template</MudText>
                    <div class="choice-grid">
                        @foreach (var template in _templates)
                        {
                            <button type="button" class="choice-card @(template.Id == _templateId ? "selected" : "")" @onclick="() => _templateId = template.Id">
                                <MudIcon Icon="@(template.Kind == RunnerKind.Desktop ? Icons.Material.Rounded.DesktopWindows : Icons.Material.Rounded.Terminal)" />
                                <div>
                                    <div class="choice-title">@template.DisplayName</div>
                                    <div class="choice-text">@template.Description</div>
                                </div>
                            </button>
                        }
                    </div>
                }

                <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4"
                              HelperText="Lowercase letters, digits and dashes. Also used as the hostname." Required="true" RequiredError="Enter a name" />

                @if (_provider?.Capabilities.RequiresConnectionDetails == true)
                {
                    <div class="form-row mt-2">
                        <MudTextField @bind-Value="_host" Label="Host or IP" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Enter the host" Class="flex-grow-1" />
                        <MudNumericField @bind-Value="_port" Label="SSH port" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="65535" Class="port-field" />
                    </div>
                    <div class="form-row mt-2">
                        <MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined" Margin="Margin.Dense" Required="true" RequiredError="Enter the username" Class="flex-grow-1" />
                        <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Class="flex-grow-1"
                                      HelperText="Used once to install the Manager's SSH key; needs passwordless sudo." />
                    </div>
                }

                @if (_provider?.Capabilities.SupportsSizing == true)
                {
                    <MudText Typo="Typo.overline" Class="mud-text-secondary mt-4 d-block">Size</MudText>
                    <div class="form-row">
                        <MudNumericField @bind-Value="_cores" Label="CPU cores" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="64" />
                        <MudNumericField @bind-Value="_memoryGb" Label="Memory (GB)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="512" />
                        <MudNumericField @bind-Value="_diskGb" Label="Disk (GB)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="8" Max="4096" />
                    </div>
                }

                <MudText Typo="Typo.overline" Class="mud-text-secondary mt-4 d-block">Harnesses</MudText>
                <div class="harness-list">
                    @foreach (var harness in _harnessList)
                    {
                        <MudCheckBox T="bool" Value="_harnesses.Contains(harness.Id)" ValueChanged="on => ToggleHarness(harness.Id, on)" Color="Color.Primary" Dense="true">
                            <span class="harness-name harness-option"><HarnessLogo HarnessId="@harness.Id" />@harness.DisplayName</span>
                            <span class="mud-text-secondary harness-description">@harness.Description</span>
                        </MudCheckBox>
                    }
                </div>
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || _provider is null" OnClick="CreateAsync" StartIcon="@Icons.Material.Rounded.RocketLaunch">
            @(_busy ? "Creating..." : "Create Runner")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm? _form;
    private List<ProviderDto> _providers = [];
    private ProviderDto? _provider;
    private List<HarnessDto> _harnessList = [];
    private List<RunnerTemplate> _templates = [];
    private string? _templateId;
    private string _name = "";
    private string _host = "";
    private int _port = 22;
    private string _username = "";
    private string? _password;
    private int _cores;
    private int _memoryGb;
    private int _diskGb;
    private readonly HashSet<string> _harnesses = [];
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var info = await Api.InfoAsync();
        _providers = info.Providers.Where(p => p.IsConfigured).OrderBy(p => p.Capabilities.RequiresConnectionDetails).ToList();
        _harnessList = info.Harnesses.ToList();
        _cores = info.DefaultCores;
        _memoryGb = Math.Max(1, info.DefaultMemoryMb / 1024);
        _diskGb = info.DefaultDiskGb;
        _username = info.RunnerUsername;
        foreach (var harness in _harnessList)
        {
            _harnesses.Add(harness.Id);
        }

        if (_providers.Count > 0)
        {
            SelectProvider(_providers[0]);
        }

        var existing = (await Api.ListRunnersAsync()).Select(r => r.Name).ToHashSet();
        _name = Enumerable.Range(1, 999).Select(i => $"runner-{i:00}").First(n => !existing.Contains(n));
    }

    private void SelectProvider(ProviderDto provider)
    {
        _provider = provider;
        _templates = provider.Templates.ToList();
        _templateId = _templates.FirstOrDefault()?.Id;
    }

    private void ToggleHarness(string id, bool on)
    {
        if (on)
        {
            _harnesses.Add(id);
        }
        else
        {
            _harnesses.Remove(id);
        }
    }

    private async Task CreateAsync()
    {
        if (_provider is null || _form is null)
        {
            return;
        }

        await _form.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        _busy = true;
        try
        {
            var connection = _provider.Capabilities.RequiresConnectionDetails
                ? new ConnectionDetails(_host, _port, _username, string.IsNullOrEmpty(_password) ? null : _password)
                : null;
            var runner = await Api.CreateRunnerAsync(new CreateRunnerRequest(_name, _provider.Id, _templateId, _cores, _memoryGb * 1024, _diskGb, _harnesses.ToList(), connection));
            Snackbar.Add($"Creating Runner '{runner.Name}'. Follow along in the setup log.", Severity.Info);
            MudDialog.Close(DialogResult.Ok(runner.Id));
            Navigation.NavigateTo($"runners/{runner.Id}");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
