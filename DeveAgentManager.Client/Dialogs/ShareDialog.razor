@inherits LiveComponent
@inject IDialogService Dialogs

@* Who an agent or a conversation is shared with. Its owner adds people, changes how and ends shares; others can leave. *@
<MudDialog>
    <DialogContent>
        <AccessList People="People" UserId="Me.Id" Loaded="Loaded" Error="@LoadError" Retry="RetryAsync" CanAdd="IsOwner" Busy="_busy" Add="AddAsync">
            <Help>
                @if (Agent is not null)
                {
                    <p>Access applies to this project and all of its workspaces, including workspaces created later. Leaving or removing access applies to the whole project.</p>
                    <p>Read-only permits watching the terminal and reading conversations. Read-write also permits typing in the terminal and prompting the agent with its current login. It needs no access to the agent's Runner, and doesn't give its shell, VS Code or desktop.</p>
                    <p>The agent runs commands on its Runner with its git identity and GitHub token, the owner's unless someone switched it (Git identity in the agent's menu). A read-write user's prompts commit and push as that person. Share read-write only with people you would let run commands as you on that Runner.</p>
                }
                else
                {
                    <p>Read-only permits reading the conversation and its images, exporting it, and continuing a copy in another agent.</p>
                }
                <p>The owner manages access. Removing access ends that person's share; other permissions remain unchanged.</p>
            </Help>
            <Actions Context="person">
                @if (!person.Owner && (IsOwner || person.Id == Me.Id))
                {
                    var share = _shares.Single(s => s.UserId == person.Id);
                    <AccessMenu Disabled="_busy" Label="@($"Access for {person.Username}")">
                        @if (IsOwner && Agent is not null)
                        {
                            <MudMenuItem Icon="@Icons.Material.Rounded.Tune" OnClick="() => ShareAsync(share.UserId, share.Access == AgentAccess.Write ? AgentAccess.Read : AgentAccess.Write)">Change to @(share.Access == AgentAccess.Write ? "Read-only" : "Read-write")</MudMenuItem>
                        }
                        <MudMenuItem Icon="@Icons.Material.Rounded.PersonRemove" IconColor="Color.Error" OnClick="() => RemoveAsync(share)">@(share.UserId == Me.Id ? "Leave access…" : "Remove access…")</MudMenuItem>
                    </AccessMenu>
                }
            </Actions>
        </AccessList>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => MudDialog.Close()">Done</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<ShareRow> _shares = [];
    private bool _busy;
    private IReadOnlyList<AccessPerson> People => new[] { new AccessPerson(OwnerId, "", OwnerName, "Owner", Owner: true) }
        .Concat(_shares.Select(s => new AccessPerson(s.UserId, s.Username, s.DisplayName,
            s.Access == AgentAccess.Write ? "Read-write" : "Read-only", GrantedAt: s.GrantedAt))).ToList();

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The agent to share; or <see cref="Session"/>.</summary>
    [Parameter]
    public AgentDto? Agent { get; set; }

    [Parameter]
    public SessionDto? Session { get; set; }

    [Parameter, EditorRequired]
    public CurrentUserDto Me { get; set; } = default!;

    /// <summary>Shows who the agent is shared with; true when the user left the share (so it is gone for them).</summary>
    public static Task<bool> ShowAsync(IDialogService dialogs, AgentDto agent, CurrentUserDto me) =>
        // Access covers the whole project, whichever workspace it was opened from.
        ShowAsync(dialogs, agent.Access == AgentAccess.Owner ? $"Access to {WorkspaceGroups.ProjectName(agent)}" : $"{agent.OwnerName}'s {WorkspaceGroups.ProjectName(agent)}",
            new DialogParameters<ShareDialog> { { d => d.Agent, agent }, { d => d.Me, me } });

    /// <summary>Shows who the conversation is shared with; true when the user left the share.</summary>
    public static Task<bool> ShowAsync(IDialogService dialogs, SessionDto session, CurrentUserDto me) =>
        ShowAsync(dialogs, session.Access == SessionAccess.Owner ? $"Access to {session.Title}" : $"{session.OwnerName}'s {session.Title}",
            new DialogParameters<ShareDialog> { { d => d.Session, session }, { d => d.Me, me } });

    private static async Task<bool> ShowAsync(IDialogService dialogs, string title, DialogParameters<ShareDialog> parameters)
    {
        var dialog = await dialogs.ShowAsync<ShareDialog>(title, parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        return await dialog.Result is { Canceled: false, Data: true };
    }

    private bool IsOwner => Agent?.Access == AgentAccess.Owner || Session?.Access == SessionAccess.Owner;

    private Guid OwnerId => Agent?.OwnerId ?? Session!.OwnerId;

    private string OwnerName => Agent?.OwnerName ?? Session!.OwnerName;

    protected override async Task LoadAsync()
    {
        _shares = Agent is not null
            ? (await Api.ListAgentSharesAsync(Agent.Id)).Select(s => new ShareRow(s.UserId, s.Username, s.DisplayName, s.Access, s.GrantedAt)).ToList()
            : (await Api.ListSessionSharesAsync(Session!.Id)).Select(s => new ShareRow(s.UserId, s.Username, s.DisplayName, AgentAccess.Read, s.GrantedAt)).ToList();
    }

    private async Task AddAsync()
    {
        var parameters = new DialogParameters<ChooseUserDialog>
        {
            { d => d.Exclude, _shares.Select(s => s.UserId).Append(OwnerId).ToList() },
            { d => d.Confirm, "Add" },
        };
        if (Agent is not null)
        {
            parameters.Add(d => d.Levels, new List<(int, string, string)>
            {
                ((int)AgentAccess.Read, "Read-only", "Watch the terminal and read the conversations."),
                ((int)AgentAccess.Write, "Read-write", "Also prompt it. It commits and pushes as you unless they switch it to themselves."),
            });
            parameters.Add(d => d.Level, (int)AgentAccess.Read);
        }

        var dialog = await Dialogs.ShowAsync<ChooseUserDialog>($"Share {(Agent is not null ? Agent.Name : Session!.Title)}", parameters);
        if (await dialog.Result is { Canceled: false, Data: ChooseUserDialog.ChosenUser chosen })
        {
            await ShareAsync(chosen.UserId, Agent is not null ? (AgentAccess)chosen.Level : AgentAccess.Read);
        }
    }

    private Task ShareAsync(Guid userId, AgentAccess access) =>
        RunAsync(() => Agent is not null ? Api.ShareAgentAsync(Agent.Id, userId, access) : Api.ShareSessionAsync(Session!.Id, userId));

    private async Task RemoveAsync(ShareRow share)
    {
        var leaving = share.UserId == Me.Id;
        if (await Dialogs.ShowMessageBoxAsync(leaving ? "Leave access?" : $"Remove {share.DisplayName}'s access?",
            "This share ends. Other runner, login and agent permissions remain unchanged.", yesText: leaving ? "Leave" : "Remove", cancelText: "Cancel") != true) return;
        if (!leaving)
        {
            await RunAsync(() => Agent is not null ? Api.UnshareAgentAsync(Agent.Id, share.UserId) : Api.UnshareSessionAsync(Session!.Id, share.UserId));
            return;
        }
        try
        {
            await (Agent is not null ? Api.UnshareAgentAsync(Agent.Id, Me.Id) : Api.UnshareSessionAsync(Session!.Id, Me.Id));
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        catch (HttpRequestException) { Snackbar.Add(LoadingSection.Unreachable, Severity.Error); }
    }

    private async Task RunAsync(Func<Task> action)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await action();
            await ReloadAsync();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (HttpRequestException) { Snackbar.Add(LoadingSection.Unreachable, Severity.Error); }
        finally { _busy = false; }
    }

    private sealed record ShareRow(Guid UserId, string Username, string DisplayName, AgentAccess Access, DateTime GrantedAt);
}
