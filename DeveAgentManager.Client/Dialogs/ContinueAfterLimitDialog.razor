@using System.Globalization
@inject ManagerApi Api
@inject BrowserClock Clock

<MudDialog>
    <DialogContent>
        <LoadingSection Loaded="LimitLoaded" Error="@LimitLoadError" Retry="ReloadLimitAsync" Label="Loading usage-limit status">
            <Placeholder><SkeletonForm Fields="1" /></Placeholder>
            <ChildContent>
                @if (Limit.DetectionProblem is not null)
                {
                    <MudAlert Severity="Severity.Warning"><div class="help-heading"><span>Usage-limit detection unavailable.</span>
                        <HelpTip Label="Unavailable usage-limit detection"><p>@Limit.DetectionProblem</p><p>Saved limits and schedules are retained. Retry reloads detection status; background observation also retries.</p></HelpTip></div></MudAlert>
                    <MudButton OnClick="ReloadLimitAsync" Disabled="_busy" Class="mt-2 mb-3">Retry detection</MudButton>
                }
                @if (LimitLoadError is not null) { <MudAlert Severity="Severity.Warning">@LimitLoadError</MudAlert><MudButton OnClick="ReloadLimitAsync">Retry limit status</MudButton> }
                @if (!AutomaticLoaded) { <MudText Class="mt-3">@Limit.Message</MudText> }
            </ChildContent>
        </LoadingSection>
        <LoadingSection Loaded="AutomaticLoaded" Error="@AutomaticLoadError" Retry="ReloadAutomaticAsync" Label="Loading automatic continuation">
            <Placeholder><SkeletonForm Fields="1" /></Placeholder>
            <ChildContent>
                @if (AutomaticLoadError is not null) { <MudAlert Severity="Severity.Warning">@AutomaticLoadError</MudAlert><MudButton OnClick="ReloadAutomaticAsync">Retry automatic status</MudButton> }
                @if (!LimitLoaded && Automatic.Enabled) { <MudText>Automatic continuation is on.</MudText> }
            </ChildContent>
        </LoadingSection>
        @if (LimitLoaded && AutomaticLoaded)
        {
        <div class="help-heading mb-3">
        <MudSelect T="bool" @bind-Value="_autoMode" Label="Continuation mode" Variant="Variant.Outlined" Class="flex-grow-1">
            <MudSelectItem T="bool" Value="false">One-time schedule</MudSelectItem>
            <MudSelectItem T="bool" Value="true" Disabled="!Automatic.Available && !Automatic.Enabled">Automatic after usage limits@(Automatic.Available ? "" : " (Codex and Claude)")</MudSelectItem>
        </MudSelect>
        <HelpTip Label="Continuation modes"><p>A one-time schedule types and sends <b>continue</b> once: one minute after the chosen reset, or after the chosen duration. If the agent is busy or you have a draft, it stays armed until the prompt is empty and the agent is ready.</p><p>Automatic mode repeats after detected usage-limit resets until disabled or its count is reached; it needs the usage-limit messages of Codex or Claude. If a dated reset falls in a repeated clock hour, the Manager waits for the later occurrence to avoid continuing before the reset.</p></HelpTip>
        </div>
        @if (_autoMode)
        {
            <div class="help-heading"><MudSwitch T="bool" Value="_enabled" ValueChanged="ToggleAutomaticAsync" Disabled="_busy || AutomaticLoadError is not null" Color="Color.Success" Label="Auto-continue enabled" />
                <HelpTip Label="Automatic continuation">
                    <p>Send <b>continue</b> one minute after each detected usage-limit reset in this chat. Stays on until you switch it off, even with this page closed.</p>
                    <p>Drafts and busy agents wait. Unknown reset times need your attention; no time is guessed. Changing the conversation or uncertain delivery stops automatic mode. Claude's own automatic continuation takes priority.</p>
                </HelpTip></div>
            <MudSwitch T="bool" @bind-Value="_limited" Disabled="_busy" Color="Color.Primary" Label="Limit the number of continuations" />
            @if (_limited)
            {
                <MudNumericField T="int" @bind-Value="_remaining" Label="Continuations remaining" Min="1" Max="10000" Variant="Variant.Outlined" Disabled="_busy" />
            }
            else { <MudText Typo="Typo.body2">Unlimited continuations</MudText> }
            @* The limit on screen now, and its reset: what switching on (or what is on) will do with it. *@
            @if (!Limit.Manual)
            {
                <MudText Class="mt-3">@Limit.Message</MudText>
                <MudText Typo="Typo.body2">@_resetDescription</MudText>
            }
            @if (Automatic.Detail is not null) { <MudAlert Severity="@AutomaticSeverity" Class="mt-3">@Automatic.Detail</MudAlert> }
            @if (!Limit.Manual && Limit.Status == "Sent")
            {
                <MudAlert Severity="Severity.Warning" Class="mt-3"><div class="help-heading"><span>Continue was submitted; the usage limit has not cleared.</span>
                    <HelpTip Label="Unresolved usage limit"><p>The Manager sends at most once for a detected reset. Check the terminal before retrying. A passed reset time alone does not mean the agent resumed.</p></HelpTip></div></MudAlert>
            }
            @if (_enabled && Limit.Status == "Scheduled" && _continueDescription is not null) { <MudText Class="mt-2">Next continue: <b>@_continueDescription</b></MudText> }
            <MudText Class="mt-3" Typo="Typo.body2">Sends so far: @Automatic.Sent.</MudText>
        }
        else if (_enabled)
        {
            <MudAlert Severity="Severity.Info">Automatic continuation is on. Switch it off before creating a one-time schedule.</MudAlert>
            <MudButton OnClick="() => ToggleAutomaticAsync(false)" Disabled="_busy">Turn off automatic continuation</MudButton>
        }
        else
        {
        <MudText Class="mb-3">@Limit.Message</MudText>
        @if (Limit.NativeAutoContinue)
        {
            <MudAlert Severity="Severity.Info">Claude is already waiting to continue automatically. The Manager will not send a second continuation.</MudAlert>
        }
        else if (Limit.Status == "Scheduled")
        {
            <div class="help-heading"><MudText>Continue is scheduled for <b>@_continueDescription</b>.</MudText>
                <HelpTip Label="Scheduled continuation" Text="You can close this page and keep using the terminal. Cancel the schedule here if you no longer want it." /></div>
            @if (Limit.Detail is not null) { <MudAlert Severity="Severity.Info" Class="mt-2">@Limit.Detail</MudAlert> }
        }
        else if (Limit.Status is "Sending" or "Uncertain" || (Limit.Status == "Sent" && !Limit.Manual))
        {
            <MudAlert Severity="@(Limit.Status == "Uncertain" ? Severity.Warning : Severity.Info)">
                @(Limit.Status == "Sending" ? "Submitting the scheduled continuation…" : Limit.Detail ?? "Check the terminal for the result of the scheduled continuation.")
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-2">@_resetDescription</MudText>
            @if (Limit.Detail is not null) { <MudAlert Severity="Severity.Info" Class="mb-3">@Limit.Detail</MudAlert> }
            @if (Limit.DetectedResetAt is not null)
            {
                <MudButton Color="Color.Primary" Disabled="!_loaded || _busy" OnClick="UseDetectedAsync">Use detected reset time (+1 min)</MudButton>
            }
            <MudSwitch T="bool" @bind-Value="_relative" Color="Color.Primary" Label="Continue after a duration" />
            @if (_relative)
            {
                <div class="limit-schedule-fields">
                    <MudNumericField T="double" @bind-Value="_amount" Label="Continue in" Min="1" Max="@(_hours ? 768 : 46080)" Variant="Variant.Outlined" />
                    <MudSelect T="bool" @bind-Value="_hours" Label="Unit" Variant="Variant.Outlined">
                        <MudSelectItem T="bool" Value="false">Minutes</MudSelectItem>
                        <MudSelectItem T="bool" Value="true">Hours</MudSelectItem>
                    </MudSelect>
                </div>
            }
            else
            {
                <div class="limit-schedule-fields">
                    <MudDatePicker @bind-Date="_date" Label="Reset date" DateFormat="yyyy-MM-dd" Editable="true" PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined" />
                    <MudTimePicker @bind-Time="_time" Label="Reset time" Editable="true" AmPm="false" PickerVariant="PickerVariant.Dialog" Variant="Variant.Outlined" />
                </div>
                <MudText Typo="Typo.caption">Your local timezone: @_zone</MudText>
                @if (_date is { } date && _time is { } time)
                {
                    <MudText Typo="Typo.body2">Continue at @date.Date.Add(time).AddMinutes(1).ToString("yyyy-MM-dd HH:mm") (@_zone).</MudText>
                }
            }
        }
        }
        }
        @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Close</MudButton>
        @if (LimitLoaded && AutomaticLoaded && AutomaticLoadError is null && _autoMode)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAutomaticAsync">Save automatic settings</MudButton>
        }
        else if (LimitLoaded && AutomaticLoaded && AutomaticLoadError is null && !_enabled && !Limit.NativeAutoContinue && Limit.Status == "Scheduled")
        {
            <MudButton Color="Color.Warning" Disabled="_busy" OnClick="CancelAsync">Cancel scheduled continue</MudButton>
        }
        else if (LimitLoaded && AutomaticLoaded && AutomaticLoadError is null && !_enabled && !Limit.NativeAutoContinue && (Limit.Status is "Detected" or "Expired" or "Cancelled" || (Limit.Manual && Limit.Status == "Sent")))
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || !_loaded" OnClick="ScheduleAsync">Schedule continue</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid AgentId { get; set; }
    [Parameter, EditorRequired] public AgentLimitDto Limit { get; set; } = default!;
    [Parameter] public AutoContinueDto Automatic { get; set; } = new();
    [Parameter] public bool LimitLoaded { get; set; } = true;
    [Parameter] public bool AutomaticLoaded { get; set; } = true;
    [Parameter] public string? LimitLoadError { get; set; }
    [Parameter] public string? AutomaticLoadError { get; set; }
    private bool _autoMode, _enabled, _limited;
    private Severity AutomaticSeverity => Limit.DetectionProblem is not null || Limit.Status == "Uncertain" || !Limit.Manual &&
        (Limit.Status is "Detected" or "Expired" or "Sent" || Limit.Status == "Scheduled" && Limit.Detail?.StartsWith("Waiting", StringComparison.Ordinal) == true)
        ? Severity.Warning : Severity.Info;
    private int _remaining = 1;
    private DateTime? _date;
    private TimeSpan? _time;
    private DateTime? _exactReset, _exactDate;
    private TimeSpan? _exactTime;
    private string _zone = "Loading…";
    private string _resetDescription = "";
    private string? _continueDescription;
    private string? _error;
    private bool _busy, _loaded, _relative, _hours;
    private double _amount = 5;

    protected override async Task OnInitializedAsync()
    {
        _autoMode = Automatic.Available || Automatic.Enabled;
        _enabled = Automatic.Enabled;
        _limited = Automatic.Remaining is not null;
        _remaining = Math.Max(1, Automatic.Remaining ?? 1);
        _relative = Limit.Manual;
        if (Limit.Manual) _amount = 1;
        try
        {
            var local = await Clock.LocalPartsAsync(Limit.ResetAt ?? Limit.DetectedResetAt ?? DateTime.UtcNow);
            _zone = local.Zone;
            if ((Limit.ResetAt ?? Limit.DetectedResetAt) is not null)
            {
                _date = DateTime.ParseExact(local.Date, "yyyy-MM-dd", CultureInfo.InvariantCulture);
                _time = TimeSpan.Parse(local.Time, CultureInfo.InvariantCulture);
                _exactReset = Limit.ResetAt ?? Limit.DetectedResetAt;
                _exactDate = _date; _exactTime = _time;
            }
            await DescribeAsync();
            _loaded = true;
        }
        catch (JSException) { _error = "Could not read your local timezone. Reopen this dialog to try again."; }
    }

    private async Task ReloadLimitAsync()
    {
        try
        {
            Limit = await Api.GetAgentLimitAsync(AgentId) ?? new("Manual continuation — no usage limit is required.", null, DateTime.UtcNow, null, null, "Detected", null, false, true);
            LimitLoaded = true;
            LimitLoadError = null;
            await DescribeAsync();
        }
        catch (ApiException ex) { LimitLoadError = ex.Message; }
        catch (HttpRequestException) { LimitLoadError = LoadingSection.Unreachable; }
    }
    private async Task ReloadAutomaticAsync()
    {
        try
        {
            Automatic = await Api.GetAutoContinueAsync(AgentId);
            AutomaticLoaded = true;
            AutomaticLoadError = null;
            _autoMode = Automatic.Available || Automatic.Enabled;
            _enabled = Automatic.Enabled;
            _limited = Automatic.Remaining is not null;
            _remaining = Math.Max(1, Automatic.Remaining ?? 1);
        }
        catch (ApiException ex) { AutomaticLoadError = ex.Message; }
        catch (HttpRequestException) { AutomaticLoadError = LoadingSection.Unreachable; }
    }

    /// <summary>The detected reset and the next continue in local time; again whenever the limit was reloaded.</summary>
    private async Task DescribeAsync()
    {
        if (Limit.DetectedResetAt is { } detected)
        {
            var original = await Clock.LocalPartsAsync(detected);
            _resetDescription = $"Detected reset: {original.Date} {original.Time} ({original.Zone}{(original.Offset is { } offset ? $", UTC{offset}" : "")}). Message timezone: {Limit.TimeZoneId ?? "unknown"}.";
        }
        else
        {
            _resetDescription = Limit.Manual ? "Test a one-time continuation without waiting for a usage limit."
                : Limit.ResetAt is not null ? "Using your previously selected reset. The message's reset time could not be detected."
                : Limit.Detail is not null ? "The reset time needs confirmation."
                : "No reset time was found in the message: it needs to be chosen by hand.";
        }

        _continueDescription = null;
        if (Limit.ContinueAt is { } scheduled)
        {
            var next = await Clock.LocalPartsAsync(scheduled);
            _continueDescription = $"{next.Date} {next.Time} ({next.Zone})";
        }
    }

    private async Task ToggleAutomaticAsync(bool enabled)
    {
        _busy = true;
        try
        {
            await Api.SetAutoContinueAsync(AgentId, enabled, _limited ? _remaining : null);
            Automatic = await Api.GetAutoContinueAsync(AgentId);
            _enabled = Automatic.Enabled;
            Limit = await Api.GetAgentLimitAsync(AgentId) ?? new("Manual continuation — no usage limit is required.", null, DateTime.UtcNow, null, null, "Detected", null, false, true);
            _relative = Limit.Manual;
            // Switching on schedules a limit that is on screen right away: show when the continue goes.
            await DescribeAsync();
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
    private Task SaveAutomaticAsync() => RunAsync(() => Api.SetAutoContinueAsync(AgentId, _enabled, _limited ? _remaining : null));

    private async Task UseDetectedAsync()
    {
        if (Limit.DetectedResetAt is not { } detected) return;
        try
        {
            var local = await Clock.LocalPartsAsync(detected);
            _date = DateTime.ParseExact(local.Date, "yyyy-MM-dd", CultureInfo.InvariantCulture);
            _time = TimeSpan.Parse(local.Time, CultureInfo.InvariantCulture);
            _exactReset = detected; _exactDate = _date; _exactTime = _time;
            _relative = false;
            _error = null;
        }
        catch (JSException) { _error = "Could not read your local timezone. Try again."; }
    }

    private async Task ScheduleAsync()
    {
        DateTime reset;
        if (_relative)
        {
            if (!double.IsFinite(_amount) || _amount < 1 || (_hours ? _amount * 60 : _amount) > 46080)
            { _error = "Enter a duration from one minute up to 32 days."; return; }
            await RunAsync(() => Api.ScheduleContinueAsync(AgentId, null, Limit.Manual ? null : Limit.DetectedAt, _hours ? _amount * 60 : _amount, Limit.Manual));
            return;
        }
        else if (_exactReset is { } exact && _date == _exactDate && _time == _exactTime)
        {
            // Preserve the detected UTC offset, especially when the displayed local clock occurs twice.
            reset = exact;
        }
        else
        {
            if (_date is null || _time is null) { _error = "Choose the local reset date and time."; return; }
            var result = await Clock.ToUtcAsync(_date.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture), _time.Value.ToString(@"hh\:mm", CultureInfo.InvariantCulture));
            if (result.Error is { } error) { _error = error; return; }
            if (!DateTime.TryParse(result.Utc, CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal | DateTimeStyles.AssumeUniversal, out reset))
            { _error = "The local reset time could not be converted."; return; }
        }
        await RunAsync(() => Api.ScheduleContinueAsync(AgentId, reset, Limit.DetectedAt));
    }
    private Task CancelAsync() => RunAsync(() => Api.CancelContinueAsync(AgentId));
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try { await action(); MudDialog.Close(DialogResult.Ok(true)); }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
