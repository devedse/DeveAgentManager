<MudDialog>
    <TitleContent><div class="dialog-title"><HarnessLogo HarnessId="pi" /><span>pi login preview</span></div></TitleContent>
    <DialogContent>
        <PiLoginSelector Accounts="Accounts" RunnerHarnessIds="Agent.RunnerHarnessIds" @bind-AccountId="_accountId" />
        <MudLink Href="settings?tab=models" Class="d-inline-block mt-3">Set model cycling in My settings → Models</MudLink>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Select" Disabled="@(!CanSelect)">Use selection</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
    [Parameter] public IReadOnlyList<AccountDto> Accounts { get; set; } = [];
    private Guid? _accountId;
    private bool CanSelect => _accountId is null || Accounts.Any(a => a.Id == _accountId && a.Enabled && a.Access >= AccountAccess.Use
        && PiManagedLogin.Supports(a.HarnessId, a.Kind) && (a.HarnessId != "claude" || Agent.RunnerHarnessIds.Contains("claude")));
    protected override void OnInitialized() => _accountId = Agent.HarnessId == "pi" ? Agent.AccountId : null;
    private void Select() => MudDialog.Close(DialogResult.Ok(new SwitchAgentRequest("pi", _accountId)));
}
