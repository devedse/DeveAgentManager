@inject ManagerApi Api
@inject IJSRuntime Js
@inject ISnackbar Snackbar
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@Agent.Name · @StateStyles.For(Agent).Text</MudText>
        <MudText Class="mt-3">@(Agent.Activity?.Reason ?? Agent.StateMessage ?? "No activity observation is available.")</MudText>
        <MudText Typo="Typo.body2" Class="mt-3">Process: @Agent.State · Runner: @Agent.RunnerState</MudText>
        @if (Agent.Activity is { } activity)
        {
            <MudText Typo="Typo.body2">Last observed: @(activity.ObservedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "Not yet")</MudText>
            @if (Agent.State == AgentState.Running && activity.BackgroundTaskCount is > 0)
            {
                <MudText Class="mt-3">@activity.BackgroundTaskCount background task(s) reported by the harness. The prompt can be ready while commands continue. This may include persistent servers or watchers; it does not establish progress or success.</MudText>
            }
            @if (activity.QuestionWaiting)
            {
                <MudAlert Severity="Severity.Info" Class="mt-3">A question is queued while the agent works. Open the terminal and use Shift+Left to answer.</MudAlert>
            }
            @if (StateStyles.ShowsFinished(Agent))
            {
                <MudText Class="mt-3">Finished since you last viewed this agent. Opening its terminal marks this completion seen across your devices.</MudText>
            }
            <MudExpansionPanels Class="mt-3">
                <MudExpansionPanel Text="Detection details">
                    <div class="help-heading"><MudText Typo="Typo.body2">Rule: @activity.Rule</MudText><HelpTip Label="Detection details" Text="Activity is inferred from the current terminal screen. Unrecognized or stale screens are shown as unclear; they do not establish completion. Background counts come from recognized live footer indicators, not conversation history. When that indicator is absent, no count is shown; this does not prove that all background work has stopped." /></div>
                    @if (activity.Evidence is { } evidence)
                    {
                        <pre class="status-evidence">@evidence</pre>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
        <MudExpansionPanels Class="mt-3">
            <MudExpansionPanel Text="Recent diagnostic history">
                <div class="d-flex justify-end"><HelpTip Label="Recent diagnostic history" Text="Last 100 changes, up to seven days. Full terminal screens and typed prompts are not recorded." /></div>
                @foreach (var entry in _history.AsEnumerable().Reverse())
                {
                    <div class="diagnostic-entry"><small>@entry.At.ToLocalTime().ToString("MMM d HH:mm:ss") · @entry.Category @entry.Rule</small><div>@entry.Message</div></div>
                }
                <LoadingSection Loaded="_historyLoaded" Label="Loading diagnostic history">
                <Placeholder><SkeletonList Rows="2" Avatar="false" /></Placeholder>
                <ChildContent>
                @if (_history.Count == 0) { <MudText>No diagnostic history recorded yet.</MudText> }
                </ChildContent>
                </LoadingSection>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CopyAsync">Copy diagnostics</MudButton>
        <MudButton OnClick="() => Dialog.Close()">Close</MudButton>
        <MudButton Href="@($"agents/{Agent.Id}")" Color="Color.Primary" OnClick="() => Dialog.Close()">Open terminal</MudButton>
    </DialogActions>
</MudDialog>
@code {
    protected override async Task OnInitializedAsync()
    {
        try { Agent = await Api.GetAgentAsync(Agent.Id) ?? Agent; _history = await Api.GetDiagnosticsAsync(Agent.Id); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { }
        _historyLoaded = true;
    }
    private List<AgentDiagnosticDto> _history = [];
    private bool _historyLoaded;
    private async Task CopyAsync()
    {
        var report = System.Text.Json.JsonSerializer.Serialize(new {
            ManagerVersion = typeof(AgentStatusDialog).Assembly.GetName().Version?.ToString(),
            Agent = Agent.Name, Agent.HarnessId, Agent.RunnerName, Agent.State,
            Agent.Activity, History = _history
        }, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        try { await Js.InvokeVoidAsync("damUi.copy", report); Snackbar.Add("Diagnostics copied", Severity.Success); }
        catch (Exception) { Snackbar.Add("Clipboard unavailable. Select the diagnostic history to copy it.", Severity.Warning); }
    }
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
}
