@inject ManagerApi Api
<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@Agent.Name · @StateStyles.For(Agent).Text</MudText>
        <MudText Class="mt-3">@(Agent.Activity?.Reason ?? Agent.StateMessage ?? "No activity observation is available.")</MudText>
        <MudText Typo="Typo.body2" Class="mt-3">Process: @Agent.State · Runner: @Agent.RunnerState</MudText>
        @if (Agent.Activity is { } activity)
        {
            <MudText Typo="Typo.body2">Last observed: @(activity.ObservedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "Not yet")</MudText>
            @if (activity.QuestionWaiting)
            {
                <MudAlert Severity="Severity.Info" Class="mt-3">A question is queued while the agent works. Open the terminal and use Shift+Left to answer.</MudAlert>
            }
            @if (activity.UnseenCompletion)
            {
                <MudText Class="mt-3">Finished since you last viewed this agent. Opening its terminal marks this completion seen across your devices.</MudText>
            }
            <MudExpansionPanels Class="mt-3">
                <MudExpansionPanel Text="Detection details">
                    <MudText Typo="Typo.body2">Rule: @activity.Rule</MudText>
                    @if (activity.Evidence is { } evidence)
                    {
                        <pre class="status-evidence">@evidence</pre>
                    }
                    <MudText Typo="Typo.caption">Activity is inferred from the current terminal screen. Unrecognized or stale screens are shown as unclear; they do not establish completion.</MudText>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Close()">Close</MudButton>
        <MudButton Href="@($"agents/{Agent.Id}")" Color="Color.Primary" OnClick="() => Dialog.Close()">Open terminal</MudButton>
    </DialogActions>
</MudDialog>
@code {
    protected override async Task OnInitializedAsync()
    {
        try { Agent = await Api.GetAgentAsync(Agent.Id) ?? Agent; }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { }
    }
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
}
