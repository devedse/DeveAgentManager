@inject ManagerApi Api
@inject NavigationManager Navigation

<MudDialog>
    <TitleContent><div class="help-heading"><MudText Typo="Typo.h6">New workspace</MudText>
        <HelpTip Label="New workspace"><p>Creates a new Git worktree and branch from a committed revision. Uncommitted files stay in their original workspace. Each workspace has an independent agent and conversation.</p><p>Opening a workspace never starts its agent. Choose Start agent below to launch this one after creation.</p></HelpTip></div></TitleContent>
    <DialogContent>
        <LoadingSection Loaded="_loaded" Error="_loadError" Retry="LoadAsync" Label="Loading harnesses and logins">
            <Placeholder><SkeletonForm Fields="4" /></Placeholder>
            <ChildContent>
                <MudForm @ref="_form">
                    @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
                    <MudTextField @bind-Value="_name" Label="Workspace name" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                    <MudTextField @bind-Value="_branch" Label="New branch" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                    <MudTextField @bind-Value="_revision" Label="Starting revision" HelperText="HEAD uses the selected workspace's committed code." Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy" />
                    <MudSelect T="string" @bind-Value="_harness" Label="Harness" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy">
                        @foreach (var harness in _harnesses) { <MudSelectItem T="string" Value="harness.Id">@harness.DisplayName</MudSelectItem> }
                    </MudSelect>
                    <MudSelect T="Guid?" @bind-Value="_account" Label="Harness login" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_busy">
                        <MudSelectItem T="Guid?" Value="@((Guid?)null)">Owner's permitted default</MudSelectItem>
                        @foreach (var account in _accounts.Where(a => a.Enabled && a.Access >= AccountAccess.Use && a.HarnessId == _harness))
                        { <MudSelectItem T="Guid?" Value="account.Id">@account.Name</MudSelectItem> }
                    </MudSelect>
                    <MudSwitch T="bool" @bind-Value="_start" Label="Start agent after creation" Disabled="_busy" Color="Color.Primary" />
                </MudForm>
            </ChildContent>
        </LoadingSection>
    </DialogContent>
    <DialogActions><MudButton OnClick="() => Dialog.Cancel()" Disabled="_busy">Cancel</MudButton>
        <MudButton OnClick="CreateAsync" Disabled="@(_busy || !_loaded)" Color="Color.Primary" Variant="Variant.Filled">@(_busy ? "Creating…" : "Create workspace")</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter, EditorRequired] public AgentDto Source { get; set; } = default!;
    private MudForm? _form;
    private string _name = "", _branch = "", _revision = "HEAD", _harness = "";
    private Guid? _account;
    private bool _busy, _loaded, _start;
    private string? _error, _loadError;
    private IReadOnlyList<HarnessDto> _harnesses = [];
    private IReadOnlyList<AccountDto> _accounts = [];
    protected override Task OnInitializedAsync() { _harness = Source.HarnessId; return LoadAsync(); }
    private async Task LoadAsync()
    {
        _loadError = null;
        try { _harnesses = (await Api.InfoAsync()).Harnesses.Where(h => Source.RunnerHarnessIds.Contains(h.Id)).ToList(); _accounts = await Api.ListAccountsAsync(); _loaded = true; }
        catch (ApiException ex) { _loadError = ex.Message; }
        catch (HttpRequestException) { _loadError = LoadingSection.Unreachable; }
    }
    private async Task CreateAsync()
    {
        if (_form is null) return;
        await _form.ValidateAsync(); if (!_form.IsValid) return;
        _busy = true; _error = null;
        try
        {
            var agent = await Api.CreateWorktreeAsync(Source.Id, new(_name, _branch, _revision, _harness,
                _accounts.Any(a => a.Id == _account && a.HarnessId == _harness) ? _account : null, _start));
            Dialog.Close(DialogResult.Ok(agent.Id)); Navigation.NavigateTo($"agents/{agent.Id}");
        }
        catch (ApiException ex) { _error = ex.Message + " Check Agents for any recorded workspace before trying again."; }
        catch (HttpRequestException) { _error = LoadingSection.Unreachable + " Check Agents before trying again; creation may have completed."; }
        finally { _busy = false; }
    }
}
