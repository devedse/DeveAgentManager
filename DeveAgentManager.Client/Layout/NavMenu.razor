@inherits LiveComponent
@inject SignedInUser Me

<div class="nav-wrapper">
    <MudNavMenu Class="app-nav" Rounded="true" Margin="Margin.Dense" Color="Color.Primary">
        <div class="nav-section">Overview</div>
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Rounded.SpaceDashboard">Dashboard</MudNavLink>
        <MudNavLink Href="activity" Icon="@Icons.Material.Rounded.MonitorHeart">Agent activity</MudNavLink>
        <div class="nav-section">Work</div>
        <MudNavLink Href="agents" Icon="@Icons.Material.Rounded.SmartToy">
            <div class="nav-link-row">
                <span>Agents</span>
                @if (_runningAgents > 0)
                {
                    <span class="nav-badge nav-badge-live">@_runningAgents</span>
                }
            </div>
        </MudNavLink>
        @* While loading: rows like the running agents', and like the links that depend on the user's roles. *@
        <LoadingSection Loaded="@(Loaded || LoadError is not null)" Label="Loading running agents">
        <Placeholder>
            @for (var i = 0; i < 2; i++)
            {
                <div class="nav-skeleton-row nav-skeleton-agent"><span class="skeleton nav-skeleton-avatar"></span><span class="skeleton nav-skeleton-line" style="@($"width:{(i == 0 ? 55 : 40)}%")"></span></div>
            }
        </Placeholder>
        <ChildContent>
        @foreach (var agent in _liveAgents)
        {
            <MudNavLink Href="@($"agents/{agent.Id}")" Match="NavLinkMatch.All" Class="nav-agent">
                <div class="nav-agent-row">
                    <span class="nav-agent-avatar">
                        <AgentAvatar Agent="agent" Class="nav-avatar" />
                        <span class="nav-agent-dot @(agent.State != AgentState.Running ? "" : StateStyles.For(agent).Tone == Tone.Warning ? "warning" : StateStyles.For(agent).Tone == Tone.Unclear ? "unclear" : agent.Working ? "working" : "live")" title="@(agent.Activity?.Reason ?? StateStyles.For(agent).Text)"></span>
                    </span>
                    <span class="nav-agent-name">@agent.Name</span>
                    <span class="nav-agent-meta">@agent.RunnerName</span>
                </div>
            </MudNavLink>
        }
        </ChildContent>
        </LoadingSection>
        <MudNavLink Href="sessions" Icon="@Icons.Material.Rounded.Forum">Sessions</MudNavLink>
        <MudNavLink Href="runners" Icon="@Icons.Material.Rounded.Dns">
            <div class="nav-link-row">
                <span>Runners</span>
                @if (_readyRunners > 0)
                {
                    <span class="nav-badge">@_readyRunners</span>
                }
            </div>
        </MudNavLink>
        <div class="nav-section">Manage</div>
        <MudNavLink Href="settings" Icon="@Icons.Material.Rounded.Tune">My settings</MudNavLink>
        <LoadingSection Loaded="@(Loaded || LoadError is not null)" Announce="false">
        <Placeholder>
            <div class="nav-skeleton-row"><span class="skeleton nav-skeleton-icon"></span><span class="skeleton nav-skeleton-line" style="width:50%"></span></div>
        </Placeholder>
        <ChildContent>
        @if (_user?.Has(UserRoles.SettingsManager) == true)
        {
            <MudNavLink Href="manager-settings" Icon="@Icons.Material.Rounded.SettingsApplications">Manager settings</MudNavLink>
        }
        @if (_user?.Has(UserRoles.HarnessLoginManager) == true)
        {
            <MudNavLink Href="harness-logins" Icon="@Icons.Material.Rounded.ManageAccounts">Harness logins</MudNavLink>
        }
        @if (_user?.Has(UserRoles.LogViewer) == true)
        {
            <MudNavLink Href="logs" Icon="@Icons.Material.Rounded.ReceiptLong">Manager logs</MudNavLink>
        }
        @if (_user?.Has(UserRoles.UserManager) == true)
        {
            <MudNavLink Href="users" Icon="@Icons.Material.Rounded.Group">Users</MudNavLink>
            <MudNavLink Href="audit" Icon="@Icons.Material.Rounded.Policy">Audit log</MudNavLink>
        }
        </ChildContent>
        </LoadingSection>
    </MudNavMenu>

    <div class="nav-footer">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">DeveAgentManager @AppUpdateService.CurrentVersion</MudText>
    </div>
</div>

@code {
    private int _runningAgents;
    private int _readyRunners;
    private List<AgentDto> _liveAgents = [];
    private CurrentUserDto? _user;

    protected override bool IsRelevant(ManagerEvent managerEvent) => managerEvent.Kind != ManagerEventKind.SettingsChanged;

    protected override async Task OnInitializedAsync()
    {
        Me.Changed += OnUserChanged;
        await base.OnInitializedAsync();
    }

    private void OnUserChanged() => _ = ReloadAsync();

    public override void Dispose()
    {
        Me.Changed -= OnUserChanged;
        base.Dispose();
    }

    protected override async Task LoadAsync()
    {
        _user = await Me.GetAsync();
        var runners = await Api.ListRunnersAsync();
        _readyRunners = runners.Count(r => r.State == RunnerState.Ready);
        _liveAgents = runners.SelectMany(r => r.Agents)
            .Where(a => a.OwnerId == _user.Id || a.SharedWithMe)
            .Where(a => a.State is AgentState.Running or AgentState.Starting)
            .ByLastReply()
            .ToList();
        _runningAgents = _liveAgents.Count;
    }
}
