@* MudBlazor's theme, dialogs, popovers and snackbars: in the Portal's layouts (not in Routes, which the Manager also
   renders for its login page, without MudBlazor). *@
<MudThemeProvider Theme="AppTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider CloseOnEscapeKey="true" CloseButton="true" MaxWidth="MaxWidth.Small" FullWidth="true" />
<MudSnackbarProvider />
