@inherits LayoutComponentBase
@implements IDisposable
@inject ManagerApi Api
@inject LiveUpdates Live

<MudProviders />
<LoadingDone />

<MudLayout>
    <MudAppBar Elevation="0" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" Class="mr-1" aria-label="Menu" />
        <a href="" class="brand">
            <img src="favicon.svg" alt="" width="28" height="28" />
            <span class="brand-name">Deve<span class="brand-accent">AgentManager</span></span>
        </a>
        <MudSpacer />
        @if (!Live.IsConnected)
        {
            <span class="live-offline" title="The live connection to the Manager is being restored. Pages update again once it is back.">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" /> Reconnecting…
            </span>
        }
        <AttentionMenu />
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Rounded.AccountCircle" Class="user-button" OnClick="@context.ToggleAsync">
                    <span class="d-none d-sm-inline">@_username</span>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Rounded.Settings" Href="settings">Settings</MudMenuItem>
                @* A plain form: signing out clears the cookie on the server and goes to the login page. *@
                <form method="post" action="account/logout" class="menu-form">
                    <button type="submit" class="menu-form-button">
                        <MudIcon Icon="@Icons.Material.Rounded.Logout" Size="Size.Small" />
                        <span>Sign out</span>
                    </button>
                </form>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="0" Class="app-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="app-main">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong in the Portal.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private bool _drawerOpen = true;
    private string? _username;

    protected override async Task OnInitializedAsync()
    {
        Live.StateChanged += OnLiveStateChanged;
        try
        {
            _username = (await Api.InfoAsync()).AdminUsername;
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // Shown without the name.
        }
    }

    private void OnLiveStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Live.StateChanged -= OnLiveStateChanged;
}
