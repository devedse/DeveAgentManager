@inherits LayoutComponentBase
@implements IDisposable
@inject SignedInUser Me
@inject LiveUpdates Live
@inject NavigationManager Navigation
@inject ManagerApi Api
@inject IDialogService Dialogs

<MudProviders />
<LoadingDone />

<MudLayout>
    <MudAppBar Elevation="0" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Rounded.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawerOpen = !_drawerOpen" Class="mr-1" aria-label="Menu" />
        <a href="" class="brand">
            <img src="favicon.svg" alt="" width="28" height="28" />
            <span class="brand-name">Deve<span class="brand-accent">AgentManager</span></span>
        </a>
        <MudSpacer />
        @if (!Live.IsConnected)
        {
            <span class="live-offline" title="The live connection to the Manager is being restored. Pages update again once it is back.">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" /> Reconnecting…
            </span>
        }
        <AttentionMenu />
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Rounded.AccountCircle" Class="user-button" OnClick="@context.ToggleAsync"
                           aria-label="@($"Signed in as {_user?.DisplayName}")">
                    <span class="d-none d-sm-inline">@_user?.DisplayName</span>
                </MudButton>
            </ActivatorContent>
            <ChildContent>
                @if (_user is not null)
                {
                    <div class="menu-user">
                        <div class="menu-user-name">@_user.DisplayName</div>
                        <div class="menu-user-meta">@_user.Username@(_user.Roles == UserRoles.None ? "" : $" · {Roles.Describe(_user.Roles)}")</div>
                    </div>
                }
                <MudMenuItem Icon="@Icons.Material.Rounded.Settings" Href="settings">My settings</MudMenuItem>
                @* The change-password page is the Manager's own (also used when a new password is required). *@
                <MudMenuItem Icon="@Icons.Material.Rounded.Password" Href="@ChangePasswordUrl" ForceLoad="true">Change password</MudMenuItem>
                @* Server-rendered security pages supply antiforgery tokens and revoke sessions. *@
                <MudMenuItem Icon="@Icons.Material.Rounded.Security" Href="/security" ForceLoad="true">Account security</MudMenuItem>
                <a href="/logout" class="login-link">Sign out</a>
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="0" Class="app-drawer">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="app-main">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong in the Portal.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private bool _drawerOpen = true;
    private CurrentUserDto? _user;

    private string ChangePasswordUrl => $"password?returnUrl={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}";

    protected override async Task OnInitializedAsync()
    {
        Api.ConfirmPassword = ConfirmPasswordAsync;
        Live.StateChanged += OnChanged;
        Me.Changed += OnUserChanged;
        await LoadUserAsync();
    }

    private async Task LoadUserAsync()
    {
        try
        {
            _user = await Me.GetAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException)
        {
            // Shown without the name.
        }
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task<bool> ConfirmPasswordAsync(bool withCode)
    {
        var dialog = await Dialogs.ShowAsync<ConfirmPasswordDialog>(null, new DialogParameters<ConfirmPasswordDialog> { { d => d.WithCode, withCode } },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        return await dialog.Result is { Canceled: false };
    }

    private void OnUserChanged() => InvokeAsync(async () =>
    {
        await LoadUserAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        Live.StateChanged -= OnChanged;
        Me.Changed -= OnUserChanged;
    }
}
