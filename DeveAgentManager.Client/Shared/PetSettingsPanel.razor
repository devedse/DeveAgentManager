@using DeveAgentManager.Contracts.Pets
@implements IDisposable
@inject PetClient Pets
@inject ManagerApi Api
@inject ISnackbar Snackbar

<LoadingSection Loaded="@(Pets.State is not null)" Error="@Pets.Error" Retry="Pets.ReloadAsync" Label="Loading your Damagochi">
    <Placeholder><SkeletonForm Fields="4" /></Placeholder>
    <ChildContent>
    @if (Pets.State is { } state)
    {
        <div class="settings-section">
            <div class="help-heading"><MudText Typo="Typo.subtitle1">Your Damagochi</MudText>
                <HelpTip Label="Damagochi"><p>Choose a species and give your egg a name to hatch your Damagochi. New Damagochi start at level 1 with zero lifetime tokens. The XP bar shows progress within the current level.</p><p>Changing species requires killing your current Damagochi and confirming its permanent reset. Damagochi lifetime tokens reset; account tokens are kept separately. Damagochi managers can change Damagochi directly in Manager settings.</p><p>Snoozing hides your Damagochi while it keeps growing. Disabling pauses Damagochi growth; account usage keeps counting. Position is saved in this browser.</p></HelpTip></div>
            @if (state.CanEdit)
            {
                <MudSwitch T="bool" @bind-Value="_enabled" Label="Enable my Damagochi" Color="Color.Primary" />
                @if (state.Pet.NeedsAdoption)
                {
                    <div class="help-heading"><MudText Typo="Typo.subtitle2">Your egg needs a Damagochi and a name</MudText>
                        <HelpTip Label="Choosing your Damagochi"><p>Choose the Damagochi you want to raise and enter its name. Hatching starts a new Damagochi at zero XP; previous lifetime tokens do not grow it. You can rename it later, but replacing it requires the confirmed Kill Damagochi action.</p></HelpTip></div>
                    <div class="form-row">
                        <MudSelect T="string" @bind-Value="_species" Label="Choose a Damagochi" Placeholder="Choose a Damagochi" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var pet in state.Catalog) { <MudSelectItem Value="@pet.Id">@pet.Name</MudSelectItem> }
                        </MudSelect>
                        <MudTextField @bind-Value="_name" Immediate="true" Label="Name your Damagochi" MaxLength="40" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                    <div class="settings-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Adopt" Disabled="@(_saving || string.IsNullOrWhiteSpace(_name) || string.IsNullOrEmpty(_species))">Choose Damagochi and hatch egg</MudButton></div>
                }
                else
                {
                    <div class="form-row">
                        <MudTextField Value="@(state.Catalog.First(p => p.Id == state.Pet.Species).Name)" Label="Damagochi type" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="_name" Label="Name" MaxLength="40" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                    <div class="dam-pet-stats"><span>@state.Pet.StageName</span><span>@state.Pet.Experience.ToString("N0") Damagochi lifetime tokens</span><span>Happiness @state.Pet.Happiness%</span></div>
                    <PetXpBar Pet="state.Pet" />
                }
                <MudNumericField T="int" @bind-Value="_size" Min="90" Max="240" Label="Damagochi size" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSwitch T="bool" @bind-Value="_reduced" Label="Reduce Damagochi movement" Color="Color.Primary" />
                @if (state.Pet.SnoozedUntil > DateTime.UtcNow)
                {
                    <MudText Typo="Typo.body2">Your Damagochi is snoozing.</MudText>
                    <MudButton OnClick="Wake" Disabled="_saving">Bring back now</MudButton>
                }
                <div class="settings-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving">Save Damagochi settings</MudButton></div>
                @if (!state.Pet.NeedsAdoption) { <div class="settings-actions"><PetRetireButton /></div> }
                @if (!state.Options.Enabled) { <MudText Typo="Typo.body2">Damagochi is globally disabled; these preferences are saved for later.</MudText> }
            }
            else { <MudText Typo="Typo.body2">Damagochi is disabled by a Damagochi manager.</MudText> }
        </div>
        <AccountUsageBar Tokens="state.Pet.LifetimeTokens" />
    }
    </ChildContent>
</LoadingSection>
@code {
    private bool _enabled, _reduced, _saving, _loaded;
    private string _name = "", _species = "";
    private int _size = 140;
    private long _generation;
    private PetPreferences? _shown;
    protected override async Task OnInitializedAsync() { Pets.Changed += Changed; await Pets.StartAsync(); Load(); }
    private void Changed() { Load(); _ = InvokeAsync(StateHasChanged); }
    private void Load() {
        if (Pets.State is not { } s) return;
        var current = new PetPreferences(_enabled, s.Pet.NeedsAdoption ? "" : _name, s.Pet.NeedsAdoption ? "" : _species, _reduced, _size, _generation);
        if (!_loaded || _generation != s.Pet.Generation || current == _shown) {
            // Preserve an in-progress adoption form during unrelated live token updates.
            if (!_loaded || _generation != s.Pet.Generation || !s.Pet.NeedsAdoption) { _name = s.Pet.Name; _species = s.Pet.Species; }
            _enabled = s.Pet.Enabled; _size = s.Pet.Size; _reduced = s.Pet.ReducedMotion; _generation = s.Pet.Generation; _loaded = true;
        }
        _shown = new(s.Pet.Enabled, s.Pet.Name, s.Pet.Species, s.Pet.ReducedMotion, s.Pet.Size, s.Pet.Generation);
    }
    private async Task Run(Func<Task> action, string message) {
        _saving = true;
        try { await action(); await Pets.ReloadAsync(); Snackbar.Add(message, Severity.Success); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }
    private Task Save() => Run(async () => {
        var pending = Pets.State!.Pet.NeedsAdoption;
        await Api.SavePetAsync(new(_enabled, pending ? "" : _name, pending ? "" : _species, _reduced, _size, _generation));
    }, "Damagochi settings saved.");
    private Task Adopt() => Run(async () => { await Api.AdoptPetAsync(new(_name, _species, _generation)); }, "Your Damagochi has hatched.");
    private Task Wake() => Run(() => Api.PetActionAsync("wake"), "Damagochi brought back.");
    public void Dispose() => Pets.Changed -= Changed;
}
