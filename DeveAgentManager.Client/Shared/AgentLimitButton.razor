@inherits LiveComponent
@inject IDialogService Dialogs
@inject BrowserClock Clock
@inject ContinueOffers Offers

@if (InMenu)
{
    <MudMenuItem Icon="@StatusIcon" IconColor="@StatusColor" OnClick="OpenAsync">@Hint</MudMenuItem>
}
else if (OfferOnly)
{
    @Offer
}
else
{
    @* The offer drops down from the button: its popover is placed against this span. *@
    <span class="continue-offer-anchor">
        <MudTooltip Text="@Hint">
            <MudIconButton Icon="@StatusIcon"
                           Class="@(_limit?.Status is "Detected" or "Expired" && !_limit.NativeAutoContinue ? "limit-alert-blink" : _automatic.Enabled && StatusColor == Color.Success ? "auto-continue-active" : "")"
                           Color="@StatusColor" Size="Size.Small" OnClick="OpenAsync" aria-label="@Hint" />
        </MudTooltip>
        @if (!Overflowed)
        {
            @Offer
        }
    </span>
}

@code {
    [Parameter] public Guid AgentId { get; set; }
    /// <summary>An entry in the toolbar's ⋮ menu, when the toolbar has no room for the button.</summary>
    [Parameter] public bool InMenu { get; set; }
    /// <summary>The toolbar has no room for this button (it is hidden): its offer drops down from the ⋮ menu instead.</summary>
    [Parameter] public bool Overflowed { get; set; }
    /// <summary>Only the offer to turn on auto-continue, against the element around it: the ⋮ menu, while the button is in it.</summary>
    [Parameter] public bool OfferOnly { get; set; }
    private bool DetectionUnavailable => _limit?.DetectionProblem is not null || _limitError is not null || _automaticError is not null;
    private bool UnknownReset => _limit is { Manual: false, DetectedResetAt: null, Status: "Detected" or "Expired" };
    private bool ScheduleWaiting => _limit is { Status: "Scheduled" } && (_limit.Detail?.StartsWith("Waiting", StringComparison.Ordinal) == true || _limit.ContinueAt <= DateTime.UtcNow);
    private Color StatusColor => _limit?.Status == "Uncertain" ? Color.Error
        : DetectionUnavailable ? Color.Warning
        : !_limitLoaded || !_automaticLoaded ? Color.Default
        : _limit?.NativeAutoContinue == true ? Color.Info
        : _limit?.Status == "Scheduled" ? (ScheduleWaiting ? Color.Warning : Color.Info)
        : _limit is not null ? Color.Warning
        : _automatic.Enabled ? Color.Success : Color.Default;
    private AgentLimitDto? _limit;
    private AutoContinueDto _automatic = new();
    private string? _scheduledLocal, _limitError, _automaticError;
    private bool _limitLoaded, _automaticLoaded;
    protected override TimeSpan? RefreshInterval => TimeSpan.FromSeconds(5);
    private string StatusIcon => DetectionUnavailable || UnknownReset ? Icons.Material.Rounded.WarningAmber : _limit?.Status switch
    {
        "Scheduled" => Icons.Material.Rounded.Schedule,
        "Sending" => Icons.Material.Rounded.Sync,
        "Sent" => Icons.Material.Rounded.CheckCircle,
        "Cancelled" => Icons.Material.Rounded.EventBusy,
        "Uncertain" => Icons.Material.Rounded.ErrorOutline,
        _ => _automatic.Enabled ? Icons.Material.Rounded.Autorenew : Icons.Material.Rounded.HourglassBottom
    };
    private string Hint => !_automaticLoaded && _automaticError is null || !_limitLoaded && _limitError is null ? "Loading continuation status…"
        : _automaticError is not null ? "Automatic continuation status unavailable; retry"
        : _limitError is not null ? (_automatic.Enabled ? "Auto-continue on · limit status unavailable; retry" : "Continuation status unavailable; retry")
        : _limit?.DetectionProblem is not null ? (_automatic.Enabled ? "Auto-continue on · detection unavailable" : "Usage-limit detection unavailable; retry")
        : _limit?.Status == "Uncertain" ? "Continue delivery uncertain; check the terminal"
        : _automatic.Enabled && _limit?.NativeAutoContinue == true ? "Claude is handling its own automatic continuation"
        : _automatic.Enabled && UnknownReset ? "Auto-continue needs attention: reset time unknown"
        : _automatic.Enabled && _limit?.Status == "Scheduled" ? (ScheduleWaiting ? "Auto-continue waiting; view reason" : $"Auto-continue scheduled for {_scheduledLocal ?? "the detected reset"}")
        : _automatic.Enabled && _limit?.Status == "Sending" ? "Sending automatic continue"
        : _automatic.Enabled && _limit?.Status == "Sent" ? "Continue submitted; waiting for the agent to resume"
        : _automatic.Enabled && _limit is not null ? "Auto-continue needs attention; view usage limit"
        : _automatic.Enabled ? $"Auto-continue on · {(_automatic.Remaining is { } count ? $"{count} remaining" : "unlimited")}" : _limit is null ? "Schedule continue" : _limit?.NativeAutoContinue == true ? "Usage limit: Claude will continue automatically"
        : _limit?.Status == "Scheduled" ? $"Continue scheduled for {_scheduledLocal ?? "your chosen time"}"
        : _limit?.Status == "Sending" ? "Sending scheduled continue"
        : _limit?.Status == "Sent" ? "Continue submitted; view result"
        : _limit?.Status == "Cancelled" ? "Continue cancelled; view reason"
        : _limit?.Status == "Uncertain" ? "Continue delivery uncertain; check the terminal"
        : _limit?.Manual == true ? "Schedule continue"
        : _limit?.ResetAt is null ? "Usage limit" : "Usage limit: schedule continue after reset";
    protected override bool IsRelevant(ManagerEvent change) => change.AgentId == AgentId;
    protected override async Task LoadAsync()
    {
        await Task.WhenAll(LoadLimitAsync(), LoadAutomaticAsync());
        await LoadOfferAsync();
    }
    private async Task LoadLimitAsync()
    {
        try
        {
            _limit = await Api.GetAgentLimitAsync(AgentId);
            _limitLoaded = true;
            _limitError = null;
            _scheduledLocal = _limit?.ContinueAt is { } at ? await Clock.DescribeAsync(at) : null;
        }
        catch (ApiException ex) { _limitError = ex.Message; }
        catch (HttpRequestException) { _limitError = LoadingSection.Unreachable; }
    }
    private async Task LoadAutomaticAsync()
    {
        try { _automatic = await Api.GetAutoContinueAsync(AgentId); _automaticLoaded = true; _automaticError = null; }
        catch (ApiException ex) { _automaticError = ex.Message; }
        catch (HttpRequestException) { _automaticError = LoadingSection.Unreachable; }
    }
    private async Task OpenAsync()
    {
        // Seeing all the options answers the offer for this reset time.
        if (_offer && _limit?.DetectedResetAt is { } reset) await Offers.AnswerAsync(AgentId, reset);
        var dialog = await Dialogs.ShowAsync<ContinueAfterLimitDialog>(_limit is null || _limit.Manual ? "Schedule continue" : "Continue after usage limit", new DialogParameters
        { [nameof(ContinueAfterLimitDialog.LimitLoaded)] = _limitLoaded, [nameof(ContinueAfterLimitDialog.AutomaticLoaded)] = _automaticLoaded,
            [nameof(ContinueAfterLimitDialog.LimitLoadError)] = _limitError, [nameof(ContinueAfterLimitDialog.AutomaticLoadError)] = _automaticError,
            [nameof(ContinueAfterLimitDialog.Automatic)] = _automatic, [nameof(ContinueAfterLimitDialog.AgentId)] = AgentId, [nameof(ContinueAfterLimitDialog.Limit)] = _limit ?? new AgentLimitDto("Manual continuation — no usage limit is required.", null, DateTime.UtcNow, null, null, "Detected", null, false, true) },
            new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        await dialog.Result;
        await ReloadAsync();
    }

    // A usage limit that automatic mode can handle, while it is off: offer to turn it on with one click, the same as
    // switching it on in the dialog. Once per reset time; Not now or opening the dialog answers it.
    private bool _offer, _offerBusy;
    private string? _offerReset, _offerQuestion, _offerError;
    private bool Offerable => _limitLoaded && _automaticLoaded && _limitError is null && _automaticError is null
        && !_automatic.Enabled && _automatic.Available
        && _limit is { Manual: false, Status: "Detected" or "Expired", NativeAutoContinue: false, DetectedResetAt: not null, DetectionProblem: null };
    /// <summary>A count of continuations left from before is kept, as the dialog's switch does; otherwise unlimited.</summary>
    private int? OfferRemaining => _automatic.Remaining is > 0 ? _automatic.Remaining : null;

    private async Task LoadOfferAsync()
    {
        if (!Offerable || await Offers.AnsweredAsync(AgentId, _limit!.DetectedResetAt!.Value)) { _offer = false; return; }
        var reset = _limit.DetectedResetAt!.Value;
        _offerReset = await ShortTimeAsync(reset);
        var at = reset.AddMinutes(1);
        _offerQuestion = $"Turn on auto-continue? It continues {(at <= DateTime.UtcNow ? "right away" : $"at {await ShortTimeAsync(at)}")}"
            + (OfferRemaining is { } count ? $" ({count} {(count == 1 ? "continuation" : "continuations")} left)." : ".");
        _offer = true;
    }

    /// <summary>The local time, with its date when that isn't today.</summary>
    private async Task<string> ShortTimeAsync(DateTime utc)
    {
        var parts = await Clock.LocalPartsAsync(utc);
        return parts.Date == (await Clock.LocalPartsAsync(DateTime.UtcNow)).Date ? parts.Time : $"{parts.Date} {parts.Time}";
    }

    protected override void OnInitialized() => Offers.Changed += OnOffersChanged;
    private void OnOffersChanged() => _ = InvokeAsync(async () =>
    {
        await LoadOfferAsync();
        StateHasChanged();
    });

    private async Task TurnOnAsync()
    {
        _offerBusy = true;
        _offerError = null;
        try
        {
            await Api.SetAutoContinueAsync(AgentId, true, OfferRemaining);
            // Switching on schedules the limit on screen at once: the button shows when it continues.
            await ReloadAsync();
        }
        catch (ApiException ex) { _offerError = ex.Message; }
        catch (HttpRequestException) { _offerError = LoadingSection.Unreachable; }
        finally { _offerBusy = false; }
    }

    private async Task NotNowAsync()
    {
        if (_limit?.DetectedResetAt is { } reset) await Offers.AnswerAsync(AgentId, reset);
        _offer = false;
    }

    private RenderFragment Offer => @<MudPopover Open="@_offer" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Paper="false" Class="continue-offer-popover">
        <aside class="continue-offer" aria-label="Turn on auto-continue" role="status" aria-live="polite">
            <div class="help-heading">
                <h2>Usage limit until <span class="continue-offer-time">@_offerReset</span></h2>
                <HelpTip Label="turning on auto-continue">
                    <p>Turn on switches on auto-continue for this agent, as in the usage-limit options: the Manager types <b>continue</b> one minute after this reset, and again after each later usage limit@(OfferRemaining is { } count ? $", {count} more {(count == 1 ? "time" : "times")}" : ", until you switch it off").</p>
                    <p>It waits while you have a draft or the agent is busy, and stops when the conversation or harness changes. For a one-time continue, open the options with the button.</p>
                    <p>Not now hides this in this browser until the reset time changes, including after refreshing.</p>
                </HelpTip>
            </div>
            <p>@_offerQuestion</p>
            @if (_offerError is not null)
            {
                <p class="continue-offer-error" role="alert">@_offerError</p>
            }
            <div class="continue-offer-actions">
                <MudButton Variant="Variant.Text" Disabled="_offerBusy" OnClick="NotNowAsync">Not now</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Autorenew" Disabled="_offerBusy" OnClick="TurnOnAsync">Turn on</MudButton>
            </div>
        </aside>
    </MudPopover>;

    public override void Dispose()
    {
        Offers.Changed -= OnOffersChanged;
        base.Dispose();
    }
}
