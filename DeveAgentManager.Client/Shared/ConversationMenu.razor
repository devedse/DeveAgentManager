@inject ManagerApi Api
@inject IDialogService Dialogs

@if (InMenu)
{
    <MudMenu @ref="_menu" Label="Conversations" StartIcon="@Icons.Material.Rounded.Forum" Dense="true" @bind-Open="_open" @bind-Open:after="LoadAsync" Class="conversation-picker">@Entries</MudMenu>
}
else
{
    <MudMenu @ref="_menu" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true" @bind-Open="_open" @bind-Open:after="LoadAsync" Class="conversation-picker">
        <ActivatorContent><MudButton OnClick="@context.ToggleAsync" StartIcon="@Icons.Material.Rounded.Forum" EndIcon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" aria-label="Conversations">Conversations</MudButton></ActivatorContent>
        <ChildContent>@Entries</ChildContent>
    </MudMenu>
}

@code {
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
    [Parameter] public bool InMenu { get; set; }
    [Parameter] public Guid? SessionId { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback Manage { get; set; }
    private bool _open, _loaded, _busy;
    private MudMenu? _menu;
    private string? _error;
    private IReadOnlyList<SessionDto> _sessions = [];
    private RenderFragment Entries => @<text>
        <div class="workspace-menu-heading help-heading">Conversations <HelpTip Label="Conversations"><p>Read opens saved history. Resume saves and replaces the conversation in this workspace only. Other workspace agents keep running.</p></HelpTip></div>
        @if (_error is not null) { <MudMenuItem OnClick="LoadAsync" AutoClose="false" title="@_error">Couldn't load. Retry</MudMenuItem> }
        else if (!_loaded) { <MenuLoading Label="Loading conversations" /> }
        else
        {
            @foreach (var session in _sessions)
            {
                <div class="conversation-menu-row">
                    <MudMenuItem Href="@($"sessions/{session.Id}")" Icon="@(session.Id == SessionId ? Icons.Material.Rounded.Check : Icons.Material.Rounded.Forum)">@session.Title</MudMenuItem>
                    @if (Agent.Access >= AgentAccess.Write && session.Id != SessionId)
                    { <MudIconButton Icon="@Icons.Material.Rounded.PlayArrow" Size="Size.Small" aria-label="@($"Resume {session.Title}")" Disabled="_busy" OnClick="() => ResumeAsync(session)" /> }
                </div>
            }
            <MudDivider />
            @if (Agent.Access >= AgentAccess.Write)
            {
                <MudMenuItem Icon="@Icons.Material.Rounded.Add" OnClick="NewAsync">New conversation…</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Rounded.Settings" OnClick="ManageAsync">Manage conversations…</MudMenuItem>
            }
            <MudMenuItem Href="sessions" Icon="@Icons.Material.Rounded.FolderOpen">Browse all conversations</MudMenuItem>
        }

    </text>;
    protected override Task OnInitializedAsync() => InMenu ? LoadCoreAsync() : Task.CompletedTask;
    private Task LoadAsync() => _open ? LoadCoreAsync() : Task.CompletedTask;
    private async Task LoadCoreAsync()
    {
        _loaded = false; _error = null;
        try { _sessions = (await Api.ListSessionsAsync()).Where(s => s.WorkspaceAgentId == Agent.Id || s.AgentId == Agent.Id).OrderByDescending(s => s.UpdatedAt).ToList(); _loaded = true; }
        catch (ApiException ex) { _error = ex.Message; }
        catch (HttpRequestException) { _error = LoadingSection.Unreachable; }
    }
    private async Task ResumeAsync(SessionDto session)
    {
        if (_menu is not null) await _menu.CloseAllMenusAsync();
        if (await Dialogs.ShowMessageBoxAsync("Resume conversation?", $"Resume '{session.Title}' in this workspace? The current conversation is saved and stopped. Other workspaces keep running.", yesText: "Resume", cancelText: "Cancel") != true) return;
        _busy = true; _error = null;
        try { await Api.SelectSessionAsync(Agent.Id, session.Id, null); _open = false; await Changed.InvokeAsync(); }
        catch (ApiException ex) { _error = ex.Message; }
        catch (HttpRequestException) { _error = LoadingSection.Unreachable; }
        finally { _busy = false; }
    }
    private async Task NewAsync()
    {
        if (_menu is not null) await _menu.CloseAllMenusAsync();
        var dialog = await Dialogs.ShowAsync<NewConversationDialog>("New conversation", new DialogParameters<NewConversationDialog> { { d => d.Agent, Agent } }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false }) await Changed.InvokeAsync();
    }
    private async Task ManageAsync()
    {
        if (_menu is not null) await _menu.CloseAllMenusAsync();
        await Manage.InvokeAsync();
    }
}
