@* Every list of agents: workspaces grouped under their project, projects ordered by their latest reply (AgentOrder).
   A shortened list (the dashboard's) keeps whole projects and never hides an active one. Hiding stopped agents leaves
   out a project only when all of it is stopped; ProjectAgentTable hides the stopped workspaces of the others. *@
@{
    var projects = WorkspaceGroups.Group(Agents.ForAgentList(User).Where(a => AdministrativeOnly == (a.OwnerId != User?.Id && !a.SharedWithMe)));
    var shown = projects.Where(project => !HideStopped || !project.All(WorkspaceGroups.QuietStopped)).ToList();
    var agents = Shorten(shown).SelectMany(project => project).ToList();
}
@if (AdministrativeOnly)
{
    @if (agents.Count > 0)
    {
        <section class="panel mt-4" aria-label="Other users’ agents">
            <div class="panel-header">
                <div class="help-heading"><MudText Typo="Typo.h6">Other users’ agents</MudText>
                <HelpTip Label="Other users’ agents"><p>Agents visible through your management permissions. Agents shared with you appear with your own agents above.</p></HelpTip></div>
            </div>
            <ProjectAgentTable Agents="agents" ShowRunner="ShowRunner" ShowOwner="true" HideStopped="HideStopped" />
        </section>
    }
}
else
{
    <section aria-label="Your agents">
        <div class="session-group-heading help-heading">
            <MudText Typo="Typo.h6">Your agents</MudText>
            <HelpTip Label="Your agents"><p>Your own agents and agents shared with you, ordered by their latest reply.</p></HelpTip>
        </div>
        <ProjectAgentTable Agents="agents" ShowRunner="ShowRunner" HideStopped="HideStopped" EmptyText="@(shown.Count < projects.Count ? "Only stopped agents match." : EmptyText)"><EmptyContent>@EmptyContent</EmptyContent></ProjectAgentTable>
    </section>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AgentDto> Agents { get; set; } = [];
    [Parameter, EditorRequired] public CurrentUserDto? User { get; set; }
    [Parameter] public bool AdministrativeOnly { get; set; }
    [Parameter] public bool ShowRunner { get; set; }
    [Parameter] public bool HideStopped { get; set; }
    /// <summary>
    /// How many projects to show; a project with several workspaces counts once. Projects with a running workspace, or one
    /// needing attention, always show; the most recent others fill the remaining places.
    /// </summary>
    [Parameter] public int LimitPerSection { get; set; } = int.MaxValue;

    private IEnumerable<IReadOnlyList<AgentDto>> Shorten(IReadOnlyList<IReadOnlyList<AgentDto>> projects)
    {
        static bool Active(IReadOnlyList<AgentDto> project) => project.Any(a => WorkspaceGroups.Sidebar(a, null));
        var room = Math.Max(0, LimitPerSection - projects.Count(Active));
        foreach (var project in projects)
            if (Active(project) || room-- > 0) yield return project;
    }
    [Parameter] public string EmptyText { get; set; } = "No agents match.";
    [Parameter] public RenderFragment? EmptyContent { get; set; }
}
