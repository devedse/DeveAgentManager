<span class="@(DotOnly ? "status-dot" : "status-pill") status-@Style.Tone.CssClass() @(Style.Busy ? "status-busy" : "") @Class" title="@(Title ?? Text ?? Style.Text)">
    @if (!DotOnly)
    {
        <span class="status-dot"></span>
        <span class="status-text">@(Text ?? Style.Text)</span>
    }
</span>

@code {
    [Parameter, EditorRequired]
    public StateStyle Style { get; set; } = default!;

    /// <summary>Overrides the state text, e.g. with the operation that is running.</summary>
    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>The same status color and busy animation in compact places such as the navigation.</summary>
    [Parameter]
    public bool DotOnly { get; set; }
}
