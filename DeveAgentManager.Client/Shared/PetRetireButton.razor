@implements IDisposable
@inject PetClient Pets
@inject ManagerApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<button type="button" class="dam-pet-kill" role="@(InMenu ? "menuitem" : null)" disabled="@_busy" data-pet-kill
        @onpointerenter="() => Preview(true)" @onpointerleave="() => Preview(false)"
        @onfocus="() => Preview(true)" @onblur="() => Preview(false)" @onclick="Retire">
    Kill pet and create new one…
</button>

@code {
    [Parameter] public bool InMenu { get; set; }
    [Parameter] public EventCallback OnRetired { get; set; }
    private bool _busy;
    private void Preview(bool value) => Pets.PreviewRetirement(value);
    private async Task Retire()
    {
        if (_busy || Pets.State?.Pet is not { NeedsAdoption: false } pet) return;
        _busy = true;
        try
        {
            var name = string.IsNullOrEmpty(pet.Name) ? "your pet" : pet.Name;
            var message = $"{name} will go to sleep and fade away. This permanently resets this pet’s {pet.Experience:N0} XP, level and happiness. Your {pet.LifetimeTokens:N0} lifetime tokens are kept. An unchosen egg appears so you can choose and name a new pet. This cannot be undone.";
            if (await Dialogs.ShowMessageBoxAsync($"Kill {name}?", message, yesText: "Kill pet", cancelText: "Keep pet") != true) return;
            Preview(false);
            await Api.RetirePetAsync(new(pet.Generation));
            await Pets.ReloadAsync();
            await OnRetired.InvokeAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; Preview(false); }
    }
    public void Dispose() => Preview(false);
}
