@* A shared audio file in the browser's own player. Like videos, the browser reads the original in byte ranges (seeking
   loads only what it needs), through the same revocable preview link as PDFs. *@
<div class="audio-preview-stage">
    <div class="audio-preview-player" style="@(_loaded ? null : "visibility:hidden")">
        <MudIcon Icon="@Icons.Material.Rounded.AudioFile" Class="audio-preview-icon" aria-hidden="true" />
        <audio @key="Url" src="@Url" title="@Title" controls preload="metadata"
               @onloadedmetadata="() => _loaded = true" @onerror="Failed"></audio>
    </div>
    <LoadingSection Loaded="_loaded" Error="@_error" Retry="Reload" Label="Loading audio" Class="audio-preview-loading">
        <Placeholder><Skeleton Height="40px" /></Placeholder>
        <ChildContent />
    </LoadingSection>
</div>
@code {
    [Parameter, EditorRequired] public string Url { get; set; } = "";
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public EventCallback Reload { get; set; }
    private string? _previousUrl, _error;
    private bool _loaded;

    protected override void OnParametersSet()
    {
        if (_previousUrl == Url) return;
        _previousUrl = Url; _loaded = false; _error = null;
    }

    // Also when the preview link expired (after two hours): Retry gets a new one.
    private void Failed()
    {
        _loaded = false;
        _error = "Couldn't play this audio file. This browser may not support its format: download it to play it in another player.";
    }
}
