@inject ManagerApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject SignedInUser Me

@* The agent's harness and login, and switching to another one (e.g. when a subscription ran out). Everyone with
   read-write access can switch it, but only to logins they and the owner have permission to use. *@
<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" @bind-Open="_open" @bind-Open:after="OnOpenChangedAsync">
    <ActivatorContent>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Rounded.SwapHoriz" OnClick="@context.ToggleAsync"
                   Disabled="_busy" Class="switch-chip" title="Continue in another harness or with another account">
            <span class="switch-chip-label">
                @if (_busy) { <text>Switching...</text> }
                else
                {
                    @CurrentHarnessName
                    @if (CurrentHarness?.AccountSupport is not null)
                    {
                        <span class="account-separator"> · </span><AccountIdentity Username="@CurrentUsername" Name="@CurrentAccountName" />
                    }
                }
            </span>
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        <div class="switch-menu">
            <div class="viewers-title help-heading">Continue with
                <HelpTip Label="Switching harness or account">
                    <p>The agent continues in the same folder. Completed tool calls and their results carry over as structured history. Incomplete or unsupported exchanges are labelled as historical records; the full original stays in the Manager.</p>
                    <p>Historical commands are not run again. The new harness uses its own tools and selected model for new work. Hidden reasoning stays with the original provider. Migration details are available on the session page.</p>
                </HelpTip></div>
            @if (!_loaded)
            {
                @if (_loadError is not null)
                {
                    <div class="switch-note">@_loadError <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="LoadAsync">Retry</MudButton></div>
                }
                else
                {
                    <MenuLoading Label="Loading harnesses and logins" />
                }
            }
            @foreach (var harness in _harnesses)
            {
                <div class="switch-harness harness-option"><HarnessLogo HarnessId="@harness.Id" />@harness.DisplayName</div>
                @if (!Agent.RunnerHarnessIds.Contains(harness.Id))
                {
                    @if (Agent.CanUseRunner)
                    {
                        <a class="switch-unavailable" href="@($"runners/{Agent.RunnerId}")">Install @harness.DisplayName on @Agent.RunnerName</a>
                    }
                    else
                    {
                        <span class="switch-unavailable">Not installed on @Agent.RunnerName</span>
                    }
                }
                @if (harness.AccountSupport is null)
                {
                    @Option(harness, null)
                }
                else
                {
                    var accounts = _accounts.Where(a => a.HarnessId == harness.Id && a.Enabled && a.Access >= AccountAccess.Use).OrderBy(a => a.CreatedByUsername).ThenBy(a => a.Name).ToList();
                    @foreach (var account in accounts)
                    {
                        @Option(harness, account)
                    }

                    @if (accounts.Count == 0)
                    {
                        <a class="switch-option switch-connect" href="settings">Connect a login in My settings → Harness logins</a>
                    }
                }
            }
        </div>
    </ChildContent>
</MudMenu>

@code {
    [Parameter, EditorRequired]
    public AgentDto Agent { get; set; } = default!;

    /// <summary>Raised after the agent was switched (its terminal should reconnect).</summary>
    [Parameter]
    public EventCallback Switched { get; set; }

    private List<AccountDto> _accounts = [];
    private List<HarnessDto> _harnesses = [];
    private CurrentUserDto? _me;
    private bool _open;
    private bool _busy;

    private bool IsOwner => _me?.Id == Agent.OwnerId;

    private HarnessDto? CurrentHarness => _harnesses.FirstOrDefault(h => h.Id == Agent.HarnessId);
    private string CurrentHarnessName => CurrentHarness?.DisplayName ?? Agent.HarnessId;
    private bool Running => Agent.State is AgentState.Running or AgentState.Starting;
    private string? CurrentUsername => CurrentAccount?.CreatedByUsername ?? (Running ? Agent.RunningAccountUsername : Agent.AccountUsername);
    private string CurrentAccountName => CurrentAccount?.Name ?? (Running ? Agent.RunningAccountName ?? "Unknown" : Agent.AccountName ?? "Default");

    /// <summary>The selected login, including the agent owner's default when there is no explicit selection.</summary>
    private AccountDto? CurrentAccount => (Running ? Agent.RunningAccountId ?? Agent.AccountId : Agent.AccountId) is { } id
        ? _accounts.FirstOrDefault(a => a.Id == id)
        : IsOwner ? _accounts.FirstOrDefault(a => a.HarnessId == Agent.HarnessId && a.IsDefault) : null;

    private bool _loaded;
    private string? _loadError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            _harnesses = (await Api.InfoAsync()).Harnesses.ToList();
            _me = await Me.GetAsync();
            _accounts = await Api.ListAccountsAsync();
            _loaded = true;
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _loadError = LoadingSection.Unreachable;
        }
    }

    private async Task OnOpenChangedAsync()
    {
        if (_open)
        {
            await LoadAsync();
        }
    }

    private RenderFragment Option(HarnessDto harness, AccountDto? account) => __builder =>
    {
        var current = Agent.State == AgentState.Running && harness.Id == Agent.HarnessId && (account is null || account.Id == CurrentAccount?.Id);
        <button type="button" class="switch-option @(current ? "switch-current" : "")" disabled="@(current || !Agent.RunnerHarnessIds.Contains(harness.Id) || account is { Access: < AccountAccess.Use })" @onclick="() => SwitchAsync(harness, account)">
            <MudIcon Icon="@(current ? Icons.Material.Rounded.CheckCircle : Icons.Material.Rounded.ArrowForward)" Size="Size.Small" />
            <span class="switch-option-label">
                <AccountIdentity Username="@(account is null ? _me?.Username : account.CreatedByUsername)" Name="@(account?.Name ?? harness.DisplayName)" />
                @if (account is not null)
                {
                    <span class="account-identity-meta"> · @account.Id.ToString("N")[..6]@(account.IsDefault ? " (your default)" : "")</span>
                }
            </span>
            @if (current)
            {
                <span class="switch-note">now</span>
            }
        </button>
    };

    private async Task SwitchAsync(HarnessDto harness, AccountDto? account)
    {
        _open = false;
        var changesHarness = harness.Id != Agent.HarnessId;
        var target = account is null ? harness.DisplayName : $"{harness.DisplayName} ({AccountLabel.Name(account)})";
        var message = changesHarness
            ? $"Continue the conversation with {harness.DisplayName} in the same folder, preserving completed tool history and a backup of the original?"
            : $"{harness.DisplayName} restarts with the account '{(account is null ? harness.DisplayName : AccountLabel.Name(account))}' and resumes the conversation.";
        if (!IsOwner && account is not null)
        {
            message += $" {Agent.OwnerName} must also have Use access to this login.";
            if (!Agent.CanUseRunner)
            {
                message += $" The login is copied to {Agent.RunnerName}, where everyone with access to that Runner can read it.";
            }
        }
        var confirmed = await Dialogs.ShowMessageBoxAsync($"Continue '{Agent.Name}' with {target}?", message, yesText: "Continue", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        _busy = true;
        var source = Agent;
        var sourceLabel = CurrentHarnessName + (CurrentHarness?.AccountSupport is not null ? $" ({CurrentUsername} · {CurrentAccountName})" : "");
        StateHasChanged();
        try
        {
            await Api.SwitchAgentAsync(Agent.Id, harness.Id, account?.Id);
            Snackbar.Add($"'{Agent.Name}' continues with {target}.", Severity.Success);
            await Switched.InvokeAsync();
        }
        catch (Exception ex)
        {
            var dialog = await Dialogs.ShowAsync<SwitchFailureDialog>("Conversation switch failed", new DialogParameters<SwitchFailureDialog>
            {
                { d => d.Agent, source }, { d => d.SourceLabel, sourceLabel }, { d => d.TargetLabel, target },
                { d => d.TargetHarnessId, harness.Id }, { d => d.AccountId, account?.Id },
                { d => d.Error, ex is HttpRequestException ? "The connection was interrupted before the Manager confirmed the result." : ex.Message },
                { d => d.CanRetry, ex is ApiException { Code: SessionMigrationProblems.VerificationFailed } },
            }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false, CloseOnEscapeKey = false, CloseButton = false });
            if ((await dialog.Result) is { Canceled: false })
            {
                Snackbar.Add($"'{source.Name}' continues with {target}.", Severity.Success);
                await Switched.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
