@implements IAsyncDisposable
@using DeveAgentManager.Contracts.Pets
@inject PetClient Pets
@inject ManagerApi Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="dam-pet-host" @ref="_host" hidden="@(!Visible)" data-pet-user="@Pets.State?.Pet.UserId">
    <div class="dam-pet-body" role="button" tabindex="0" aria-label="@(Pets.State?.Pet.NeedsAdoption == true ? "Unchosen egg. Choose a Damagochi and give it a name." : $"{Pets.State?.Pet.Name}, level {Pets.State?.Pet.Level}. Tap to show affection; right-click or press Shift+F10 for the menu.")">
        <div class="dam-pet-art" @ref="_mount"></div>
        <span class="dam-pet-name @(Pets.State?.Pet.NeedsAdoption == true ? "dam-pet-choose" : null)">@(Pets.State?.Pet.NeedsAdoption == true ? "Choose Damagochi & name" : $"{Pets.State?.Pet.Name} ♡")</span>
    </div>
    <div class="dam-pet-hide-target" aria-hidden="true">Drop here to hide for 5 minutes</div>
    @if (_menu && Pets.State is { } state)
    {
        <div class="dam-pet-menu" role="menu" aria-label="Damagochi interactions">
            <div class="dam-pet-summary">
                <b>@(state.Pet.NeedsAdoption ? "Your egg is waiting" : state.Pet.Name)</b>
                @if (state.Pet.NeedsAdoption) { <span>Choose a Damagochi and give it a name.</span> }
                else { <span>@state.Pet.StageName · Happiness @state.Pet.Happiness%</span><PetXpBar Pet="state.Pet" /> }
                @if (!state.Pet.NeedsAdoption) { <span>@state.Pet.Experience.ToString("N0") Damagochi lifetime tokens</span> }
            </div>
            <AccountUsageBar Tokens="state.Pet.LifetimeTokens" Compact="true" />
            @if (state.Pet.NeedsAdoption) { <a role="menuitem" href="settings?tab=damagochi" @onclick="() => _menu = false">Choose Damagochi and name…</a> }
            else {
                <button role="menuitem" @onclick='() => Action("pet")'>Show affection</button>
                <button role="menuitem" @onclick='() => Action("play")'>Play</button>
            }
            @foreach (var minutes in new[] { 5, 15, 60 })
            {
                <button role="menuitem" @onclick="() => Snooze(minutes)">Go away for @minutes minutes</button>
            }
            <button role="menuitem" @onclick='() => Action("hide")'>Hide until I turn it on again</button>
            <a role="menuitem" href="settings?tab=damagochi" @onclick="() => _menu = false">Damagochi settings</a>
            <button role="menuitem" @onclick="() => _menu = false">Close</button>
            @if (_error is not null) { <span role="alert">@_error</span> }
        </div>
    }
</div>

@code {
    private ElementReference _host, _mount;
    private IJSObjectReference? _module;
    private DotNetObjectReference<PetHost>? _self;
    private bool _menu, _disposed, _departing, _savingGoAway;
    private MyPetDto? _observedState;
    private PetStateDto? _pendingDeparture;
    private long _departureVersion;
    private string? _error;
    private PeriodicTimer? _timer;
    private static bool IsVisible(MyPetDto? state) => state is { Options.Enabled: true, Pet.Enabled: true } s && (s.Pet.SnoozedUntil is null || s.Pet.SnoozedUntil <= DateTime.UtcNow);
    private bool Visible => Pets.State is { Options.Enabled: true } && (_departing || IsVisible(Pets.State));
    protected override void OnInitialized() { _observedState = Pets.State; Pets.Changed += OnChanged; }
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first) {
            _self = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pet-host.js");
            await _module.InvokeVoidAsync("initialize", _host, _mount, _self);
            await Pets.StartAsync();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(15)); _ = TickAsync();
        }
        if (_module is not null && Pets.State is { } state) {
            var renderer = state.Pet.NeedsAdoption ? "unclaimed-egg" : state.Catalog.First(d => d.Id == state.Pet.Species).Renderer;
            await _module.InvokeVoidAsync("update", _host, state.Pet, renderer, Visible, Pets.Threatened);
            if (_pendingDeparture is { } expected) {
                _pendingDeparture = null;
                var version = _departureVersion;
                try { await _module.InvokeVoidAsync("depart", _host, expected); }
                catch (JSDisconnectedException) { }
                finally {
                    if (version == _departureVersion) _departing = false;
                    if (!_disposed) await InvokeAsync(StateHasChanged);
                }
            }
        }
    }
    private async Task TickAsync() { try { while (_timer is not null && await _timer.WaitForNextTickAsync()) await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { } }
    private void OnChanged() {
        if (_disposed) return;
        _ = InvokeAsync(() => {
            var previous = _observedState; var current = Pets.State; _observedState = current;
            // Every screen observes the saved transition before rendering the hidden state.
            // Initial loads and global disabling do not replay a farewell.
            if (IsVisible(previous) && current is { Options.Enabled: true } && !IsVisible(current) &&
                previous!.Pet.UserId == current.Pet.UserId && previous.Pet.Generation == current.Pet.Generation && previous.Pet.Species == current.Pet.Species) {
                _departing = true; _pendingDeparture = current.Pet; _departureVersion++; _menu = false;
            }
            StateHasChanged();
        });
    }
    [JSInvokable] public Task OpenMenu() { if (!_departing && !_savingGoAway) _menu = !_menu; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task CloseMenu() { _menu = false; return InvokeAsync(StateHasChanged); }
    [JSInvokable] public Task Pet() {
        if (_departing || _savingGoAway) return Task.CompletedTask;
        if (Pets.State?.Pet.NeedsAdoption == true) { Navigation.NavigateTo("settings?tab=damagochi"); return Task.CompletedTask; }
        return Action("pet");
    }
    [JSInvokable] public Task Dismiss() => Snooze(5);
    private async Task Action(string action) {
        if (action == "hide") { await GoAway(() => Api.PetActionAsync(action)); return; }
        try { await Api.PetActionAsync(action); _menu = false; _error = null; await Pets.ReloadAsync(); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; _menu = true; }
        await InvokeAsync(StateHasChanged);
    }
    private Task Snooze(int minutes) => GoAway(() => Api.SnoozePetAsync(minutes));
    private async Task GoAway(Func<Task> save) {
        if (_departing || _savingGoAway) return;
        _savingGoAway = true; _menu = false; _error = null;
        await InvokeAsync(StateHasChanged);
        try {
            await save(); await Pets.ReloadAsync();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex.Message; _menu = true; }
        catch (JSDisconnectedException) { }
        finally { _savingGoAway = false; if (!_disposed) await InvokeAsync(StateHasChanged); }
    }
    public async ValueTask DisposeAsync() {
        _disposed = true; Pets.Changed -= OnChanged; _timer?.Dispose();
        if (_module is not null) { try { await _module.InvokeVoidAsync("dispose", _host); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _self?.Dispose();
    }
}
