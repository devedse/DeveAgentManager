@inherits LiveComponent
@inject IDialogService Dialogs
@inject SharedArtifactScope Scope
@* Always there, like Shared images; the count shows once the agent shared a file. *@
@if (InMenu)
{
    <MudMenuItem Icon="@Icons.Material.Rounded.FileDownload" OnClick="() => SharedFilesDialog.OpenAsync(Dialogs, SessionId)">Shared files@(Count > 0 ? $" ({Count})" : "")</MudMenuItem>
}
else
{
    <span @attributes="Attributes">
        <MudBadge Content="@Count" Visible="@(Count > 0)" Color="Color.Primary" Overlap="true">
            <MudIconButton Icon="@Icons.Material.Rounded.FileDownload" Size="Size.Small" OnClick="() => SharedFilesDialog.OpenAsync(Dialogs, SessionId)"
                           aria-label="@($"Shared files ({Count})")" title="Shared files" />
        </MudBadge>
    </span>
}
@code {
    [Parameter] public Guid SessionId { get; set; }
    /// <summary>An entry in the toolbar's ⋮ menu, when the toolbar has no room for the button.</summary>
    [Parameter] public bool InMenu { get; set; }
    /// <summary>On the button's wrapper (the toolbar's overflow attributes).</summary>
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? Attributes { get; set; }
    private List<SessionFileDto> _shared = [];
    private bool _thisWorkspace;
    // As many as the list shows: only this workspace's when the tab shows only those.
    private int Count => SharedArtifactScope.Shown(_shared, s => s.OtherWorkspace, _thisWorkspace).Count;
    protected override bool IsRelevant(ManagerEvent e) => e.SessionId == SessionId;
    protected override async Task LoadAsync()
    {
        _thisWorkspace = await Scope.ThisWorkspaceAsync();
        _shared = await Api.GetSessionFilesAsync(SessionId);
    }

    protected override void OnInitialized() => Scope.Changed += OnScopeChanged;
    private void OnScopeChanged() => _ = InvokeAsync(async () =>
    {
        _thisWorkspace = await Scope.ThisWorkspaceAsync();
        StateHasChanged();
    });

    public override void Dispose()
    {
        Scope.Changed -= OnScopeChanged;
        base.Dispose();
    }
}
