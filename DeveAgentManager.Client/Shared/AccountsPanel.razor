@inject ManagerApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* My settings → Harness logins: the user's own subscriptions and API keys their agents run with. *@
<div class="help-heading mb-3"><MudText Typo="Typo.subtitle1">Harness logins</MudText><HelpTip Label="Harness logins">Yours only. Log in once here and your agents use the login on every
    Runner you use; nothing to set up per Runner. You can have several per harness: when one runs out, switch the agent to another one (or to another harness) from its terminal.
    People you share an agent with read-write prompt it with the login it runs with.</HelpTip></div>

<LoadingSection Loaded="_loaded" Error="@_loadError" Retry="InitializeAsync" Label="Loading your harness logins">
<Placeholder><SkeletonList Rows="2" /></Placeholder>
<ChildContent>
@foreach (var harness in _harnesses)
{
    var accounts = _accounts.Where(a => a.HarnessId == harness.Id).ToList();
    <div class="settings-section">
        <div class="section-title-row">
            <MudText Typo="Typo.subtitle1" Class="section-title harness-option"><HarnessLogo HarnessId="@harness.Id" />@harness.DisplayName</MudText>
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Add" OnClick="() => ConnectAsync(harness, null)">Connect account</MudButton>
        </div>

        @if (accounts.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No account yet. Connect your @harness.AccountSupport!.SubscriptionName, or an API key.</MudText>
        }

        @foreach (var account in accounts)
        {
            <div class="account-row">
                <MudIcon Icon="@(account.Kind == AccountKind.Subscription ? Icons.Material.Rounded.WorkspacePremium : Icons.Material.Rounded.Key)" Class="account-icon" />
                <div class="account-text">
                    <div class="account-name">
                        @account.Name
                        @if (account.IsDefault)
                        {
                            <span class="account-badge">default</span>
                        }
                    </div>
                    <div class="account-meta">
                        @(account.Kind == AccountKind.Subscription ? "Subscription" : "API key") · connected @account.UpdatedAt.Humanize()
                        @if (account.AgentCount is > 0 and var count)
                        {
                            <span> · @count @(count == 1 ? "agent" : "agents")</span>
                        }
                    </div>
                    @if (account.RenewalNote is { } note)
                    {
                        <div class="account-note">
                            <span>@note</span>
                            <HelpTip Label="Staying signed in">
                                <p>ChatGPT logins last about ten days. The Manager renews them itself, a few days early, and gives Runners only the renewed access. Codex on a Runner then never renews on its own, so agents on several Runners can't use up each other's login.</p>
                                <p>Logins connected before this still renew on each Runner. Connect them again (⋮ → Reconnect) to switch. When ChatGPT ended a login, connect it again; running agents keep working until their access runs out.</p>
                            </HelpTip>
                        </div>
                    }
                </div>
                @if (!account.IsDefault)
                {
                    <MudTooltip Text="Your agents that don't pick a login use your default">
                        <MudIconButton Icon="@Icons.Material.Rounded.StarOutline" Size="Size.Small" OnClick="() => SetDefaultAsync(account)" aria-label="Make default" />
                    </MudTooltip>
                }
                <MudMenu Icon="@Icons.Material.Rounded.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <MudMenuItem Icon="@Icons.Material.Rounded.Login" OnClick="() => ConnectAsync(harness, account)">Reconnect (log in again)</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Rounded.Edit" OnClick="() => RenameAsync(account)">Rename</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Rounded.Delete" IconColor="Color.Error" OnClick="() => DeleteAsync(account)">Remove</MudMenuItem>
                </MudMenu>
            </div>
        }
    </div>
}
</ChildContent>
</LoadingSection>

@code {
    private List<HarnessDto> _harnesses = [];
    private List<AccountDto> _accounts = [];

    private bool _loaded;
    private string? _loadError;

    protected override Task OnInitializedAsync() => InitializeAsync();

    private async Task InitializeAsync()
    {
        _loadError = null;
        try
        {
            _harnesses = (await Api.InfoAsync()).Harnesses.Where(h => h.AccountSupport is not null).ToList();
            await LoadAsync();
            _loaded = true;
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _loadError = LoadingSection.Unreachable;
        }
    }

    private async Task LoadAsync() => _accounts = await Api.ListAccountsAsync();

    private async Task CallAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        await LoadAsync();
    }

    private async Task ConnectAsync(HarnessDto harness, AccountDto? existing)
    {
        var dialog = await Dialogs.ShowAsync<AccountLoginDialog>(existing is null ? $"Connect {harness.DisplayName}" : "Reconnect",
            new DialogParameters<AccountLoginDialog> { { d => d.HarnessId, harness.Id }, { d => d.Existing, existing } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        await dialog.Result;
        await LoadAsync();
    }

    private Task SetDefaultAsync(AccountDto account) => CallAsync(() => Api.SetDefaultAccountAsync(account.Id));

    private async Task RenameAsync(AccountDto account)
    {
        var parameters = new DialogParameters<TextPromptDialog> { { d => d.Label, "Name" }, { d => d.Value, account.Name } };
        var result = await (await Dialogs.ShowAsync<TextPromptDialog>("Rename account", parameters)).Result;
        if (result is { Canceled: false, Data: string name })
        {
            await CallAsync(() => Api.RenameAccountAsync(account.Id, name));
        }
    }

    private async Task DeleteAsync(AccountDto account)
    {
        var count = account.AgentCount;
        var confirmed = await Dialogs.ShowMessageBoxAsync($"Remove '{account.Name}'?",
            "The login is deleted from the Manager and from the Runners." + (count > 0 ? $" {count} {(count == 1 ? "agent uses" : "agents use")} it and will use the default account from their next start." : ""),
            yesText: "Remove", cancelText: "Cancel");
        if (confirmed == true)
        {
            await CallAsync(() => Api.DeleteAccountAsync(account.Id));
            Snackbar.Add($"Removed '{account.Name}'.", Severity.Info);
        }
    }
}
