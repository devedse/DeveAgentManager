@* The terminals attached to an agent, with a way to disconnect them. Lives in the agent's terminal toolbar. *@
@implements IAsyncDisposable
@inject ManagerApi Api
@inject ISnackbar Snackbar

@if (InMenu)
{
    @* A submenu of the toolbar's ⋮ menu, when the toolbar has no room for the chip. *@
    <MudMenu Label="@($"Screens ({_viewers?.Count ?? 0})")" StartIcon="@Icons.Material.Rounded.Devices" Dense="true" @bind-Open="_open" @bind-Open:after="OnOpenChangedAsync">
        @Content
    </MudMenu>
}
else
{
    <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" @bind-Open="_open" @bind-Open:after="OnOpenChangedAsync">
        <ActivatorContent>
            @* MudBlazor 9: a custom activator opens the menu itself. *@
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Devices" title="@Summary" aria-label="@Summary" OnClick="@context.ToggleAsync"
                       Class="@($"viewers-chip {(Others > 0 ? "viewers-chip-warn" : "")}")">@(_viewers?.Count ?? 0)</MudButton>
        </ActivatorContent>
        <ChildContent>@Content</ChildContent>
    </MudMenu>
}

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(10);

    private readonly CancellationTokenSource _lifetime = new();
    private IReadOnlyList<AgentViewer>? _viewers;
    private bool _busy;
    private string? _lastTty;

    [Parameter, EditorRequired]
    public Guid AgentId { get; set; }

    /// <summary>This page's terminal (null until it is attached).</summary>
    [Parameter]
    public string? OwnTty { get; set; }

    [Parameter]
    public string Harness { get; set; } = "the harness";

    /// <summary>A submenu of the toolbar's ⋮ menu instead of the chip.</summary>
    [Parameter]
    public bool InMenu { get; set; }

    private RenderFragment Content => @<text>
        <div class="viewers-menu">
            <div class="viewers-title help-heading">Screens attached to this agent
                <HelpTip Label="Attached screens">All screens see the agent. The screen typed on last controls its size; watching screens do not change it. Switching between different screen sizes makes @Harness redraw its conversation once.</HelpTip></div>

            @foreach (var viewer in _viewers ?? [])
            {
                var self = viewer.Tty == OwnTty;
                <div class="viewer @(self ? "viewer-self" : "")">
                    <MudIcon Icon="@(self ? Icons.Material.Rounded.PhonelinkRing : Icons.Material.Rounded.Monitor)" Size="Size.Small" Class="viewer-icon" />
                    <div class="viewer-text">
                        <div class="viewer-name">@(self ? "This screen" : "Other screen") <span class="viewer-size">@viewer.Columns×@viewer.Rows</span></div>
                        <div class="viewer-meta">@(viewer.Watching ? "Watching" : "Sets the size") · connected @viewer.ConnectedAt.Humanize() · last used @viewer.LastActiveAt.Humanize()</div>
                    </div>
                    @if (!self)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="_busy" OnClick="() => DisconnectAsync(viewer.Tty)">Disconnect</MudButton>
                    }
                </div>
            }

            @if (_viewers is { Count: 0 })
            {
                <div class="viewers-hint">No screens attached.</div>
            }

            @if (Others > 1 && OwnTty is not null)
            {
                <div class="viewers-actions">
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Rounded.LinkOff" Disabled="_busy" OnClick="() => DisconnectAsync(null)">
                        Disconnect all others
                    </MudButton>
                </div>
            }
        </div>
    </text>;

    private int Others => _viewers?.Count(v => v.Tty != OwnTty) ?? 0;

    private string Summary => _viewers is null ? "Screens attached to this agent"
        : Others == 0 ? "Only this screen is attached"
        : $"{Others} other {(Others == 1 ? "screen is" : "screens are")} attached";

    protected override void OnInitialized()
    {
        _ = PollAsync();
        // In the ⋮ menu it only exists while the menu is open: show the count right away.
        if (InMenu) _ = RefreshAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (OwnTty != _lastTty)
        {
            // Just attached (or reattached): show the new list right away.
            _lastTty = OwnTty;
            await RefreshAsync();
        }
    }

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token))
            {
                await InvokeAsync(RefreshAsync);
            }
        }
        catch (OperationCanceledException)
        {
            // The page was closed.
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            _viewers = await Api.ListViewersAsync(AgentId);
            StateHasChanged();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // The Runner is unreachable for a moment; the next poll tries again.
        }
    }

    private bool _open;

    private Task OnOpenChangedAsync() => _open ? RefreshAsync() : Task.CompletedTask;

    /// <param name="tty">One screen, or null for all but this one.</param>
    private async Task DisconnectAsync(string? tty)
    {
        _busy = true;
        try
        {
            await Api.DisconnectViewersAsync(AgentId, tty, OwnTty);
            Snackbar.Add(tty is null ? "Disconnected the other screens." : "Disconnected that screen.", Severity.Success);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }

        await RefreshAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        _lifetime.Dispose();
    }
}
