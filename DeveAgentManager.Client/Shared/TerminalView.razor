@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@* A terminal on a Runner. xterm.js talks to the Manager's terminal WebSocket (terminal.js), which connects it to an SSH
   terminal: an agent's tmux session, a shell, or a harness's login. This component shows the overlay and the keys. *@
<div class="terminal-frame">
    <div class="terminal-host">
        <Xterm @ref="_xterm" Options="_options" Addons="_addons" Class="terminal-xterm" OnFirstRender="OnFirstRenderAsync" OnTitleChange="OnTitleChange" />
    </div>

    @* Files being pasted: top right over the terminal, clear of the toolbar and the keys. Blue while sending, green once
       stored (then it fades), red with the reason when it failed. *@
    @if (_uploads.Count > 0)
    {
        <div class="terminal-uploads" role="status" aria-live="polite">
            @foreach (var upload in _uploads)
            {
                <div class="terminal-upload terminal-upload-@upload.Phase" @key="upload.Id">
                    <div class="terminal-upload-row">
                        <MudIcon Icon="@(upload.Phase switch { "done" => Icons.Material.Rounded.CheckCircle, "error" => Icons.Material.Rounded.ErrorOutline, _ => Icons.Material.Rounded.Upload })" Size="Size.Small" />
                        <span class="terminal-upload-name">@upload.Name</span>
                        <span class="terminal-upload-size">@ByteCount.Text(upload.Size)</span>
                        @if (upload.Phase == "error")
                        { <button type="button" class="terminal-upload-close" aria-label="@($"Dismiss {upload.Name}")" @onclick="() => _uploads.Remove(upload)">✕</button> }
                    </div>
                    @if (upload.Phase == "error")
                    { <div class="terminal-upload-reason">@upload.Error</div> }
                    else
                    { <div class="terminal-upload-bar" aria-hidden="true"><div style="width: @((upload.Progress * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%"></div></div> }
                    <span class="visually-hidden">@(upload.Phase switch { "done" => $"Uploaded {upload.Name}", "error" => $"Couldn't upload {upload.Name}: {upload.Error}", "queued" => $"{upload.Name} is waiting to upload", _ => $"Uploading {upload.Name}: {upload.Progress:P0}" })</span>
                </div>
            }
        </div>
    }

    @if (_overlay is not null)
    {
        <div class="terminal-overlay">
            <div class="terminal-overlay-card">
                @if (_connecting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                }
                else
                {
                    <MudIcon Icon="@(_error ? Icons.Material.Rounded.ErrorOutline : Icons.Material.Rounded.LinkOff)" Color="@(_error ? Color.Error : Color.Default)" />
                }
                <MudText Typo="Typo.body2">@_overlay</MudText>
                @if (!_connecting)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="ReconnectAsync">Reconnect</MudButton>
                }
            </div>
        </div>
    }
</div>

@* Font controls are available to everyone. Input keys are only shown on writable phone/tablet terminals. *@
<div class="terminal-keys">
    <button type="button" class="terminal-key" aria-label="Select terminal text" title="Select text" @onclick="SelectTextAsync"><MudIcon Icon="@Icons.Material.Rounded.ContentCopy" Size="Size.Small" /></button>
@if (!ReadOnly)
{
    <span class="terminal-input-controls">
    @foreach (var (label, sequence, title) in Keys)
    {
        <button type="button" class="terminal-key" title="@title" aria-label="@title" @onclick="() => SendAsync(sequence)" @onclick:preventDefault="true">@label</button>
    }
    @if (AgentId is { } commandAgent && HarnessId is not null)
    {
        <QuickCommandMenu AgentId="commandAgent" HarnessId="@HarnessId" Disabled="@(_overlay is not null)" />
    }
    @* Opened in the browser (terminal.js), so the file picker runs in the tap itself: browsers only open it for a user action. *@
    <button type="button" class="terminal-key" data-dam-action="image" title="Send an image (screenshot, photo)" aria-label="Send an image">
        <MudIcon Icon="@Icons.Material.Rounded.AttachFile" Size="Size.Small" />
    </button>
    </span>
}
    <button type="button" class="terminal-key" @onclick="() => ChangeFontAsync(-1)" title="Decrease terminal font size" aria-label="Decrease terminal font size">A−</button>
    <button type="button" class="terminal-key" @onclick="() => ChangeFontAsync(1)" title="Increase terminal font size" aria-label="Increase terminal font size">A+</button>
    <button type="button" class="terminal-key" @onclick="() => ChangeFontAsync(0)" title="Reset terminal font size" aria-label="Reset terminal font size">Reset</button>
</div>

@code {
    // On-screen keys for phones and tablets, where these are hard or impossible to type.
    private static readonly (string Label, string Sequence, string Title)[] Keys =
    [
        ("Esc", "\u001b", "Escape"), ("Tab", "\t", "Tab"), ("^C", "\u0003", "Ctrl+C"),
        ("←", "\u001b[D", "Left"), ("↑", "\u001b[A", "Up"), ("↓", "\u001b[B", "Down"), ("→", "\u001b[C", "Right"),
        ("⇧←", "\u001b[1;2D", "Shift+Left (answer queued question)"),
        ("⇧⏎", "\u001b[13;2u", "New line (Shift+Enter)"), ("⏎", "\r", "Enter"),
    ];

    private readonly HashSet<string> _addons = ["addon-fit"];
    private readonly TerminalOptions _options = new()
    {
        CursorBlink = true,
        CursorStyle = CursorStyle.Bar,
        FontFamily = AppTheme.MonoFont,
        FontSize = 14,
        Scrollback = 10000,
        AllowProposedApi = true,
        MacOptionIsMeta = true,
        Theme = new Theme
        {
            Background = "#0a0d13",
            Foreground = "#d8dee9",
            Cursor = "#8b7dff",
            CursorAccent = "#0a0d13",
            SelectionBackground = "#8b7dff55",
            Black = "#1b2130", BrightBlack = "#4b5467",
            Red = "#f87171", BrightRed = "#fca5a5",
            Green = "#34d399", BrightGreen = "#6ee7b7",
            Yellow = "#fbbf24", BrightYellow = "#fcd34d",
            Blue = "#60a5fa", BrightBlue = "#93c5fd",
            Magenta = "#c084fc", BrightMagenta = "#d8b4fe",
            Cyan = "#2dd4bf", BrightCyan = "#5eead4",
            White = "#d8dee9", BrightWhite = "#f8fafc",
        },
    };

    private Xterm _xterm = default!;
    private sealed class Upload
    {
        public int Id { get; init; }
        public string Name { get; init; } = "";
        public long Size { get; init; }
        public string Phase { get; set; } = "queued";
        public double Progress { get; set; }
        public string? Error { get; set; }
    }
    private readonly List<Upload> _uploads = [];
    private bool _disposed;
    private int _autoReconnects;
    private DateTime _readyAt;
    // The Manager said it is restarting: keep saying so while connecting again, until it is back.
    private bool _restarting;
    private DotNetObjectReference<TerminalView>? _self;
    private string? _overlay = "Connecting...";
    private bool _connecting = true;
    private bool _error;

    /// <summary>Attach to this agent's tmux session.</summary>
    [Parameter]
    public Guid? AgentId { get; set; }

    /// <summary>Only watched (an agent shared read-only): nothing can be typed or pasted, and there is no phone keyboard.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    protected override void OnInitialized() => _options.DisableStdin = ReadOnly;

    [Parameter] public string? HarnessId { get; set; }

    /// <summary>Or open a plain shell on this Runner (or, with <see cref="Login"/>, a login on it).</summary>
    [Parameter]
    public Guid? RunnerId { get; set; }

    /// <summary>With <see cref="RunnerId"/>: log in to this harness's subscription; the Manager saves the account.</summary>
    [Parameter]
    public LoginTerminal? Login { get; set; }

    [Parameter]
    public EventCallback<string> TitleChanged { get; set; }

    [Parameter]
    public EventCallback Disconnected { get; set; }

    /// <summary>Raised once the terminal is attached and its <see cref="Tty"/> is known.</summary>
    [Parameter]
    public EventCallback Connected { get; set; }

    /// <summary>For logins: the account was saved (true) or the login's result couldn't be saved (false), with a message.</summary>
    [Parameter]
    public EventCallback<(bool Ok, string Message)> LoginFinished { get; set; }

    /// <summary>This terminal's tty on the Runner (e.g. /dev/pts/3): tells it apart from the agent's other viewers.</summary>
    public string? Tty { get; private set; }

    private Task ChangeFontAsync(int change) => JS.InvokeVoidAsync("damTerminal.changeFont", _xterm.Id, change).AsTask();

    public async Task SendAsync(string data)
    {
        // Through the browser, so the phone keyboard input knows the line changed.
        await JS.InvokeVoidAsync("damTerminal.sendKey", _xterm.Id, data);
    }

    public async Task ReconnectAsync()
    {
        await _xterm.Reset();
        await ConnectAsync();
    }

    private async Task OnFirstRenderAsync()
    {
        _self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("damTerminal.init", _xterm.Id, _self, AcceptsImages, ReadOnly);
        StateHasChanged();
        // Connecting to an agent makes this screen one of its viewers; a tab in the background waits until it is looked at.
        await JS.InvokeVoidAsync("damTerminal.whenVisible");
        await ConnectAsync();
    }

    /// <summary>Where pasted images go: the agent's or the shell's Runner (query string for the upload).</summary>
    // Images go to the Runner through the terminal's socket: agents and shells, not login terminals.
    private bool AcceptsImages => !ReadOnly && (AgentId is not null || (Login is null && RunnerId is not null));

    private async Task ConnectAsync()
    {
        _overlay = _restarting ? "The Manager is restarting. Connecting again..." : "Connecting...";
        _connecting = true;
        _error = false;
        Tty = null;
        StateHasChanged();
        await JS.InvokeVoidAsync("damTerminal.connect", _xterm.Id, SocketUrl());
    }

    private string SocketUrl()
    {
        var query = AgentId is { } agentId ? $"kind=agent&id={agentId}"
            : Login is { } login ? $"kind=login&runner={RunnerId}&harness={Uri.EscapeDataString(login.HarnessId)}&account={login.AccountId}&name={Uri.EscapeDataString(login.Name ?? "")}"
            : $"kind=shell&id={RunnerId}";
        return $"{TerminalSocket.Path.TrimStart('/')}?{query}";
    }

    [JSInvokable]
    public async Task OnSocketReady(string tty)
    {
        _readyAt = DateTime.UtcNow;
        _restarting = false;
        Tty = string.IsNullOrEmpty(tty) ? null : tty;
        _overlay = null;
        _connecting = false;
        StateHasChanged();
        await Connected.InvokeAsync();
    }

    [JSInvokable]
    public async Task OnSocketClosed(string? reason, string? message)
    {
        Tty = null;
        // An agent's terminal that just dropped (a phone that slept, a network blip) connects again by itself, once the
        // page is visible. Not when another screen took it, tmux detached it, or it can't be opened: that needs the user.
        if (DateTime.UtcNow - _readyAt > TimeSpan.FromSeconds(10))
        {
            _autoReconnects = 0;
        }

        if (AgentId is not null && reason is null or TerminalSocket.ClosedExited or TerminalSocket.ClosedRestarting && _readyAt != default && _autoReconnects < 3)
        {
            _autoReconnects++;
            _restarting |= reason == TerminalSocket.ClosedRestarting;
            _overlay = _restarting ? "The Manager is restarting. Connecting again..." : "Reconnecting...";
            _connecting = true;
            StateHasChanged();
            await Disconnected.InvokeAsync();
            await JS.InvokeVoidAsync("damTerminal.whenVisible");
            await Task.Delay(TimeSpan.FromSeconds(1));
            await ConnectAsync();
            return;
        }

        _connecting = false;
        _error = reason == TerminalSocket.ClosedError;
        _overlay = reason switch
        {
            TerminalSocket.ClosedError => message ?? "The terminal could not be opened.",
            TerminalSocket.ClosedRestarting => message ?? "The Manager is restarting.",
            TerminalSocket.ClosedKicked => "Another screen disconnected this one. The agent keeps running; reconnect to continue here.",
            TerminalSocket.ClosedDetached => "This screen was disconnected from the agent (tmux detached it). Reconnect to continue here.",
            _ when Login is not null => "Finished.",
            _ when AgentId is null => "The shell was closed.",
            _ => "Disconnected from the agent. It keeps running on the Runner.",
        };
        StateHasChanged();
        await Disconnected.InvokeAsync();
    }

    [JSInvokable]
    public Task OnLoginResult(bool ok, string message) => LoginFinished.InvokeAsync((ok, message));

    /// <summary>
    /// Progress of a file (an image, a log, …) pasted into the terminal, one per file: "queued", "sending" (with the
    /// fraction sent), "done" (stored on the Runner) or "error" (with why). Done fades after a moment; an error stays a while.
    /// </summary>
    [JSInvokable]
    public void OnUploadProgress(int id, string phase, string name, long size, double fraction, string? error)
    {
        var upload = _uploads.FirstOrDefault(u => u.Id == id);
        if (upload is null) _uploads.Add(upload = new Upload { Id = id, Name = name, Size = size });
        upload.Phase = phase;
        upload.Progress = Math.Clamp(fraction, 0, 1);
        upload.Error = error;
        if (phase is "done" or "error") _ = DismissAsync(upload, phase == "done" ? TimeSpan.FromSeconds(1.5) : TimeSpan.FromSeconds(10));
        StateHasChanged();
    }

    private async Task DismissAsync(Upload upload, TimeSpan after)
    {
        await Task.Delay(after);
        if (_disposed || !_uploads.Remove(upload)) return;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Text was copied from the terminal (terminal.js): "copied" (the number of characters). A program's copy (OSC 52) can
    /// also be "blocked" (the browser didn't allow it; Copy copies it in the tap) or "large"; the selection's, "failed".
    /// </summary>
    [JSInvokable]
    public void OnCopy(string result, int characters)
    {
        switch (result)
        {
            case "copied":
                Snackbar.Add(CopyText.Copied(characters), Severity.Success);
                break;
            case "blocked":
                Snackbar.Add($"The browser didn't allow copying {CopyText.Characters(characters)} from the terminal.", Severity.Warning, options =>
                {
                    options.Action = "Copy";
                    options.ActionColor = Color.Primary;
                    options.VisibleStateDuration = 15_000;
                    options.OnClick = _ => CopyPendingAsync();
                });
                break;
            case "large":
                Snackbar.Add("Not copied: the terminal copies up to 1 MB.", Severity.Warning);
                break;
            case "failed":
                Snackbar.Add("Could not copy: the browser didn't allow it.", Severity.Error);
                break;
        }
    }

    private async Task CopyPendingAsync()
    {
        try
        {
            var copied = await JS.InvokeAsync<int>("damTerminal.copyPending", _xterm.Id);
            if (copied > 0)
            {
                Snackbar.Add(CopyText.Copied(copied), Severity.Success);
            }
        }
        catch (JSException exception)
        {
            Snackbar.Add($"Could not copy: {exception.Message}", Severity.Error);
        }
    }

    private Task SelectTextAsync() => Dialogs.ShowAsync<TerminalTextDialog>("Select text",
        new DialogParameters<TerminalTextDialog> { { d => d.AgentId, AgentId }, { d => d.TerminalId, _xterm.Id } },
        new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });

    private Task OnTitleChange(string title) => TitleChanged.InvokeAsync(title);

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            await JS.InvokeVoidAsync("damTerminal.dispose", _xterm.Id);
        }
        catch (JSDisconnectedException)
        {
            // The page is gone.
        }

        _self?.Dispose();
    }
}
