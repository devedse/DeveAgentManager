@inherits LiveComponent
@inject IJSRuntime JS
@inject SignedInUser Me
<MudMenu PopoverClass="agent-attention-popover" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
    <ActivatorContent>
        <MudBadge Content="@_items.Count" Visible="@(_items.Count > 0)" Color="Color.Warning" Overlap="true">
            <MudIconButton Icon="@Icons.Material.Rounded.Notifications" Size="Size.Small" OnClick="@context.ToggleAsync" aria-label="@($"Agents needing attention: {_items.Count}")" />
        </MudBadge>
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Href="activity" Icon="@Icons.Material.Rounded.MonitorHeart">View all agent statuses</MudMenuItem>
        <MudDivider />
        <div class="notification-sounds" @onclick:stopPropagation="true">
            <div class="help-heading notification-sounds-heading">
                <span>Sound effects</span>
                <HelpTip Label="notification sounds"><p>Play a gentle sound when your agent or an agent shared with you finishes or reaches a usage limit, including a limit with automatic continuation. Each switch previews its sound when enabled. Saved for your account in this browser. Keep a Manager tab open and interact with it after opening to allow audio. Existing statuses do not play again on reload.</p></HelpTip>
            </div>
            @if (!_soundReady)
            {
                <MenuLoading Label="Loading sound preferences" />
            }
            else
            {
                <MudSwitch T="bool" Value="_sounds.Finished" ValueChanged='value => SetSoundAsync("finished", value)' Disabled="_soundBusy" Color="Color.Primary" Label="Finished" LabelPlacement="Placement.Start" Class="notification-sound-switch" />
                <MudSwitch T="bool" Value="_sounds.Limit" ValueChanged='value => SetSoundAsync("limit", value)' Disabled="_soundBusy" Color="Color.Primary" Label="Usage limit" LabelPlacement="Placement.Start" Class="notification-sound-switch" />
            }
        </div>
        <MudDivider />
        @if (!Loaded)
        {
            @if (LoadError is not null)
            {
                <MudMenuItem Icon="@Icons.Material.Rounded.Refresh" OnClick="RetryAsync" AutoClose="false">Couldn't load. Retry</MudMenuItem>
            }
            else
            {
                <MenuLoading Label="Loading notifications" />
            }
        }
        else if (_items.Count == 0)
        {
            <MudMenuItem Disabled="true">Nothing needs attention</MudMenuItem>
        }
        @foreach (var item in _items)
        {
            <div class="attention-row" @key="item.Token">
                <MudMenuItem Href="@($"agents/{item.AgentId}")">
                    <div class="attention-item">
                        <strong>@item.Name · @Label(item.Kind)</strong>
                        <span>@item.Reason</span>
                        <small>@item.RunnerName · @item.At.Humanize()</small>
                    </div>
                </MudMenuItem>
                <span @onclick:stopPropagation="true">
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" Disabled="@_dismissing.Contains(item.Token)"
                        OnClick="@(() => DismissAsync(item))" title="Dismiss notification" aria-label="@($"Dismiss {item.Name} notification")" />
                </span>
            </div>
        }
    </ChildContent>
</MudMenu>
@code {
    // Notifications and their sounds are for when you look elsewhere: keep them current in a hidden tab.
    protected override bool ReloadWhileHidden => true;

    private List<AgentAttentionDto> _items = [];
    private readonly HashSet<string> _dismissing = [];
    private async Task DismissAsync(AgentAttentionDto item)
    {
        if (!_dismissing.Add(item.Token)) return;
        try { await Api.DismissAttentionAsync(item.AgentId, item.Token); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _dismissing.Remove(item.Token); }
    }
    private readonly CancellationTokenSource _stop = new();
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); _ = TickAsync(); }
    private Guid _userId;
    private bool _soundReady;
    private bool _soundBusy;
    private SoundPreferences _sounds = new();
    public sealed class SoundPreferences
    {
        public bool Finished { get; set; }
        public bool Limit { get; set; }
    }
    private object[]? _soundStates;
    protected override async Task LoadAsync()
    {
        _userId = (await Me.GetAsync()).Id;
        _items = await Api.ListAttentionAsync();
        try
        {
            var agents = await Api.ListAgentsAsync();
            _soundStates = agents.Where(a => a.OwnerId == _userId || a.SharedWithMe).Select(a => (object)new
            {
                id = a.Id,
                limit = a.State == AgentState.Running && a.Activity?.Status == AgentActivityStatus.UsageLimited
                    ? $"{a.Activity.Since:O}:{a.Activity.Evidence}" : null,
                finished = a.State == AgentState.Running && a.Activity is
                    { Status: AgentActivityStatus.Ready, CurrentTurnCompleted: true, CompletedAt: not null }
                    ? a.Activity.CompletionSequence.ToString() : null
            }).ToArray();
        }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_userId == Guid.Empty) return;
        if (!_soundReady)
        {
            _sounds = await JS.InvokeAsync<SoundPreferences>("damNotificationSounds.init", _userId.ToString());
            _soundReady = true;
            StateHasChanged();
        }
        if (_soundStates is { } states)
        {
            _soundStates = null;
            await JS.InvokeVoidAsync("damNotificationSounds.observe", (object)states);
        }
    }
    private async Task SetSoundAsync(string kind, bool enabled)
    {
        if (_soundBusy) return;
        _soundBusy = true;
        try { _sounds = await JS.InvokeAsync<SoundPreferences>("damNotificationSounds.set", kind, enabled); }
        finally { _soundBusy = false; }
    }
    private async Task TickAsync()
    {
        try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15)); while (await timer.WaitForNextTickAsync(_stop.Token)) await ReloadAsync(); }
        catch (OperationCanceledException) { }
    }
    private static string Label(AgentAttentionKind kind) => kind switch
    {
        AgentAttentionKind.NeedsInput => "Needs input", AgentAttentionKind.QuestionWaiting => "Question waiting",
        AgentAttentionKind.UsageLimit => "Usage limit", AgentAttentionKind.UnexpectedExit => "Exited",
        AgentAttentionKind.Finished => "Finished", _ => "Unclear"
    };
    public override void Dispose() { _stop.Cancel(); base.Dispose(); }
}
