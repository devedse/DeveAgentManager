@inherits LiveComponent
<MudMenu PopoverClass="agent-attention-popover" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
    <ActivatorContent>
        <MudBadge Content="@_items.Count" Visible="@(_items.Count > 0)" Color="Color.Warning" Overlap="true">
            <MudIconButton Icon="@Icons.Material.Rounded.Notifications" Size="Size.Small" OnClick="@context.ToggleAsync" aria-label="@($"Agents needing attention: {_items.Count}")" />
        </MudBadge>
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Href="activity" Icon="@Icons.Material.Rounded.MonitorHeart">View all agent statuses</MudMenuItem>
        <MudDivider />
        @if (!Loaded)
        {
            @if (LoadError is not null)
            {
                <MudMenuItem Icon="@Icons.Material.Rounded.Refresh" OnClick="RetryAsync" AutoClose="false">Couldn't load. Retry</MudMenuItem>
            }
            else
            {
                <MenuLoading Label="Loading notifications" />
            }
        }
        else if (_items.Count == 0)
        {
            <MudMenuItem Disabled="true">Nothing needs attention</MudMenuItem>
        }
        @foreach (var item in _items)
        {
            <div class="attention-row" @key="item.Token">
                <MudMenuItem Href="@($"agents/{item.AgentId}")">
                    <div class="attention-item">
                        <strong>@item.Name · @Label(item.Kind)</strong>
                        <span>@item.Reason</span>
                        <small>@item.RunnerName · @item.At.Humanize()</small>
                    </div>
                </MudMenuItem>
                <span @onclick:stopPropagation="true">
                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" Disabled="@_dismissing.Contains(item.Token)"
                        OnClick="@(() => DismissAsync(item))" title="Dismiss notification" aria-label="@($"Dismiss {item.Name} notification")" />
                </span>
            </div>
        }
    </ChildContent>
</MudMenu>
@code {
    private List<AgentAttentionDto> _items = [];
    private readonly HashSet<string> _dismissing = [];
    private async Task DismissAsync(AgentAttentionDto item)
    {
        if (!_dismissing.Add(item.Token)) return;
        try { await Api.DismissAttentionAsync(item.AgentId, item.Token); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _dismissing.Remove(item.Token); }
    }
    private readonly CancellationTokenSource _stop = new();
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); _ = TickAsync(); }
    protected override async Task LoadAsync() => _items = await Api.ListAttentionAsync();
    private async Task TickAsync()
    {
        try { using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15)); while (await timer.WaitForNextTickAsync(_stop.Token)) await ReloadAsync(); }
        catch (OperationCanceledException) { }
    }
    private static string Label(AgentAttentionKind kind) => kind switch
    {
        AgentAttentionKind.NeedsInput => "Needs input", AgentAttentionKind.QuestionWaiting => "Question waiting",
        AgentAttentionKind.UsageLimit => "Usage limit", AgentAttentionKind.UnexpectedExit => "Exited",
        AgentAttentionKind.Finished => "Finished", _ => "Unclear"
    };
    public override void Dispose() { _stop.Cancel(); base.Dispose(); }
}
