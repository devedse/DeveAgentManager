@inject ManagerApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject SignedInUser Me

@if (Agents.Count == 0)
{
    <EmptyState Icon="@Icons.Material.Rounded.SmartToy" Title="No agents" Text="@EmptyText">
        @EmptyContent
    </EmptyState>
}
else
{
    <div class="agent-table">
        @foreach (var agent in Agents.ByLastReply())
        {
            var busy = _busy.Contains(agent.Id) || agent.State == AgentState.Moving;
            var write = agent.Access >= AgentAccess.Write;
            @* People who manage the Runner see other people's agents there, but can't open them. *@
            <div class="agent-row">
                <a class="agent-row-main" href="@(agent.Access >= AgentAccess.Read ? $"agents/{agent.Id}" : null)">
                    <AgentAvatar Agent="agent" />
                    <div class="list-main">
                        <div class="list-title">
                            @agent.Name
                            @if (ShowOwner || agent.SharedWithMe || agent.Access != AgentAccess.Owner)
                            {
                                <span class="account-badge" title="@ShareText(agent)">@agent.OwnerName</span>
                            }
                        </div>
                        <div class="list-subtitle">
                            @if (ShowRunner)
                            {
                                <span>@agent.RunnerName · </span>
                            }
                            <span class="mono">@(agent.RepositoryUrl ?? agent.WorkingDirectory)</span>
                        </div>
                        <div class="list-subtitle agent-account">
                            @if (agent.State is AgentState.Running or AgentState.Starting)
                            {
                                <span>Account: <AccountIdentity Username="@agent.RunningAccountUsername" Name="@(agent.RunningAccountName ?? "Unknown")" /></span>
                            }
                            else
                            {
                                <span>Account on start: <AccountIdentity Username="@agent.AccountUsername" Name="@(agent.AccountName ?? "Default")" /></span>
                            }
                        </div>
                        @if (agent.MovePending && agent.MoveDetails?.Progress is { } progress)
                        {
                            <AgentMoveProgress Progress="progress" Compact="true" />
                        }
                    </div>
                </a>
                <div class="agent-row-state">
                    <AgentStatus Agent="agent" />
                    <span class="list-time" title="@(agent.LastAssistantMessageAt is { } messageAt ? $"Last agent message: {messageAt.ToLocalTime():yyyy-MM-dd HH:mm:ss}" : "No agent message has been recorded yet")">@(agent.LastAssistantMessageAt is { } last ? $"Last reply {last.Humanize()}" : "No reply yet")</span>
                </div>
                <div class="agent-row-actions">
                    @if (busy)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    }
                    else if (agent.Access < AgentAccess.Read)
                    {
                        @* Only listed: nothing to do with it. *@
                    }
                    else if (!write)
                    {
                        <MudTooltip Text="Watch (read-only)">
                            <MudIconButton Href="@($"agents/{agent.Id}")" Icon="@Icons.Material.Rounded.Visibility" Color="Color.Primary" Size="Size.Small" />
                        </MudTooltip>
                    }
                    else if (agent.State is AgentState.Running or AgentState.Starting)
                    {
                        <MudTooltip Text="Open terminal">
                            <MudIconButton Href="@($"agents/{agent.Id}")" Icon="@Icons.Material.Rounded.Terminal" Color="Color.Primary" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Stop">
                            <MudIconButton Icon="@Icons.Material.Rounded.Stop" Size="Size.Small" OnClick="() => StopAsync(agent)" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="@(agent.State == AgentState.Exited ? "Restart (resumes the conversation)" : "Start (resumes the conversation)")">
                            <MudIconButton Icon="@Icons.Material.Rounded.PlayArrow" Color="Color.Success" Size="Size.Small" Disabled="agent.RunnerState != RunnerState.Ready"
                                           OnClick="@(() => StartAsync(agent, false))" />
                        </MudTooltip>
                    }
                    @if (agent.Access >= AgentAccess.Read)
                    {
                        <MudMenu Icon="@Icons.Material.Rounded.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                            <MudMenuItem Icon="@(write ? Icons.Material.Rounded.Terminal : Icons.Material.Rounded.Visibility)" Href="@($"agents/{agent.Id}")">@(write ? "Open" : "Watch")</MudMenuItem>
                            @if (write)
                            {
                                @if (agent.RunnerToolIds.Contains("vscode"))
                                {
                                    <MudMenuItem Icon="@Icons.Material.Rounded.Code" Href="@($"agents/{agent.Id}/vscode")">Open in VS Code</MudMenuItem>
                                }
                                <MudMenuItem Icon="@Icons.Material.Rounded.RestartAlt" Disabled="agent.RunnerState != RunnerState.Ready" OnClick="@(() => StartAsync(agent, true))">Restart</MudMenuItem>
                                <MudMenuItem Icon="@Icons.Material.Rounded.Image" Disabled="agent.RunnerState != RunnerState.Ready" OnClick="() => PickIconAsync(agent)">Icon...</MudMenuItem>
                            }
                            @* Owners share it; others see who else has it and can leave. *@
                            <MudMenuItem Icon="@(agent.Access == AgentAccess.Owner ? Icons.Material.Rounded.Share : Icons.Material.Rounded.PeopleAlt)" OnClick="() => ShareAsync(agent)">
                                @(agent.Access == AgentAccess.Owner ? "Share..." : "Sharing...")
                            </MudMenuItem>
                            @if (agent.Access == AgentAccess.Owner)
                            {
                                @if (agent.MovePending)
                                {
                                    <MudMenuItem Icon="@Icons.Material.Rounded.Restore" Disabled="agent.State == AgentState.Moving" OnClick="() => RecoverMoveAsync(agent)">Recover move / finish cleanup</MudMenuItem>
                                }
                                else
                                {
                                    <MudMenuItem Icon="@Icons.Material.Rounded.DriveFileMove" Disabled="agent.RunnerState != RunnerState.Ready" OnClick="() => MoveAgentDialog.ShowAsync(Dialogs, agent)">Move to another runner…</MudMenuItem>
                                }
                                <MudMenuItem Icon="@Icons.Material.Rounded.Delete" IconColor="Color.Error" Disabled="agent.MovePending" OnClick="() => DeleteAsync(agent)">Delete</MudMenuItem>
                            }
                        </MudMenu>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private readonly HashSet<Guid> _busy = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<AgentDto> Agents { get; set; } = [];

    [Parameter]
    public bool ShowRunner { get; set; }

    [Parameter]
    public bool ShowOwner { get; set; }

    [Parameter]
    public string EmptyText { get; set; } = "Start an agent to work on a repository.";

    [Parameter]
    public RenderFragment? EmptyContent { get; set; }

    /// <summary>Whose agent it is and what the signed-in user may do with it.</summary>
    public static string ShareText(AgentDto agent) => agent.Access switch
    {
        AgentAccess.Owner => $"Agent owned by {agent.OwnerName}",
        AgentAccess.Write => $"{agent.OwnerName}'s agent, shared with you read-write (it runs with the login it is switched to)",
        AgentAccess.Read => $"{agent.OwnerName}'s agent, shared with you read-only",
        _ => $"{agent.OwnerName}'s agent, on a Runner you manage",
    };

    private async Task StartAsync(AgentDto agent, bool restart)
    {
        if (restart && agent.State is AgentState.Running or AgentState.Starting && !await ConfirmRestartAsync(Dialogs, agent.Name))
        {
            return;
        }

        await RunAsync(agent, () => Api.StartAgentAsync(agent.Id, restart), $"{(restart ? "Restarted" : "Started")} '{agent.Name}'");
    }

    /// <summary>Restarting stops a running harness, and with it any tool call it is in the middle of.</summary>
    public static async Task<bool> ConfirmRestartAsync(IDialogService dialogs, string agentName) =>
        await dialogs.ShowMessageBoxAsync(
            $"Restart '{agentName}'?",
            "The harness is stopped (it gets 10 seconds to exit) and started again. Anything it is doing right now, like a running command, is cancelled. The conversation is resumed.",
            yesText: "Restart", cancelText: "Cancel") == true;

    private Task PickIconAsync(AgentDto agent) =>
        Dialogs.ShowAsync<AgentIconDialog>("Icon", new DialogParameters<AgentIconDialog> { { d => d.Agent, agent } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

    private async Task ShareAsync(AgentDto agent) => await ShareDialog.ShowAsync(Dialogs, agent, await Me.GetAsync());

    private Task StopAsync(AgentDto agent) => RunAsync(agent, () => Api.StopAgentAsync(agent.Id), $"Stopped '{agent.Name}'");

    private Task RecoverMoveAsync(AgentDto agent) => RunAsync(agent, () => Api.RecoverAgentMoveAsync(agent.Id), "Move recovery queued");

    private async Task RunAsync(AgentDto agent, Func<Task> action, string success)
    {
        _busy.Add(agent.Id);
        try
        {
            await action();
            Snackbar.Add(success, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy.Remove(agent.Id);
        }
    }

    private async Task DeleteAsync(AgentDto agent)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            $"Delete agent '{agent.Name}'?",
            (MarkupString)$"The harness is stopped and the agent is removed from the Manager. Its folder <code>{System.Net.WebUtility.HtmlEncode(agent.WorkingDirectory)}</code> and the conversation files stay on the Runner.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            await RunAsync(agent, () => Api.DeleteAgentAsync(agent.Id), $"Deleted '{agent.Name}'");
        }
    }
}
