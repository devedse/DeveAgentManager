<div class="page-header">
    <div class="page-header-text">
        @if (BackHref is not null)
        {
            <MudIconButton Href="@BackHref" Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" Class="page-back" aria-label="Back" />
        }
        <div class="page-header-titles">
            @if (Overline is not null)
            {
                <MudText Typo="Typo.overline" Class="mud-text-secondary">@Overline</MudText>
            }
            <div class="page-title-row">
                <MudText Typo="Typo.h4" Class="page-title">@Title</MudText>
                @TitleContent
            </div>
            @if (Subtitle is not null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary page-subtitle">@Subtitle</MudText>
            }
        </div>
    </div>
    @if (Actions is not null)
    {
        <div class="page-header-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Overline { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string? BackHref { get; set; }

    [Parameter]
    public RenderFragment? TitleContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
