@inject ManagerApi Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

@* The project's workspaces, each with ▶/■, and its saved conversations. Opening never starts or stops anything. *@
<MudMenu @ref="_menu" PopoverClass="workspace-menu-popover" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true" @bind-Open="_open" @bind-Open:after="LoadAsync" Class="@($"workspace-picker terminal-name {(Agent.IsClone ? "workspace-picker-child" : "")}")">
    <ActivatorContent>
        <MudButton OnClick="@context.ToggleAsync" EndIcon="@Icons.Material.Rounded.ExpandMore" Class="workspace-picker-button" aria-label="Choose workspace">
            <span class="workspace-picker-project">@WorkspaceGroups.ProjectName(Agent)</span><span class="workspace-picker-separator"> · </span><span class="workspace-picker-current">@WorkspaceGroups.WorkspaceName(Agent)</span>
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        <div class="workspace-menu-heading help-heading">Workspaces <HelpTip Label="Workspaces"><p>Each workspace is its own folder with its own agent: Main, or a clone of the repository next to it. Several can run at the same time.</p><p>Opening a workspace never starts or stops anything. Use ▶ and ■ for that. A workspace runs one conversation at a time.</p></HelpTip></div>
        @if (_error is not null) { <MudMenuItem OnClick="RetryAsync" AutoClose="false" title="@_error">Couldn't load. Retry</MudMenuItem> }
        else if (!_loaded) { <MenuLoading Label="Loading workspaces" /> }
        else
        {
            @foreach (var agent in _agents.Where(a => !WorkspaceGroups.QuietStopped(a)).ByLastReply()) { @Row(agent) }
            @if (_agents.Any(WorkspaceGroups.QuietStopped))
            {
                <MudMenuItem OnClick="() => _showStopped = !_showStopped" AutoClose="false" Icon="@(_showStopped ? Icons.Material.Rounded.ExpandLess : Icons.Material.Rounded.ExpandMore)">Stopped (@_agents.Count(WorkspaceGroups.QuietStopped))</MudMenuItem>
                @if (_showStopped) { @foreach (var agent in _agents.Where(WorkspaceGroups.QuietStopped).ByLastReply()) { @Row(agent) } }
            }
            @if (Agent.Access == AgentAccess.Owner && Agent.CanUseRunner)
            { <MudMenuItem Icon="@Icons.Material.Rounded.Add" Disabled="Agent.MovePending" OnClick="NewWorkspaceAsync">New workspace…</MudMenuItem> }
            <MudDivider />
            <div class="workspace-menu-heading help-heading">Conversations <HelpTip Label="Conversations"><p>The project's saved conversations, newest first. Choose one to resume it in this workspace, which saves and stops the conversation running here, or in a new workspace next to the others.</p><p>Active conversations show as workspaces above.</p></HelpTip></div>
            @if (Agent.Access >= AgentAccess.Write)
            { <MudMenuItem Icon="@Icons.Material.Rounded.Add" Disabled="Agent.MovePending" OnClick="NewConversationAsync">New conversation here…</MudMenuItem> }
            @foreach (var session in Saved.Take(5))
            {
                <MudMenuItem Icon="@Icons.Material.Rounded.Forum" OnClick="() => ChooseAsync(session)">
                    <span class="workspace-menu-title">@session.Title</span>
                    <small class="workspace-menu-where">@WorkspaceGroups.LastRanIn(session, _agents) · @session.UpdatedAt.Humanize()</small>
                </MudMenuItem>
            }
            <MudMenuItem Href="@($"projects/{WorkspaceGroups.ProjectKey(Agent)}")" Icon="@Icons.Material.Rounded.FolderOpen">All workspaces and conversations</MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
    /// <summary>This workspace's agent or conversation changed: reconnect its terminal.</summary>
    [Parameter] public EventCallback Changed { get; set; }
    private MudMenu? _menu;
    private bool _open, _loaded, _showStopped;
    private string? _error;
    private IReadOnlyList<AgentDto> _agents = [];
    private IReadOnlyList<SessionDto> _sessions = [];
    private Dictionary<Guid, string?> _branches = [];
    private readonly HashSet<Guid> _busy = [];

    private IEnumerable<SessionDto> Saved => _sessions.Where(s => s.AgentId is null).OrderByDescending(s => s.UpdatedAt);

    private RenderFragment Row(AgentDto agent) => @<div class="workspace-menu-entry" @key="agent.Id">
        <MudMenuItem Href="@($"agents/{agent.Id}")" Icon="@(agent.Id == Agent.Id ? Icons.Material.Rounded.Check : Icons.Material.Rounded.Terminal)">
            <div class="workspace-menu-row"><span class="workspace-menu-title">@WorkspaceGroups.WorkspaceName(agent)</span><StatusPill Style="StateStyles.For(agent)" /></div>
            <small class="workspace-menu-where">@string.Join(" · ", new[] { Branch(agent), ConversationTitle(agent) }.Where(part => !string.IsNullOrEmpty(part)))</small>
        </MudMenuItem>
        @if (agent.Access >= AgentAccess.Write)
        {
            @if (WorkspaceGroups.Running(agent))
            { <MudIconButton Icon="@Icons.Material.Rounded.Stop" Size="Size.Small" aria-label="@($"Stop {WorkspaceGroups.WorkspaceName(agent)}")" title="Stop" Disabled="@(_busy.Contains(agent.Id) || agent.MovePending)" OnClick="() => RunAsync(agent, () => Api.StopAgentAsync(agent.Id))" /> }
            else
            { <MudIconButton Icon="@Icons.Material.Rounded.PlayArrow" Color="Color.Success" Size="Size.Small" aria-label="@($"Start {WorkspaceGroups.WorkspaceName(agent)}")" title="Start" Disabled="@(_busy.Contains(agent.Id) || agent.MovePending || agent.RunnerState != RunnerState.Ready)" OnClick="() => RunAsync(agent, () => Api.StartAgentAsync(agent.Id))" /> }
        }
    </div>;

    /// <summary>What a workspace is working on: its conversation's title.</summary>
    private string? ConversationTitle(AgentDto agent) => _sessions.FirstOrDefault(s => s.AgentId == agent.Id)?.Title;
    private string? Branch(AgentDto agent) => _branches.TryGetValue(agent.Id, out var branch) ? branch : agent.RepositoryBranch;

    private Task LoadAsync() => _open ? LoadCoreAsync() : Task.CompletedTask;
    private Task RetryAsync() { _error = null; return LoadCoreAsync(); }

    // Reopening or ▶/■ refreshes in place: the entries on screen stay until the new ones arrive.
    private async Task LoadCoreAsync()
    {
        if (!_loaded) _error = null;
        try
        {
            var agents = Api.ListAgentsAsync();
            var sessions = Api.ListSessionsAsync();
            var key = WorkspaceGroups.ProjectKey(Agent);
            _agents = (await agents).Where(a => a.Access >= AgentAccess.Read && WorkspaceGroups.ProjectKey(a) == key).ToList();
            _sessions = WorkspaceGroups.InProject(await sessions, key, _agents).ToList();
            _showStopped |= WorkspaceGroups.QuietStopped(Agent);
            _loaded = true;
            _ = RefreshBranchesAsync();
        }
        catch (ApiException ex) when (!_loaded) { _error = ex.Message; }
        catch (HttpRequestException) when (!_loaded) { _error = LoadingSection.Unreachable; }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { Snackbar.Add(ex is ApiException ? ex.Message : LoadingSection.Unreachable, Severity.Warning); }
    }

    // An agent may have switched branches since it started; the stored branch shows until this returns.
    private async Task RefreshBranchesAsync()
    {
        try { _branches = await Api.RefreshWorkspaceBranchesAsync(Agent.Id); await InvokeAsync(StateHasChanged); }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { }
    }

    private async Task RunAsync(AgentDto agent, Func<Task> action)
    {
        _busy.Add(agent.Id);
        try
        {
            await action();
            if (agent.Id == Agent.Id) await Changed.InvokeAsync();
            await LoadCoreAsync();
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        catch (HttpRequestException) { Snackbar.Add(LoadingSection.Unreachable, Severity.Error); }
        finally { _busy.Remove(agent.Id); }
    }

    private async Task CloseAsync() { if (_menu is not null) await _menu.CloseAllMenusAsync(); }

    private async Task NewWorkspaceAsync() { await CloseAsync(); await NewWorkspaceDialog.ShowAsync(Dialogs, Agent); }

    private async Task NewConversationAsync()
    {
        await CloseAsync();
        if (await NewConversationDialog.ShowAsync(Dialogs, Agent)) await Changed.InvokeAsync();
    }

    private async Task ChooseAsync(SessionDto session)
    {
        await CloseAsync();
        if (await ConversationChooserDialog.ShowAsync(Dialogs, session, Agent, _agents, ConversationTitle(Agent)) == ConversationChooserDialog.ResumedHere) await Changed.InvokeAsync();
    }
}
