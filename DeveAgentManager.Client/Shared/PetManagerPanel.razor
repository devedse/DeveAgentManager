@using DeveAgentManager.Contracts.Pets
@inject ManagerApi Api
@inject PetClient Pets
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<LoadingSection Loaded="_loaded" Error="@_error" Retry="Load" Label="Loading Damagochi settings">
    <Placeholder><SkeletonForm Fields="4" /></Placeholder>
    <ChildContent>
        <div class="settings-section">
            <div class="help-heading"><MudText Typo="Typo.subtitle1">Damagochi</MudText>
                <HelpTip Label="Damagochi settings"><p>Enable the Damagochi module for the Portal. Turning it off preserves Damagochi and individual switches. The default applies only to accounts created afterward.</p><p>The actions for everyone change all existing account switches. People can turn their Damagochi back on in My settings while the module is enabled.</p></HelpTip></div>
            <MudSwitch T="bool" @bind-Value="_enabled" Label="Enable Damagochi" Color="Color.Primary" />
            <MudSwitch T="bool" @bind-Value="_default" Label="Enable Damagochi for new users by default" Color="Color.Primary" />
            <div class="settings-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveOptions" Disabled="_busy">Save Damagochi settings</MudButton></div>
            <div class="settings-actions">
                <MudButton Variant="Variant.Outlined" OnClick="() => Bulk(true)" Disabled="_busy">Enable Damagochi for everyone now</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="() => Bulk(false)" Disabled="_busy">Disable Damagochi for everyone now</MudButton>
            </div>
        </div>
        <div class="settings-section">
            <div class="help-heading"><MudText Typo="Typo.subtitle1">People’s Damagochi</MudText>
                <HelpTip Label="People’s Damagochi"><p>Managers can change species and names directly while preserving progress. Choose Unchosen egg to clear the current Damagochi. Set a level or an exact Damagochi lifetime token count. Account usage is separate; changing it requires explicitly selecting the override below. All administrator changes are audited.</p></HelpTip></div>
            <MudTextField @bind-Value="_search" Label="Find a person" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudSelect T="Guid?" Value="_selected" ValueChanged="Select" Label="Person" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var person in _people.Where(p => (p.DisplayName + " " + p.Username).Contains(_search, StringComparison.OrdinalIgnoreCase)))
                { <MudSelectItem T="Guid?" Value="@((Guid?)person.UserId)">@person.DisplayName (@person.Username)</MudSelectItem> }
            </MudSelect>
            @if (_selected is not null)
            {
                <MudSwitch T="bool" @bind-Value="_petEnabled" Label="Damagochi enabled" Color="Color.Primary" />
                <div class="form-row">
                    <MudTextField @bind-Value="_name" Label="Damagochi name" MaxLength="40" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudSelect T="string" @bind-Value="_species" Label="Damagochi type" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@(string.Empty)">Unchosen egg</MudSelectItem>
                        @foreach (var pet in _catalog) { <MudSelectItem Value="@pet.Id">@pet.Name</MudSelectItem> }
                    </MudSelect>
                </div>
                <div class="form-row">
                    @if (_exactTokens) { <MudNumericField T="long" @bind-Value="_petTokens" Min="0" Label="Damagochi tokens" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
                    else { <MudNumericField T="int" @bind-Value="_level" Min="1" Max="1000" Label="Level" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
                    <MudNumericField T="int" @bind-Value="_happiness" Min="0" Max="100" Label="Happiness" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
                <MudSwitch T="bool" @bind-Value="_exactTokens" Label="Set exact Damagochi tokens instead of level" Color="Color.Primary" />
                <div class="account-usage">
                    <div class="help-heading"><MudText Typo="Typo.subtitle2">Account usage</MudText><HelpTip Label="Account usage override"><p>This account total is independent of the Damagochi. Leave the override off to preserve live usage when saving Damagochi settings. An override replaces the recorded account total with the value entered.</p></HelpTip></div>
                    <MudSwitch T="bool" @bind-Value="_editAccountTokens" Label="Override account tokens" Color="Color.Primary" />
                    @if (_editAccountTokens) { <MudNumericField T="long" @bind-Value="_lifetimeTokens" Min="0" Label="Account tokens" Variant="Variant.Outlined" Margin="Margin.Dense" /> }
                </div>
                <div class="settings-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePerson" Disabled="_busy">Save person’s settings</MudButton></div>
            }
        </div>
    </ChildContent>
</LoadingSection>
@code {
    private bool _loaded, _busy, _enabled, _default, _petEnabled, _exactTokens, _editAccountTokens;
    private string? _error;
    private string _search = "", _name = "", _species = "";
    private long _petTokens, _lifetimeTokens;
    private int _level = 1, _happiness = 70;
    private Guid? _selected;
    private List<PetPersonDto> _people = [];
    private IReadOnlyList<PetDefinition> _catalog = [];
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() {
        _error = null;
        try { var options = await Api.PetOptionsAsync(); _people = await Api.PetPeopleAsync(); _catalog = (await Api.MyPetAsync()).Catalog; _enabled = options.Enabled; _default = options.DefaultForNewUsers; _loaded = true; }
        catch (Exception ex) when (ex is ApiException or HttpRequestException) { _error = ex is ApiException ? ex.Message : LoadingSection.Unreachable; }
    }
    private void Select(Guid? id) { _selected = id; if (_people.FirstOrDefault(p => p.UserId == id)?.Pet is { } p) { _name = p.Name; _species = p.Species; _petEnabled = p.Enabled; _level = Math.Max(1, p.Level); _happiness = p.Happiness; _petTokens = p.Experience; _lifetimeTokens = p.LifetimeTokens; _exactTokens = false; _editAccountTokens = false; } }
    private async Task Run(Func<Task> work) { _busy = true; try { await work(); await Pets.ReloadAsync(); Snackbar.Add("Damagochi saved.", Severity.Success); } catch (Exception ex) when (ex is ApiException or HttpRequestException) { Snackbar.Add(ex.Message, Severity.Error); } finally { _busy = false; } }
    private Task SaveOptions() => Run(async () => { await Api.SavePetOptionsAsync(new(_enabled, _default)); });
    private Task SavePerson() => Run(async () => { await Api.AdjustPetAsync(_selected!.Value, new(_petEnabled, _name, _species, _level, _happiness, _exactTokens ? _petTokens : null, _editAccountTokens ? _lifetimeTokens : null)); await Load(); Select(_selected); });
    private async Task Bulk(bool enabled) {
        var verb = enabled ? "Enable" : "Disable";
        if (await Dialogs.ShowMessageBoxAsync($"{verb} everyone’s Damagochi?", $"This changes every existing user’s Damagochi switch. Individual progress is preserved.", yesText: verb, cancelText: "Cancel") == true)
            await Run(async () => { await Api.SetAllPetsAsync(enabled); await Load(); });
    }
}
