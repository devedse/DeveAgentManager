@* Cards shaped like a .card-grid of Runner cards (a title row and a few facts), for card grids that are loading. *@
<div class="card-grid" aria-hidden="true">
    @for (var i = 0; i < Count; i++)
    {
        <div class="runner-card skeleton-card">
            <div class="runner-card-header">
                <span class="skeleton skeleton-avatar"></span>
                <div class="runner-card-titles">
                    <span class="skeleton skeleton-line" style="width:55%"></span>
                    <span class="skeleton skeleton-line skeleton-line-short"></span>
                </div>
            </div>
            @for (var line = 0; line < Lines; line++)
            {
                <span class="skeleton skeleton-line" style="@($"width:{60 + (line * 17 + i * 11) % 35}%")"></span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Count { get; set; } = 3;
    [Parameter] public int Lines { get; set; } = 3;
}
