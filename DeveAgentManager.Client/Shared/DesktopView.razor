@implements IAsyncDisposable
@inject IJSRuntime JS
<div class="desktop-view-actions">
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="RefreshAsync">Refresh</MudButton>
    <MudButton Variant="@(_live ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" StartIcon="@(_live ? Icons.Material.Rounded.Pause : Icons.Material.Rounded.PlayArrow)" OnClick="ToggleLiveAsync">@(_live ? "Pause live" : "Live")</MudButton>
    <MudSelect T="int" Value="_seconds" ValueChanged="IntervalChangedAsync" Label="Refresh interval" Margin="Margin.Dense" Variant="Variant.Outlined" Class="desktop-interval">
        <MudSelectItem Value="2">2 seconds</MudSelectItem><MudSelectItem Value="5">5 seconds</MudSelectItem>
    </MudSelect>
</div>
@if (_error is not null) { <MudAlert Severity="Severity.Warning" Class="mb-3">@_error</MudAlert> }
<div class="desktop-frame" @ref="_host"><img alt="Current runner desktop" /></div>
<MudText Typo="Typo.caption" Class="mud-text-secondary">@(_timestamp is null ? "Capturing desktop…" : $"Captured at {_timestamp}")@(_hidden ? " · paused while hidden" : _error is not null ? " · last successful frame" : _live ? " · live" : " · snapshot")</MudText>
@code {
    [Parameter] public Guid RunnerId { get; set; }
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DesktopView>? _self;
    private string? _timestamp, _error;
    private bool _live, _hidden;
    private int _seconds = 2;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/desktop-view.js");
        await _module.InvokeVoidAsync("start", _host, _self, $"api/runners/{RunnerId}/desktop/frame");
    }
    [JSInvokable] public Task DesktopFrameUpdated(string? timestamp, string? error, bool hidden) => InvokeAsync(() => { _timestamp = timestamp; _error = error; _hidden = hidden; StateHasChanged(); });
    private async Task RefreshAsync() { if (_module is not null) await _module.InvokeVoidAsync("refresh", _host); }
    private async Task ToggleLiveAsync() { _live = !_live; await UpdateLiveAsync(); }
    private async Task IntervalChangedAsync(int seconds) { _seconds = seconds; await UpdateLiveAsync(); }
    private async Task UpdateLiveAsync() { if (_module is not null) await _module.InvokeVoidAsync("setLive", _host, _live, _seconds); }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            try { await _module.InvokeVoidAsync("stop", _host); await _module.DisposeAsync(); }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
        _self?.Dispose();
    }
}
