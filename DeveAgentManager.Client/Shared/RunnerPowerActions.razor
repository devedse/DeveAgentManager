@inject ManagerApi Api
@inject ISnackbar Snackbar

@* Start or Stop, Restart and Update all for a Runner, each held for 3 seconds to confirm (HoldButton), with the same
   explanations on the Runners page's cards and the Runner page's header. Only for people who manage the Runner;
   starting, stopping and restarting only where the provider can power the machine (not existing machines). *@
@if (Runner.Access >= RunnerAccess.Manage)
{
    @if (Provider?.Capabilities.CanStartStop == true)
    {
        @if (Runner.State is RunnerState.Stopped or RunnerState.Error)
        {
            <HoldButton Text="Start" ActiveText="Starting" Icon="@Icons.Material.Rounded.PlayArrow" Color="Color.Success" Variant="Variant" Size="Size"
                        Disabled="Busy" Help="Starts the VM and connects to it. Agents stay stopped until you start them."
                        OnConfirmed="() => RunAsync(() => Api.StartRunnerAsync(Runner.Id))" />
        }
        else
        {
            <HoldButton Text="Stop" ActiveText="Stopping" Icon="@Icons.Material.Rounded.Stop" Variant="Variant" Size="Size" Disabled="!Ready"
                        Help="@StopHelp"
                        OnConfirmed="() => RunAsync(() => Api.StopRunnerAsync(Runner.Id))" />
        }
        <HoldButton Text="Restart" ActiveText="Restarting" Icon="@Icons.Material.Rounded.RestartAlt" Variant="Variant" Size="Size" Disabled="!Ready"
                    Help="@string.Join(' ', RestartNotes.Append(RestartHelp))" HelpContent="RestartDetails"
                    OnConfirmed="() => RunAsync(() => Api.RestartRunnerAsync(Runner.Id))">
            <Adornment>
                @if (Runner.Updates?.RestartPending == true)
                {
                    @* Help names the reason for screen readers. *@
                    <span class="runner-restart-badge @(Ready ? "" : "updates-stale")" aria-hidden="true"><span class="runner-restart-count">1</span></span>
                }
            </Adornment>
        </HoldButton>
    }
    <HoldButton Text="Update all" ActiveText="Updating" Icon="@Icons.Material.Rounded.SystemUpdateAlt" Variant="Variant" Size="Size"
                Disabled="@(Busy || Runner.State == RunnerState.Stopped)" Class="@UpdateClass"
                Help="@UpdateHelp"
                OnConfirmed="() => RunAsync(() => Api.RerunSetupAsync(Runner.Id))">
        <Adornment><RunnerUpdateBadges Runner="Runner" ShowRestart="!CanRestart" /></Adornment>
        <HelpContent>
            <p>@UpdateActionHelp</p>
            <RunnerUpdateDetails Updates="Runner.Updates" Active="@(Runner.State == RunnerState.Ready)" ShowRestart="!CanRestart" />
        </HelpContent>
    </HoldButton>
}

@code {
    [Parameter, EditorRequired] public RunnerDto Runner { get; set; } = default!;
    [Parameter] public ProviderDto? Provider { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Size Size { get; set; } = Size.Medium;
    /// <summary>On the Update all button, e.g. to push it to the end of a row.</summary>
    [Parameter] public string? UpdateClass { get; set; }
    /// <summary>After an operation was started, e.g. to show the setup log.</summary>
    [Parameter] public EventCallback Started { get; set; }

    private const string UpdateActionHelp = "Updates tools and system packages, then reapplies setup. Agents keep running.";
    private string UpdateHelp => UpdateActionHelp + " "
        + RunnerUpdateStatus.Summary(Runner.Updates, Runner.State == RunnerState.Ready)
        + (!CanRestart && Runner.Updates?.RestartPending == true ? ". Restart needed." : "");

    // Restart's own badge and hover carry the restart status (kernel, the system's restart signal) where it exists.
    private bool CanRestart => Provider?.Capabilities.CanStartStop == true;

    /// <summary>The running kernel and why to restart, first in Restart's hover; also its screen reader description.</summary>
    private IEnumerable<string> RestartNotes
    {
        get
        {
            var updates = Runner.Updates;
            if (updates?.Kernel is { } kernel) yield return $"Running kernel: {kernel.Running}.";
            if (updates?.Kernel?.Installed is { } installed) yield return $"Restart to update to kernel {installed}.";
            else if (updates?.RebootRequired == true) yield return "Restart to finish installed updates.";
            if (updates?.Kernel?.Available is { } available) yield return $"Kernel {available} is available: Update all installs it, then restart to use it.";
        }
    }

    private RenderFragment? RestartDetails => !RestartNotes.Any() ? null : @<text>
        @foreach (var note in RestartNotes)
        {
            <p class="@(note.StartsWith("Restart ", StringComparison.Ordinal) ? "runner-restart-reason" : null)">@note</p>
        }
        <p>@RestartHelp</p>
    </text>;

    private bool Busy => Runner.Operation is not null;
    private bool Ready => Runner.State == RunnerState.Ready && !Busy;

    private int Running => Runner.Agents.Count(a => a.State == AgentState.Running);
    private string Agents => Running == 1 ? "its running agent" : $"its {Running} running agents";
    private string Saved => Running == 1 ? "Its conversation is saved first" : "Their conversations are saved first";

    private string StopHelp => Running == 0
        ? "Shuts the VM down. Start it again whenever you like."
        : $"Shuts the VM down, which stops {Agents}. {Saved} and can be resumed later.";

    private string RestartHelp => Running == 0
        ? "Shuts the VM down and starts it again."
        : $"Shuts the VM down and starts it again, which stops {Agents}. {Saved}; start {(Running == 1 ? "it" : "them")} again afterwards.";

    private async Task RunAsync(Func<Task> start)
    {
        try
        {
            await start();
            await Started.InvokeAsync();
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        catch (HttpRequestException) { Snackbar.Add(LoadingSection.Unreachable, Severity.Error); }
    }
}
