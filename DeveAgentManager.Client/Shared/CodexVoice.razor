@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="terminal-voice" @ref="_host">
    @if (_phase == "idle")
    {
        <MudButton StartIcon="@Icons.Material.Rounded.Mic" Size="Size.Small" Disabled="@(_module is null)" OnClick="StartAsync" title="Start voice (F8)">Start voice</MudButton>
    }
    else
    {
        @if (_phase == "connected")
        {
            <MudIconButton Icon="@(_muted ? Icons.Material.Rounded.MicOff : Icons.Material.Rounded.Mic)" Size="Size.Small" OnClick="MuteAsync"
                           Color="@(_muted ? Color.Warning : Color.Primary)" aria-label="@(_muted ? "Unmute microphone" : "Mute microphone")" aria-pressed="@(_muted ? "true" : "false")" />
        }
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Rounded.CallEnd" OnClick="EndAsync">End voice</MudButton>
        @if (_playbackBlocked)
        { <MudButton Size="Size.Small" OnClick="PlayAsync">Play audio</MudButton> }
    }
    <span class="terminal-voice-status @(_error is not null ? "terminal-voice-error" : "")" role="status" aria-live="polite">@Status</span>
    <HelpTip Label="Codex voice" ViewportCentered="true">
        <p>Choose Start voice here to use this device's microphone and speakers. F8 starts or ends the call. The /voice command inside the terminal uses the Runner's audio devices instead.</p>
        <p>Allow microphone access when your browser asks. Mute pauses your microphone; End voice leaves the agent's coding work running. Leaving this page or hiding the tab ends the call.</p>
        <p>Voice requires an agent Codex login with voice access. After updating the Manager, update Codex on the Runner and restart the agent once. Only one tab can connect voice to an agent at a time.</p>
    </HelpTip>
</div>

@code {
    [Parameter, EditorRequired] public Guid AgentId { get; set; }
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CodexVoice>? _self;
    private string _phase = "idle";
    private string? _error;
    private bool _muted, _playbackBlocked, _disposed;
    private string? Status => _error ?? (_phase switch
    {
        "permission" => "Allow microphone access…",
        "connecting" => "Connecting voice…",
        "connected" => _muted ? "Microphone muted" : "Voice connected",
        _ => null,
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/codex-voice.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            await _module.InvokeVoidAsync("initialize", _host, _self, AgentId);
        }
        catch (JSException) { _error = "Voice controls could not load. Reload this page to retry."; }
        if (!_disposed) StateHasChanged();
    }

    [JSInvokable]
    public Task VoiceChanged(string phase, bool muted, bool playbackBlocked, string? error)
    {
        if (_disposed) return Task.CompletedTask;
        (_phase, _muted, _playbackBlocked, _error) = (phase, muted, playbackBlocked, error);
        return InvokeAsync(StateHasChanged);
    }

    private Task StartAsync() => _module!.InvokeVoidAsync("start", _host).AsTask();
    private Task EndAsync() => _module!.InvokeVoidAsync("stop", _host).AsTask();
    private Task MuteAsync() => _module!.InvokeVoidAsync("setMuted", _host, !_muted).AsTask();
    private Task PlayAsync() => _module!.InvokeVoidAsync("play", _host).AsTask();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _host); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
