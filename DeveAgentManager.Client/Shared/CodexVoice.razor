@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ManagerApi Api

<div class="terminal-voice-container" @ref="_host">
    <section class="terminal-voice-transcript" aria-label="Voice transcript" hidden="@(_terminalMode || !_transcriptVisible || _transcript.Lines.Count == 0)">
        <div class="terminal-voice-transcript-heading">
            <span>Voice transcript</span>
            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="() => _transcriptVisible = false" aria-label="Close voice transcript" />
        </div>
        <div class="terminal-voice-transcript-lines" role="log" aria-label="Spoken conversation" aria-live="polite" aria-relevant="additions text" tabindex="0">
            @foreach (var line in _transcript.Lines)
            {
                <div class="terminal-voice-transcript-line @(line.Role == "user" ? "voice-transcript-user" : "voice-transcript-assistant")" @key="line.Id">
                    <span class="terminal-voice-transcript-role">@(line.Role == "user" ? "You" : "Codex")</span>
                    <span class="terminal-voice-transcript-text">@line.Text</span>
                </div>
            }
        </div>
    </section>
<div class="terminal-voice">
    @if (_phase == "idle")
    {
        <MudButton StartIcon="@Icons.Material.Rounded.Mic" Size="Size.Small" Disabled="@(_module is null)" OnClick="StartAsync" title="Start voice (F8)">Start voice</MudButton>
        @if (_module is null && _error is not null)
        { <MudButton Size="Size.Small" OnClick="InitializeAsync">Retry</MudButton> }
    }
    else
    {
        @if (_phase == "connected" && !_terminalMode)
        {
            <MudIconButton Icon="@(_muted ? Icons.Material.Rounded.MicOff : Icons.Material.Rounded.Mic)" Size="Size.Small" OnClick="MuteAsync"
                           Color="@(_muted ? Color.Warning : Color.Primary)" aria-label="@(_muted ? "Unmute microphone" : "Mute microphone")" aria-pressed="@(_muted ? "true" : "false")" />
        }
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Rounded.CallEnd" OnClick="EndAsync">End voice</MudButton>
        @if (_playbackBlocked)
        { <MudButton Size="Size.Small" OnClick="PlayAsync">Play audio</MudButton> }
        @if (_phase == "connected")
        {
            @if (_microphones.Length > 0)
            {
                <select class="terminal-voice-microphone" aria-label="Microphone" title="Microphone" value="@_microphone" @onchange="ChangeMicrophoneAsync" disabled="@_changingInput">
                    @foreach (var input in _microphones)
                    { <option value="@input.Id">@input.Label</option> }
                </select>
            }
            @if (!_terminalMode) { <span class="terminal-voice-input">
                <span aria-hidden="true">Mic</span>
                <span class="terminal-voice-input-level" role="meter" aria-label="Microphone input level" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" title="Microphone input level"><span></span></span>
            </span> }
        }
    }
    <span class="terminal-voice-status @(_error is not null ? "terminal-voice-error" : "")" role="status" aria-live="polite">@Status</span>
    @if (!_terminalMode && !_transcriptVisible && _transcript.Lines.Count > 0)
    { <MudButton Size="Size.Small" OnClick="() => _transcriptVisible = true">Show transcript</MudButton> }
    <HelpTip Label="Codex voice" ViewportCentered="true">
        <p>Choose Start voice here to use this device's microphone and speakers. F8 starts or ends the call. Choose browser or terminal mode under <MudLink Href="settings?tab=voice">My settings → Voice</MudLink>.</p>
        <p>Terminal mode shows Codex's own voice controls and captions inside the terminal. Start with this button or type /voice while this page is open; the browser supplies microphone access for either option. Use Codex's mute control inside the terminal. Restart an existing agent once after updating the Manager to enable its audio adapter.</p>
        <p>Allow microphone access when your browser asks. Mute pauses your microphone; End voice leaves the agent's coding work running. Leaving this page or hiding the tab ends the call.</p>
        <p>The Mic meter moves when your browser receives sound. If it stays still while you speak, choose another microphone and check your device's microphone settings. Browser calls show their status here; Codex's terminal voice strip tracks terminal calls.</p>
        <p>Voice transcript shows both sides as you speak, including conversation that does not become a coding request. Recent captions stay on this page after the call ends. Scroll up to read earlier words; scroll to the bottom to follow new speech.</p>
        <p>Voice requires an agent Codex login with voice access. After updating the Manager, update Codex on the Runner and restart the agent once. Only one tab can connect voice to an agent at a time.</p>
    </HelpTip>
</div>
</div>

@code {
    [Parameter, EditorRequired] public Guid AgentId { get; set; }
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CodexVoice>? _self;
    private string _phase = "idle";
    private string? _error;
    private bool _muted, _playbackBlocked, _disposed;
    private bool _changingInput;
    private int _inputRequest;
    private readonly VoiceTranscriptLog _transcript = new();
    private bool _transcriptVisible = true;
    private bool _terminalMode;
    private int _modeRequest;
    private MicrophoneInput[] _microphones = [];
    private string _microphone = "";
    public sealed record MicrophoneInput(string Id, string Label);
    private string? Status => _error ?? (_phase switch
    {
        "permission" => "Allow microphone access…",
        "connecting" => "Connecting voice…",
        "connected" => _terminalMode ? "Terminal voice connected" : _muted ? "Microphone muted" : "Voice connected",
        _ => null,
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        await InitializeAsync();
    }

    private async Task InitializeAsync()
    {
        _error = null;
        try
        {
            _terminalMode = (await Api.GetCodexVoiceSettingsAsync()).TerminalMode;
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/codex-voice.js");
            if (_disposed) { await _module.DisposeAsync(); return; }
            await _module.InvokeVoidAsync("initialize", _host, _self, AgentId, _terminalMode);
        }
        catch (ApiException ex) { _error = ex.Message; }
        catch (HttpRequestException) { _error = LoadingSection.Unreachable; }
        catch (JSException) { _error = "Voice controls could not load. Reload this page to retry."; }
        if (!_disposed) StateHasChanged();
    }

    [JSInvokable]
    public Task VoiceChanged(string phase, bool muted, bool playbackBlocked, string? error)
    {
        if (_disposed) return Task.CompletedTask;
        (_phase, _muted, _playbackBlocked, _error) = (phase, muted, playbackBlocked, error);
        if (phase == "idle") { _inputRequest++; _modeRequest++; _changingInput = false; _transcript.Finish(); }
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task<bool?> GetVoiceMode()
    {
        var request = ++_modeRequest;
        try
        {
            var settings = await Api.GetCodexVoiceSettingsAsync();
            if (_disposed || request != _modeRequest) return null;
            _terminalMode = settings.TerminalMode;
            await InvokeAsync(StateHasChanged);
            return _terminalMode;
        }
        catch (ApiException) { return null; }
        catch (HttpRequestException) { return null; }
    }

    [JSInvokable]
    public Task VoiceTranscriptChanged(VoiceTranscriptUpdate update)
    {
        if (_disposed || !_transcript.Update(update)) return Task.CompletedTask;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task VoiceInputsChanged(MicrophoneInput[] inputs, string selected)
    {
        if (_disposed) return Task.CompletedTask;
        (_microphones, _microphone) = (inputs, selected);
        return InvokeAsync(StateHasChanged);
    }

    private async Task ChangeMicrophoneAsync(ChangeEventArgs args)
    {
        if (_changingInput || args.Value is not string selected) return;
        var previous = _microphone;
        _microphone = selected;
        _changingInput = true;
        var request = ++_inputRequest;
        try
        {
            var error = await _module!.InvokeAsync<string?>("setMicrophone", _host, selected);
            if (_disposed || request != _inputRequest) return;
            _error = error;
            if (_error is not null) _microphone = previous;
        }
        finally { if (request == _inputRequest) _changingInput = false; }
    }

    private Task StartAsync() => _module!.InvokeVoidAsync("start", _host).AsTask();
    private Task EndAsync() => _module!.InvokeVoidAsync("stop", _host).AsTask();
    private Task MuteAsync() => _module!.InvokeVoidAsync("setMuted", _host, !_muted).AsTask();
    private Task PlayAsync() => _module!.InvokeVoidAsync("play", _host).AsTask();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("dispose", _host); await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        _self?.Dispose();
    }
}
