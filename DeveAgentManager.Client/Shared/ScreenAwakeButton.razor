@implements IDisposable
@inject ScreenAwakeService Awake

@* A native title gives desktop hover help without a floating tooltip expanding the mobile viewport. *@
<MudIconButton Icon="@(Awake.Enabled ? Icons.Material.Rounded.WbSunny : Icons.Material.Rounded.Bedtime)"
               Color="@(Awake.Active ? Color.Primary : Awake.Enabled ? Color.Warning : Color.Default)" Size="Size.Small"
               Disabled="@(!Awake.Ready || Awake.Busy || Awake.Unavailable is not null)" OnClick="Awake.ToggleAsync"
               aria-label="@Awake.Hint" aria-pressed="@(Awake.Enabled ? "true" : "false")" title="@Awake.Hint" />

@code {
    protected override void OnInitialized() => Awake.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => Awake.Changed -= OnChanged;
}
