@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<span @ref="_host">
    @* A native title gives desktop hover help without a floating tooltip expanding the mobile viewport. *@
    <MudIconButton Icon="@(_active ? Icons.Material.Rounded.WbSunny : Icons.Material.Rounded.Bedtime)"
                   Color="@(_active ? Color.Primary : Color.Default)" Size="Size.Small"
                   Disabled="@(!_ready || _unavailable is not null)" OnClick="ToggleAsync"
                   aria-label="@Hint" aria-pressed="@(_enabled ? "true" : "false")" title="@Hint" />
</span>

@code {
    private ElementReference _host;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ScreenAwakeButton>? _self;
    private bool _ready, _enabled, _active;
    private string? _unavailable;
    private string Hint => _unavailable ?? (!_ready ? "Keep screen awake: loading" : _active
        ? "Keep screen awake: on" : _enabled ? "Keep screen awake: paused" : "Keep screen awake: off");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/screen-awake.js");
        _unavailable = await _module.InvokeAsync<string?>("start", _host, _self);
        _ready = true;
        StateHasChanged();
    }

    private async Task ToggleAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("toggle", _host);
    }

    [JSInvokable]
    public Task ScreenAwakeChanged(bool enabled, bool active, string? error) => InvokeAsync(() =>
    {
        _enabled = enabled;
        _active = active;
        if (error is not null) Snackbar.Add(error, Severity.Warning);
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            try { await _module.InvokeVoidAsync("stop", _host); await _module.DisposeAsync(); }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
        _self?.Dispose();
    }
}
