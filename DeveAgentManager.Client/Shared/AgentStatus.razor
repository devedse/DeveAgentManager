@inject IDialogService Dialogs
<button type="button" class="agent-status-button" title="@(Agent.Activity?.Reason ?? Agent.StateMessage ?? StateStyles.For(Agent).Text)" @onclick="OpenAsync" aria-label="@($"Explain {Agent.Name} status: {StateStyles.For(Agent).Text}")">
    <StatusPill Style="StateStyles.For(Agent)" Class="@Class" />
    @if (Agent.State == AgentState.Running && Agent.Activity is { BackgroundTaskCount: > 0 } activity && activity.Status != AgentActivityStatus.Ready && activity.Status != AgentActivityStatus.Unknown)
    {
        <span class="agent-status-extra">Background · @activity.BackgroundTaskCount</span>
    }
    @if (Agent.Activity?.QuestionWaiting == true)
    {
        <span class="agent-status-extra">Question</span>
    }
    @if (Agent.Activity?.UnseenCompletion == true)
    {
        <span class="agent-status-extra" title="Finished since you last viewed it">Finished</span>
    }
</button>
@code {
    [Parameter, EditorRequired] public AgentDto Agent { get; set; } = default!;
    [Parameter] public string? Class { get; set; }
    private Task OpenAsync() => Dialogs.ShowAsync<AgentStatusDialog>("Agent status", new DialogParameters<AgentStatusDialog> { { d => d.Agent, Agent } }, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
}
