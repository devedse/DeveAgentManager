@page "/"
@inherits LiveComponent
@inject IDialogService Dialogs
@inject SignedInUser Me

<PageTitle>Dashboard · DeveAgentManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="page">
    <PageHeader Title="Dashboard" Subtitle="Your coding agents and the machines they run on.">
        <Actions>
            <MudButton Href="activity" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.MonitorHeart">Agent activity</MudButton>
            @if (CanCreateRunners)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Rounded.AddToQueue" OnClick="NewRunnerAsync">New Runner</MudButton>
            }
            @if (_runners.Count > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="NewAgentAsync">New agent</MudButton>
            }
        </Actions>
    </PageHeader>

    @if (CanCreateRunners && _info is not null && !_info.Providers.Any(p => p.IsConfigured && !p.Capabilities.RequiresConnectionDetails))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Dense="true">
            Proxmox is not configured yet, so only existing machines can be added.
            @if (_user?.Has(UserRoles.SettingsManager) == true)
            {
                <span>See <MudLink Href="manager-settings">Manager settings → Providers</MudLink> for what to set.</span>
            }
            else
            {
                <span>A settings manager sets it up under Manager settings → Providers.</span>
            }
        </MudAlert>
    }

    <div class="stat-grid" aria-busy="@(Loaded ? "false" : "true")">
        <div class="stat-card">
            <div class="stat-icon stat-icon-primary"><MudIcon Icon="@Icons.Material.Rounded.SmartToy" /></div>
            <div>
                <div class="stat-value">@if (!Loaded && LoadError is not null) { <span>–</span> } else { <LoadingSection Loaded="Loaded" Announce="false"><Placeholder><Skeleton Width="64px" Height="30px" /></Placeholder><ChildContent>@_agents.Count(a => a.State == AgentState.Running)<span class="stat-total"> / @_agents.Count</span></ChildContent></LoadingSection> }</div>
                <div class="stat-label">Agents running</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-success"><MudIcon Icon="@Icons.Material.Rounded.Dns" /></div>
            <div>
                <div class="stat-value">@if (!Loaded && LoadError is not null) { <span>–</span> } else { <LoadingSection Loaded="Loaded" Announce="false"><Placeholder><Skeleton Width="64px" Height="30px" /></Placeholder><ChildContent>@_runners.Count(r => r.State == RunnerState.Ready)<span class="stat-total"> / @_runners.Count</span></ChildContent></LoadingSection> }</div>
                <div class="stat-label">Runners ready</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-info"><MudIcon Icon="@Icons.Material.Rounded.Autorenew" /></div>
            <div>
                <div class="stat-value">@if (!Loaded && LoadError is not null) { <span>–</span> } else { <LoadingSection Loaded="Loaded" Announce="false"><Placeholder><Skeleton Width="36px" Height="30px" /></Placeholder><ChildContent>@_runners.Count(r => StateStyles.For(r.State).Busy || r.Operation is not null)</ChildContent></LoadingSection> }</div>
                <div class="stat-label">Runners busy</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon stat-icon-warning"><MudIcon Icon="@Icons.Material.Rounded.Memory" /></div>
            <div>
                @{
                    var cores = _runners.Where(r => r.State == RunnerState.Ready).Sum(r => r.Cores);
                    var memory = _runners.Where(r => r.State == RunnerState.Ready).Sum(r => (long)r.MemoryMb);
                }
                <div class="stat-value">@if (!Loaded && LoadError is not null) { <span>–</span> } else { <LoadingSection Loaded="Loaded" Announce="false"><Placeholder><Skeleton Width="90px" Height="30px" /></Placeholder><ChildContent>@(cores > 0 ? cores : "-")<span class="stat-total"> cores</span></ChildContent></LoadingSection> }</div>
                <div class="stat-label">@(memory > 0 ? $"{FormatMemory(memory)} memory" : "Allocated to Proxmox Runners")</div>
            </div>
        </div>
    </div>

    <LoadingSection Loaded="Loaded" Error="@LoadError" Retry="RetryAsync" Label="Loading agents and Runners">
    <Placeholder>
        <MudGrid Spacing="4">
            <MudItem xs="12" lg="7"><div class="panel"><div class="panel-header"><MudText Typo="Typo.h6">Agents</MudText></div><SkeletonList Rows="4" /></div></MudItem>
            <MudItem xs="12" lg="5"><div class="panel"><div class="panel-header"><MudText Typo="Typo.h6">Runners</MudText></div><SkeletonList Rows="3" /></div></MudItem>
        </MudGrid>
    </Placeholder>
    <ChildContent>
    @if (_runners.Count == 0 && _agents.Count == 0 && !CanCreateRunners)
    {
        <EmptyState Icon="@Icons.Material.Rounded.Dns" Title="No Runner yet"
                    Text="Agents run on Runners. Ask a runner manager to give you access to one; agents others share with you appear here too." />

    }
    else if (_runners.Count == 0 && _agents.Count == 0)
    {
        <div class="panel get-started">
            <MudText Typo="Typo.h5">Get started</MudText>
            @{
                var checksConnection = _user?.Has(UserRoles.SettingsManager) == true;
                var step = 1;
            }
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@(checksConnection ? "Three" : "Two") steps to your first agent.</MudText>
            <div class="steps">
                @if (checksConnection)
                {
                    <a class="step" href="manager-settings">
                        <span class="step-number">@(step++)</span>
                        <div><div class="step-title">Check the connection</div><div class="step-text">Manager settings → Providers → Test connection</div></div>
                    </a>
                }
                <button type="button" class="step" @onclick="NewRunnerAsync">
                    <span class="step-number">@(step++)</span>
                    <div><div class="step-title">Create a Runner</div><div class="step-text">A VM cloned from your template and set up for agents</div></div>
                </button>
                <button type="button" class="step" @onclick="NewAgentAsync">
                    <span class="step-number">@step</span>
                    <div><div class="step-title">Start an agent</div><div class="step-text">Clone a repository and open pi in your browser</div></div>
                </button>
            </div>
        </div>

    }
    else
    {
        <MudGrid Spacing="4">
            <MudItem xs="12" lg="7">
                <div class="panel">
                    <div class="panel-header">
                        <MudText Typo="Typo.h6">Agents</MudText>
                        <MudButton Href="agents" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Rounded.ChevronRight">All agents</MudButton>
                    </div>
                    @* The same rows, with the same quick actions, as on the Agents and Runner pages. *@
                    <AgentTable Agents="_agents.Take(8).ToList()" ShowRunner="true" EmptyText="Start an agent on a Runner to work on a repository.">
                                <EmptyContent>
                                    @if (_runners.Count > 0)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="NewAgentAsync">New agent</MudButton>
                                    }
                                </EmptyContent>
                            </AgentTable>

                </div>
            </MudItem>
            <MudItem xs="12" lg="5">
                <div class="panel">
                    <div class="panel-header">
                        <MudText Typo="Typo.h6">Runners</MudText>
                        <MudButton Href="runners" Variant="Variant.Text" Size="Size.Small" EndIcon="@Icons.Material.Rounded.ChevronRight">All Runners</MudButton>
                    </div>
                    <div class="list">
                        @foreach (var runner in _runners)
                        {
                            var status = runner.Status;
                            <a class="list-row dashboard-runner" href="runners/@runner.Id">
                                <div class="list-avatar list-avatar-icon"><MudIcon Icon="@(runner.Kind == RunnerKind.Desktop ? Icons.Material.Rounded.DesktopWindows : Icons.Material.Rounded.Dns)" Size="Size.Small" /></div>
                                <div class="list-main">
                                    <div class="list-title">@runner.Name</div>
                                    <div class="list-subtitle">@(runner.Host ?? "no address yet") · @runner.Agents.Count @(runner.Agents.Count == 1 ? "agent" : "agents")</div>
                                </div>
                                <div class="list-meta">
                                    <StatusPill Style="StateStyles.For(runner.State)" Text="@runner.Operation" />
                                </div>
                                @if (runner.State == RunnerState.Ready && status is { CpuUsage: not null })
                                {
                                    <UsageBars Status="status" Compact="true" />
                                }
                            </a>
                        }
                    </div>

                </div>
            </MudItem>
        </MudGrid>

    }
    </ChildContent>
    </LoadingSection>
</MudContainer>

@code {
    protected override TimeSpan? RefreshInterval => TimeSpan.FromSeconds(5);
    private ManagerInfoDto? _info;
    private CurrentUserDto? _user;
    private List<RunnerDto> _runners = [];
    private List<AgentDto> _agents = [];

    private bool CanCreateRunners => _user?.Has(UserRoles.RunnerCreator) == true;

    protected override async Task LoadAsync()
    {
        // At the same time: on a slow connection, one request after another adds up.
        var runners = Api.ListRunnersAsync();
        // Agents shared with the user can be on Runners they have no access to: they come from the agent list.
        var agents = Api.ListAgentsAsync();
        _user = await Me.GetAsync();
        _info ??= await Api.InfoAsync();
        _runners = await runners;
        _agents = (await agents).OrderByDescending(a => a.State == AgentState.Running).ThenByDescending(a => a.CreatedAt).ToList();
    }

    private Task NewRunnerAsync() => Dialogs.ShowAsync<NewRunnerDialog>();

    private Task NewAgentAsync() => Dialogs.ShowAsync<NewAgentDialog>();

    private static string FormatMemory(long megabytes) => megabytes >= 1024 ? $"{megabytes / 1024.0:0.#} GB" : $"{megabytes} MB";
}
