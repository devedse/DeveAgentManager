@page "/agents/{AgentId:guid}"
@layout TerminalLayout
@inherits LiveComponent
@inject IDialogService Dialogs
@inject SignedInUser Me
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(_agent?.Name ?? "Agent") · DeveAgentManager</PageTitle>

<div class="terminal-page">
    @* Stop, Restart, VS Code, the Runner desktop, Sharing and the Conversation are always in the ⋮ menu, so they aren't
       tapped by accident. The other buttons stay in the toolbar while they fit; when they don't, they move into the ⋮ menu
       one by one, in the order of ToolbarOverflow (js/toolbar-overflow.js), so the agent's name stays readable. *@
    <div class="terminal-toolbar" @ref="_toolbar">
        <MudIconButton Href="agents" Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" aria-label="Back to agents" />
        @if (_agent is null && !Loaded && LoadError is null)
        {
            <div class="terminal-title" aria-hidden="true">
                <Skeleton Width="140px" Height="14px" />
                <Skeleton Width="210px" Height="10px" Class="mt-1" />
            </div>
        }
        @if (_agent is not null)
        {
            var running = _agent.State is AgentState.Running or AgentState.Starting;
            var write = _agent.Access >= AgentAccess.Write;
            var read = _agent.Access >= AgentAccess.Read;
            @if (ManagerApi.IconUrl(_agent) is not null)
            {
                <AgentAvatar Agent="_agent" Class="terminal-avatar" />
            }
            <div class="terminal-title">
                <div class="terminal-name-row">
                    <WorkspaceMenu Agent="_agent" Changed="OnSwitchedAsync" @key="_agent.Id" />
                    <AgentStatus Agent="_agent" Class="terminal-status" />
                </div>
                <span class="terminal-context"><HarnessLogo HarnessId="@_agent.HarnessId" Class="context-logo" />@(_agent.AccountName is { } account ? $"{account} · " : "")@if (AgentTable.CommitsAs(_agent) is { } git)
                    {
                        <span title="@AgentTable.GitIdentityTitle(git)">Git: @AgentTable.GitIdentityText(git) · </span>
                    }@_agent.RunnerName · <span class="mono">@(_sessionTitle ?? _agent.RepositoryUrl ?? _agent.WorkingDirectory)</span></span>
            </div>
            <CpuTraceIndicator />
            <AttentionMenu />
            <AgentSeenWatcher @key="(AgentId, nameof(AgentSeenWatcher))" Agent="_agent" />
            <span class="terminal-hint">Shift+drag selects · Ctrl+C copies a selection</span>
            @if (_sessionId is { } sessionId)
            {
                <span class="toolbar-item" data-toolbar="images"><SessionImageButton @key="sessionId" SessionId="sessionId" /></span>
                <SessionFileButton @key="(sessionId, nameof(SessionFileButton))" SessionId="sessionId" class="toolbar-item" data-toolbar="files" />
            }
            @if (read)
            {
                <AgentTasksButton @key="(AgentId, nameof(AgentTasksButton))" AgentId="AgentId" CanClear="write" class="toolbar-item" data-toolbar="tasks" />
            }
            @if (running && write)
            {
                <span class="toolbar-item" data-toolbar="limit"><AgentLimitButton @key="AgentId" AgentId="AgentId" /></span>
                <span class="toolbar-item terminal-quick-desktop" data-toolbar="quick"><QuickCommandMenu AgentId="AgentId" HarnessId="@_agent.HarnessId" Disabled="_busy" /></span>
                <AgentSwitchMenu Agent="_agent" Switched="OnSwitchedAsync" />
                <span class="toolbar-item" data-toolbar="viewers"><AgentViewers AgentId="_agent.Id" OwnTty="@_terminal?.Tty" Harness="@_agent.HarnessId" /></span>
            }
            @if (read)
            {
                <span class="toolbar-item" data-toolbar="awake"><ScreenAwakeButton /></span>
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="terminal-more">
                    <ActivatorContent>
                        <MudIconButton Icon="@Icons.Material.Rounded.MoreVert" Size="Size.Small" OnClick="@context.ToggleAsync" aria-label="More actions" title="More actions" />
                    </ActivatorContent>
                    <ChildContent>
                        @* What the toolbar has no room for, in toolbar order. *@
                        @if (_sessionId is { } menuSessionId)
                        {
                            @if (Overflowed("images"))
                            {
                                <SessionImageButton SessionId="menuSessionId" InMenu="true" />
                            }
                            @if (Overflowed("files"))
                            {
                                <SessionFileButton SessionId="menuSessionId" InMenu="true" />
                            }
                        }
                        @if (Overflowed("tasks"))
                        {
                            <AgentTasksButton AgentId="AgentId" CanClear="write" InMenu="true" />
                        }
                        @if (running && write)
                        {
                            @if (Overflowed("limit"))
                            {
                                <AgentLimitButton AgentId="AgentId" InMenu="true" />
                            }
                            @if (Overflowed("quick"))
                            {
                                <QuickCommandMenu AgentId="AgentId" HarnessId="@_agent.HarnessId" Disabled="_busy" InMenu="true" />
                            }
                            @if (Overflowed("viewers"))
                            {
                                <AgentViewers AgentId="_agent.Id" OwnTty="@_terminal?.Tty" Harness="@_agent.HarnessId" InMenu="true" />
                            }
                        }
                        @if (Overflowed("awake"))
                        {
                            <ScreenAwakeButton InMenu="true" />
                        }
                        @if (_overflow.Overlaps(MenuEntries))
                        {
                            <MudDivider Class="my-1" />
                        }

                        @* Always here. *@
                        @if (_sessionId is { } conversationId)
                        {
                            <MudMenuItem Icon="@Icons.Material.Rounded.Forum" Href="@($"sessions/{conversationId}")">Conversation</MudMenuItem>
                        }
                        @if (write)
                        {
                            <MudMenuItem Icon="@Icons.Material.Rounded.AddComment" Disabled="@(_busy || _agent.MovePending)" OnClick="NewConversationAsync">New conversation here…</MudMenuItem>
                        }
                        <MudMenuItem Icon="@(_agent.Access == AgentAccess.Owner ? Icons.Material.Rounded.Share : Icons.Material.Rounded.PeopleAlt)" OnClick="ShareAsync">Sharing</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Rounded.Badge" OnClick="GitIdentityAsync">Git identity…</MudMenuItem>
                        @if (_agent.Access == AgentAccess.Owner)
                        {
                            @if (_agent.MovePending)
                            {
                                <MudMenuItem Icon="@Icons.Material.Rounded.Restore" Disabled="_agent.State == AgentState.Moving" OnClick="() => RunAsync(() => Api.RecoverAgentMoveAsync(_agent.Id), reconnect: false)">Recover move / finish cleanup</MudMenuItem>
                            }
                            else
                            {
                                <MudMenuItem Icon="@Icons.Material.Rounded.DriveFileMove" Disabled="_agent.RunnerState != RunnerState.Ready" OnClick="() => MoveAgentDialog.ShowAsync(Dialogs, _agent)">Move project to another runner…</MudMenuItem>
                            }
                            @if (_agent.IsClone)
                            {
                                <MudMenuItem Icon="@Icons.Material.Rounded.DeleteOutline" IconColor="Color.Error" Disabled="@(_agent.MovePending || _agent.RunnerState != RunnerState.Ready)" OnClick="RemoveWorkspaceAsync">Remove workspace…</MudMenuItem>
                            }
                        }
                        @* A read-write share covers the agent; the desktop and VS Code are the Runner's. *@
                        @if (write && _agent.CanUseRunner && _agent.RunnerKind == RunnerKind.Desktop)
                        {
                            <MudMenuItem Icon="@Icons.Material.Rounded.DesktopWindows" Href="@($"runners/{_agent.RunnerId}/desktop?agent={AgentId}")">Runner desktop</MudMenuItem>
                        }
                        @if (running && write)
                        {
                            @if (_agent.CanUseRunner && _agent.RunnerToolIds.Contains("vscode"))
                            {
                                <MudMenuItem Icon="@(_vsCodeIcon ?? Icons.Material.Rounded.Code)" Href="@($"agents/{_agent.Id}/vscode")">VS Code</MudMenuItem>
                            }
                            <MudDivider Class="my-1" />
                            <MudMenuItem Icon="@Icons.Material.Rounded.RestartAlt" Disabled="_busy" OnClick="RestartAsync">Restart the harness</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Rounded.Stop" Disabled="_busy" OnClick="StopAsync">Stop the agent</MudMenuItem>
                        }
                    </ChildContent>
                </MudMenu>
            }
        }
    </div>

    @if (_agent is null)
    {
        <div class="terminal-stopped">
            <LoadingSection Loaded="Loaded" Error="@LoadError" Retry="RetryAsync" Label="Loading the agent">
                <EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="Agent not found" Text="It may have been deleted.">
                    <MudButton Href="agents" Variant="Variant.Outlined">Back to agents</MudButton>
                </EmptyState>
            </LoadingSection>
        </div>
    }
    else if (_agent.Access < AgentAccess.Read)
    {
        <div class="terminal-stopped">
            <EmptyState Icon="@Icons.Material.Rounded.Lock" Title="@($"{_agent.OwnerName}'s agent")"
                        Text="It runs on a Runner you manage, so you see that it is there, but only its owner and the people they share it with can open it.">
                <MudButton Href="agents" Variant="Variant.Outlined">Back to agents</MudButton>
            </EmptyState>
        </div>
    }
    else if (_agent.State == AgentState.Moving)
    {
        <div class="terminal-stopped" role="status" aria-busy="true">
            <AgentMoveProgress Progress="@(_agent.MoveDetails?.Progress ?? new AgentMoveProgressDto(_agent.StateMessage ?? "Moving agent…"))" />
        </div>
    }
    else if (_agent.State is AgentState.Running or AgentState.Starting)
    {
        @if (_agent.MovePending && _agent.MoveDetails?.Progress is { } progress)
        {
            <div class="terminal-move-progress"><AgentMoveProgress Progress="progress" /></div>
        }
        @if (_agent.StateMessage is { } moveMessage)
        {
            <div class="terminal-readonly-banner" role="status"><MudIcon Icon="@Icons.Material.Rounded.Info" Size="Size.Small" /><span>@moveMessage</span></div>
        }
        @if (_agent.Access < AgentAccess.Write)
        {
            <div class="terminal-readonly-banner">
                <MudIcon Icon="@Icons.Material.Rounded.Visibility" Size="Size.Small" />
                <span>@AgentTable.ShareText(_agent). You can watch; typing goes nowhere.</span>
            </div>
        }
        <TerminalView @ref="_terminal" @key="(_agent.Id, _agent.RunnerId, _connectionKey)" AgentId="_agent.Id" HarnessId="@_agent.HarnessId" ReadOnly="@(_agent.Access < AgentAccess.Write || _agent.State == AgentState.Moving)"
                      Disconnected="OnDisconnectedAsync" Connected="StateHasChanged" />
    }
    else
    {
        <div class="terminal-stopped">
            <EmptyState Icon="@Icons.Material.Rounded.PauseCircle" Title="@($"'{_agent.Name}' is not running")"
                        Text="@(_agent.Access >= AgentAccess.Write ? _agent.StateMessage ?? "Start it to continue. The harness resumes the same conversation." : $"{_agent.OwnerName} or someone with read-write access can start it.")">
                @if (_agent.Access >= AgentAccess.Write)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.PlayArrow" Disabled="_busy || _agent.RunnerState != RunnerState.Ready" OnClick="StartAsync">
                        @(_agent.RunnerState == RunnerState.Ready ? "Start agent" : $"Runner is {_agent.RunnerState.ToString().ToLowerInvariant()}")
                    </MudButton>
                }
            </EmptyState>
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid AgentId { get; set; }

    private AgentDto? _agent;
    private Guid? _loadedAgentId;
    private Guid? _sessionId;
    private string? _sessionTitle;
    private TerminalView? _terminal;
    private int _connectionKey;
    private bool _busy;
    private readonly CancellationTokenSource _refreshStop = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _ = RefreshStatusAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedAgentId != AgentId)
        {
            _agent = null;
            _sessionId = null;
            _sessionTitle = null;
            await ReloadAsync();
        }
    }

    private async Task RefreshStatusAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
            while (await timer.WaitForNextTickAsync(_refreshStop.Token)) await ReloadAsync();
        }
        catch (OperationCanceledException) { }
    }

    public override void Dispose()
    {
        _refreshStop.Cancel();
        if (_toolbarModule is { } module) _ = StopToolbarAsync(module);
        base.Dispose();
    }

    private ElementReference _toolbar;
    private IJSObjectReference? _toolbarModule;
    private DotNetObjectReference<AgentTerminal>? _toolbarSelf;
    private HashSet<string> _overflow = [];

    /// <summary>What leaves the toolbar first when it runs out of room. Only the last seven get an entry in the ⋮ menu.</summary>
    private static readonly object[] ToolbarOverflow =
    [
        new { key = "hint", selector = ".terminal-hint" },
        new { key = "avatar", selector = ".terminal-avatar" },
        // The harness/account button keeps its icon.
        new { key = "switch-label", selector = ".switch-chip-label" },
        new { key = "viewers", selector = "[data-toolbar='viewers']" },
        new { key = "quick", selector = "[data-toolbar='quick']" },
        new { key = "images", selector = "[data-toolbar='images']" },
        new { key = "files", selector = "[data-toolbar='files']" },
        new { key = "tasks", selector = "[data-toolbar='tasks']" },
        new { key = "awake", selector = "[data-toolbar='awake']" },
        new { key = "limit", selector = "[data-toolbar='limit']" },
    ];

    private static readonly string[] MenuEntries = ["viewers", "quick", "images", "files", "tasks", "awake", "limit"];

    private bool Overflowed(string key) => _overflow.Contains(key);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _toolbarSelf = DotNetObjectReference.Create(this);
        _toolbarModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/toolbar-overflow.js");
        await _toolbarModule.InvokeVoidAsync("start", _toolbar, _toolbarSelf, ToolbarOverflow, ".terminal-name");
    }

    [JSInvokable]
    public void ToolbarOverflowChanged(string[] keys)
    {
        _overflow = keys.ToHashSet();
        StateHasChanged();
    }

    private async Task StopToolbarAsync(IJSObjectReference module)
    {
        try
        {
            await module.InvokeVoidAsync("stop", _toolbar);
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _toolbarSelf?.Dispose();
    }
    private string? _vsCodeIcon;

    // Its own Runner's changes (state, harnesses, tools), not every Runner's.
    protected override bool IsRelevant(ManagerEvent managerEvent) => managerEvent.AgentId == AgentId
        || managerEvent.Kind == ManagerEventKind.RunnerChanged && (managerEvent.RunnerId is null || managerEvent.RunnerId == _agent?.RunnerId);

    protected override async Task LoadAsync()
    {
        var requestedAgent = AgentId;
        var previous = _agent?.State;
        _vsCodeIcon ??= (await Api.InfoAsync()).Tools.FirstOrDefault(t => t.Id == "vscode")?.Icon;
        var agent = await Api.GetAgentAsync(requestedAgent);
        if (AgentId != requestedAgent) return;
        // Its conversation is for who can read the agent (not for people who only see it on a Runner they manage).
        var currentSession = agent?.Access >= AgentAccess.Read ? await Api.GetAgentSessionAsync(requestedAgent) : null;
        if (AgentId != requestedAgent) return;
        _agent = agent;
        _loadedAgentId = requestedAgent;
        _sessionId = currentSession?.Id;
        _sessionTitle = currentSession?.Title;
        if (previous is not null && previous != AgentState.Running && _agent?.State == AgentState.Running)
        {
            // It was (re)started: attach a fresh terminal.
            _connectionKey++;
        }
    }

    private async Task OnDisconnectedAsync()
    {
        // The harness may have exited: refresh its state so the page shows it.
        if (_agent is not null)
        {
            try
            {
                await Api.RefreshRunnerAsync(_agent.RunnerId);
            }
            catch (Exception ex) when (ex is ApiException or HttpRequestException)
            {
                // The monitor will catch up.
            }
        }

        await ReloadAsync();
    }

    private async Task NewConversationAsync()
    {
        if (_agent is not null && await NewConversationDialog.ShowAsync(Dialogs, _agent)) await OnSwitchedAsync();
    }

    private async Task RemoveWorkspaceAsync()
    {
        if (_agent is not null && await RemoveWorkspaceDialog.ShowAsync(Dialogs, _agent)) Navigation.NavigateTo($"projects/{WorkspaceGroups.ProjectKey(_agent)}");
    }

    private async Task ShareAsync()
    {
        if (_agent is not null && await ShareDialog.ShowAsync(Dialogs, _agent, await Me.GetAsync()))
        {
            // Left the share: there is nothing here any more.
            Navigation.NavigateTo("agents");
        }
    }

    private Task StartAsync() => RunAsync(() => Api.StartAgentAsync(AgentId), reconnect: true);

    private async Task RestartAsync()
    {
        if (_agent is null || !await AgentTable.ConfirmRestartAsync(Dialogs, _agent.Name))
        {
            return;
        }

        await RunAsync(() => Api.StartAgentAsync(AgentId, restart: true), reconnect: true);
    }

    private async Task GitIdentityAsync()
    {
        if (_agent is not null && await GitIdentityDialog.ShowAsync(Dialogs, _agent, await Me.GetAsync()))
        {
            await OnSwitchedAsync();
        }
    }

    private async Task OnSwitchedAsync()
    {
        await LoadAsync();
        _connectionKey++;
    }

    private Task StopAsync() => RunAsync(() => Api.StopAgentAsync(AgentId), reconnect: false);

    private async Task RunAsync(Func<Task> action, bool reconnect)
    {
        _busy = true;
        try
        {
            await action();
            await LoadAsync();
            if (reconnect)
            {
                _connectionKey++;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
