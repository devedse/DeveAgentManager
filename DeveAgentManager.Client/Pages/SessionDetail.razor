@page "/sessions/{SessionId:guid}"
@inherits LiveComponent
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SignedInUser Me

<PageTitle>@(_stored?.Title ?? "Session") · DeveAgentManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="page">
    @if (_stored is null)
    {
        <LoadingSection Loaded="Loaded" Error="@LoadError" Retry="RetryAsync" Label="Loading the session">
            <Placeholder><SkeletonDetail Lines="6" /></Placeholder>
            <ChildContent>
                <EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="Session not found" Text="It may have been deleted.">
                    <MudButton Href="sessions" Variant="Variant.Outlined">Back to sessions</MudButton>
                </EmptyState>
            </ChildContent>
        </LoadingSection>
    }
    else
    {
        var live = _stored.Agent is { State: AgentState.Running or AgentState.Starting };
        <PageHeader Title="@_stored.Title" Overline="Session" BackHref="sessions">
            <TitleContent>
                @if (_stored.Agent is { } agent)
                {
                    <AgentStatus Agent="agent" />
                }
            </TitleContent>
            <Actions>
                @if (_stored.Agent is { Access: >= AgentAccess.Read } running)
                {
                    <MudButton Href="@($"agents/{running.Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Terminal">Open agent</MudButton>
                }
                else if (SessionList.ContinueText(_stored) is { } continueText)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.PlayArrow" OnClick="ContinueAsync">@continueText</MudButton>
                }
                <SessionExportMenu SessionId="_stored.Id" />
                <MudMenu Icon="@Icons.Material.Rounded.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <MudMenuItem Icon="@Icons.Material.Rounded.ContentCopy" Disabled="@(ConversationCopy.LastReply(_session).Length == 0)" OnClick="CopyLastReplyAsync">Copy last reply</MudMenuItem>
                    <MudMenuItem Icon="@(_stored.Access == SessionAccess.Owner ? Icons.Material.Rounded.Share : Icons.Material.Rounded.PeopleAlt)" OnClick="ShareAsync">Sharing</MudMenuItem>
                    @if (_stored.Access == SessionAccess.Owner)
                    {
                        <MudMenuItem Icon="@Icons.Material.Rounded.Edit" OnClick="RenameAsync">Rename session</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Rounded.Delete" IconColor="Color.Error" Disabled="@(_stored.AgentId != null)" OnClick="DeleteAsync">Delete session</MudMenuItem>
                    }
                </MudMenu>
            </Actions>
        </PageHeader>

        <div class="session-facts">
            @if (_stored.Access != SessionAccess.Owner)
            {
                <div><span class="fact-label">Owner</span><span>@_stored.OwnerName · shared with you read-only</span></div>
            }
            <div><span class="fact-label">Harness</span><span>@(_stored.HarnessTrail is { } trail && trail.Contains(',') ? string.Join(" → ", trail.Split(',')) : _stored.HarnessId)</span></div>
            <div><span class="fact-label">Where</span><span>@(_stored.Agent is { } a ? $"{a.Name} on {a.RunnerName}" : _stored.RunnerName is null ? "Imported" : $"No agent (last on {_stored.RunnerName})")</span></div>
            @if (_stored.RepositoryUrl is not null)
            {
                <div><span class="fact-label">Repository</span><span class="mono">@_stored.RepositoryUrl@(_stored.RepositoryBranch is null ? "" : $" ({_stored.RepositoryBranch})")</span></div>
            }
            <div><span class="fact-label">Messages</span><span>@_stored.MessageCount · @_toolCalls tool calls@(_branches > 0 ? $" · {_branches} other branch{(_branches == 1 ? "" : "es")}" : "")</span></div>
            @if (_tokens > 0)
            {
                <div><span class="fact-label">Usage</span><span>@FormatTokens(_tokens) tokens@(_cost > 0 ? $" · ${_cost:0.00}" : "")@(_models.Count > 0 ? $" · {string.Join(", ", _models)}" : "")</span></div>
            }
            <div><span class="fact-label help-heading">Size <HelpTip Label="Session size" Text="Sizes are the latest synced files, not the model's context window. Saved history includes backups." /></span><span>@SessionSize.Text(_stored)</span></div>
            <div><span class="fact-label">Updated</span><span>@_stored.UpdatedAt.Humanize()@(_stored.LastSyncedAt is { } synced ? $" · synced {synced.Humanize()}" : "")</span></div>
        </div>

        <ConversationView Session="_session" />
        <div class="panel mt-4">
            <div class="help-heading mb-3"><MudText Typo="Typo.h6">Shared images</MudText>
                <HelpTip Label="Shared images">Images published by the agent or saved from the desktop stay with this conversation across session and harness switches. Agents can publish a file with <code>dam-tools share-image /path/to/image.png --caption "Description"</code>.</HelpTip></div>
            <SessionImagesView @key="SessionId" SessionId="SessionId" />
        </div>
        <div class="panel mt-4">
            <div class="help-heading mb-3"><MudText Typo="Typo.h6">Shared files</MudText>
                <HelpTip Label="Shared files">
                    <p>Files the agent shares for download, such as a built APK or installer. They stay with this conversation across session and harness switches.</p>
                    <p>Agents share one with <code>dam-tools share-file /path/to/app.apk --caption "Description"</code>, up to 1 GiB. Deleting a file or the conversation can't be undone.</p>
                </HelpTip></div>
            <SessionFilesView @key="SessionId" SessionId="SessionId" />
        </div>

        @if (_session.Entries.Count > 8)
        {
            <div class="conv-end">
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Rounded.VerticalAlignTop" OnClick="@(() => JS.InvokeVoidAsync("scrollTo", 0, 0))">Back to top</MudButton>
            </div>
        }
    }
</MudContainer>

@code {
    [Parameter]
    public Guid SessionId { get; set; }

    private SessionDto? _stored;
    private DeveSession _session = new();
    private int _toolCalls;
    private int _branches;
    private long _tokens;
    private decimal _cost;
    private List<string> _models = [];
    private bool _scrolled;

    protected override bool IsRelevant(ManagerEvent managerEvent) =>
        managerEvent.SessionId == SessionId || (managerEvent.AgentId is not null && managerEvent.AgentId == _stored?.AgentId);

    protected override async Task LoadAsync()
    {
        _stored = await Api.GetSessionAsync(SessionId);
        if (_stored is null)
        {
            return;
        }

        _session = await Api.GetSessionContentAsync(SessionId);
        var messages = _session.Entries.Where(e => e.Kind == DeveEntryKind.Message).ToList();
        _toolCalls = messages.Where(e => e.Content is not null).Sum(e => e.Content!.Count(b => b.Type == "toolCall"));
        _branches = _session.OtherBranchCount();
        _tokens = messages.Sum(e => e.Usage is { } u ? u.Input + u.Output + u.CacheRead + u.CacheWrite : 0);
        _cost = messages.Sum(e => e.Usage?.CostUsd ?? 0);
        _models = messages.Select(e => e.Model?.Id).Where(m => m is not null).Distinct().ToList()!;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Open at the latest messages, like a chat.
        if (!_scrolled && _session.Entries.Count > 0)
        {
            _scrolled = true;
            await JS.InvokeVoidAsync("damUi.scrollPageToEnd");
        }
    }

    private async Task CopyLastReplyAsync()
    {
        var text = ConversationCopy.LastReply(_session);
        if (text.Length == 0) return;
        try { await JS.InvokeVoidAsync("damUi.copy", text); Snackbar.Add(CopyText.Copied(CopyText.Count(text)), Severity.Success); }
        catch (JSException) { Snackbar.Add("Could not copy. Select the reply and use your device's Copy menu.", Severity.Warning); }
    }

    private async Task ContinueAsync()
    {
        if (_stored?.WorkspaceAgentId is { } workspace && _stored.WorkspaceAccess >= AgentAccess.Write && await Api.GetAgentAsync(workspace) is { } agent)
        {
            var dialog = await Dialogs.ShowAsync<SessionPickerDialog>("Sessions", new DialogParameters<SessionPickerDialog> { { d => d.Agent, agent } }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
            if (await dialog.Result is { Canceled: false }) Navigation.NavigateTo($"agents/{workspace}");
        }
        else await Dialogs.ShowAsync<NewAgentDialog>("Continue session", new DialogParameters<NewAgentDialog> { { d => d.ContinueSession, _stored } });
    }
    private async Task ShareAsync()
    {
        if (await ShareDialog.ShowAsync(Dialogs, _stored!, await Me.GetAsync()))
        {
            // Left the share: it is gone for this user.
            Navigation.NavigateTo("sessions");
        }
    }

    private async Task RenameAsync()
    {
        var dialog = await Dialogs.ShowAsync<RenameSessionDialog>("Rename session", new DialogParameters<RenameSessionDialog> { { d => d.Session, _stored! } });
        await dialog.Result;
        await ReloadAsync();
    }

    private async Task DeleteAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync($"Delete '{_stored!.Title}'?", "The stored conversation is deleted from the Manager. Files on Runners are not touched.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            try
            {
                await Api.DeleteSessionAsync(SessionId);
                Snackbar.Add("Session deleted.", Severity.Info);
                Navigation.NavigateTo("sessions");
            }
            catch (ApiException ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private static string FormatTokens(long tokens) => tokens >= 1_000_000 ? $"{tokens / 1_000_000.0:0.#}M" : tokens >= 1000 ? $"{tokens / 1000.0:0.#}k" : tokens.ToString();
}
