@page "/sessions"
@inherits LiveComponent
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>Sessions · DeveAgentManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="page">
    <PageHeader Title="Sessions" Subtitle="Every agent's conversation, stored by the Manager. It stays after the agent or its Runner is gone, and can be continued on any Runner.">
        <Actions>
            <MudFileUpload T="IBrowserFile" FilesChanged="ImportAsync" Accept=".jsonl,.json" MaximumFileCount="1">
                <CustomContent Context="upload">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Upload" Disabled="_importing" OnClick="upload.OpenFilePickerAsync">@(_importing ? "Importing..." : "Import")</MudButton>
                </CustomContent>
            </MudFileUpload>
        </Actions>
    </PageHeader>

    <div class="panel">
        @if (_sessions.Count > 0)
        {
            <div class="filter-bar">
                <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search sessions" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="filter-search" />
            </div>
        }

        @if (Loaded && _sessions.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Rounded.Forum" Title="No sessions yet"
                        Text="Sessions appear here when agents start. You can also import a pi session file (.jsonl) or a DeveSession (.deve.json)." />
        }
        else
        {
            <div class="agent-table">
                @foreach (var group in Filtered.GroupBy(s => s.WorkspaceAgentId?.ToString() ?? s.RepositoryUrl ?? "Imported"))
                {
                    var first = group.First();
                    <div class="session-group-heading">
                        <strong>@(first.WorkspaceName ?? first.RepositoryUrl ?? "Imported sessions")</strong>
                        <span> · @group.Count() sessions</span>
                        @if (first.WorkspaceAgentId is { } workspace)
                        {
                            <MudButton Size="Size.Small" OnClick="() => OpenWorkspaceAsync(workspace)">Manage sessions</MudButton>
                        }
                        <div class="list-subtitle">@first.RepositoryUrl · @first.RunnerName · @first.WorkingDirectory</div>
                    </div>
                    @foreach (var session in group.OrderByDescending(s => s.AgentId != null).ThenByDescending(s => s.UpdatedAt))
                    {
                    var live = session.Agent is { State: AgentState.Running or AgentState.Starting };
                    <div class="agent-row">
                        <a class="agent-row-main" href="sessions/@session.Id">
                            @if (session.Agent is { } sessionAgent)
                            {
                                <AgentAvatar Agent="sessionAgent" />
                            }
                            else
                            {
                                <div class="list-avatar list-avatar-logo"><HarnessLogo HarnessId="@session.HarnessId" Size="Size.Medium" /></div>
                            }
                            <div class="list-main">
                                <div class="list-title">@session.Title@(session.AgentId is not null ? " · Active" : "")</div>
                                <div class="list-subtitle">@SessionSize.Text(session)</div>
                                <div class="list-subtitle">
                                    @if (session.Agent is { } agent)
                                    {
                                        <span>@agent.Name on @agent.RunnerName</span>
                                    }
                                    else
                                    {
                                        <span>@(session.WorkspaceAgentId is not null ? $"Saved · {session.WorkspaceName} on {session.RunnerName}" : session.RunnerName is null ? "Imported" : $"No workspace · last on {session.RunnerName}")</span>
                                    }
                                    @if (session.RepositoryUrl is not null)
                                    {
                                        <span class="mono"> · @session.RepositoryUrl</span>
                                    }
                                </div>
                            </div>
                        </a>
                        <div class="agent-row-state">
                            @if (live)
                            {
                                <StatusPill Style="StateStyles.For(session.Agent!)" />
                            }
                            else
                            {
                                <span class="session-count">@session.MessageCount messages</span>
                            }
                            <span class="list-time">@session.UpdatedAt.Humanize()</span>
                        </div>
                        <div class="agent-row-actions">
                            @if (session.Agent is null)
                            {
                                <MudTooltip Text="Continue on a Runner">
                                    <MudIconButton Icon="@Icons.Material.Rounded.PlayArrow" Color="Color.Success" Size="Size.Small" OnClick="() => ContinueAsync(session)" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="Open the agent">
                                    <MudIconButton Href="@($"agents/{session.AgentId}")" Icon="@Icons.Material.Rounded.Terminal" Color="Color.Primary" Size="Size.Small" />
                                </MudTooltip>
                            }
                            <SessionExportMenu SessionId="session.Id" Icon="true" />
                            <MudIconButton Icon="@Icons.Material.Rounded.Edit" Size="Size.Small" aria-label="Rename session" OnClick="() => RenameAsync(session)" />
                            <MudIconButton Icon="@Icons.Material.Rounded.DeleteOutline" Size="Size.Small" aria-label="Delete session" Disabled="@(session.AgentId != null)" OnClick="() => DeleteAsync(session)" />
                        </div>
                    </div>
                }
                }
            </div>
        }
    </div>
</MudContainer>

@code {
    private List<SessionDto> _sessions = [];
    private string? _search;
    private bool _importing;

    private IEnumerable<SessionDto> Filtered => string.IsNullOrWhiteSpace(_search)
        ? _sessions
        : _sessions.Where(s => s.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
                               || (s.RepositoryUrl?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                               || (s.Agent?.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    protected override bool IsRelevant(ManagerEvent managerEvent) => managerEvent.Kind is ManagerEventKind.SessionChanged or ManagerEventKind.SessionRemoved or ManagerEventKind.AgentChanged or ManagerEventKind.AgentRemoved;

    protected override async Task LoadAsync() => _sessions = await Api.ListSessionsAsync();

    private async Task ImportAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _importing = true;
        try
        {
            var session = await Api.ImportSessionAsync(file);
            Snackbar.Add($"Imported '{session.Title}'.", Severity.Success);
            Navigation.NavigateTo($"sessions/{session.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task ContinueAsync(SessionDto session)
    {
        if (session.WorkspaceAgentId is { } workspace) await OpenWorkspaceAsync(workspace);
        else await Dialogs.ShowAsync<NewAgentDialog>("Continue session", new DialogParameters<NewAgentDialog> { { d => d.ContinueSession, session } });
    }
    private async Task OpenWorkspaceAsync(Guid workspace)
    {
        if (await Api.GetAgentAsync(workspace) is not { } agent) return;
        var dialog = await Dialogs.ShowAsync<SessionPickerDialog>("Sessions", new DialogParameters<SessionPickerDialog> { { d => d.Agent, agent } }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is { Canceled: false }) Navigation.NavigateTo($"agents/{workspace}");
        await ReloadAsync();
    }
    private async Task RenameAsync(SessionDto session)
    {
        var dialog = await Dialogs.ShowAsync<RenameSessionDialog>("Rename session", new DialogParameters<RenameSessionDialog> { { d => d.Session, session } }, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        await dialog.Result;
        await ReloadAsync();
    }
    private async Task DeleteAsync(SessionDto session)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete session?", $"Delete '{session.Title}' and its saved backups from the Manager? Runner files stay untouched.", yesText: "Delete", cancelText: "Cancel") != true) return;
        try { await Api.DeleteSessionAsync(session.Id); await ReloadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
