@page "/agents"
@inherits LiveComponent
@inject IDialogService Dialogs
@inject SignedInUser Me

<PageTitle>Agents · DeveAgentManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="page">
    <PageHeader Title="Agents" Help="Each agent is a harness running in its own tmux session on a Runner. It keeps running when you close the browser.">
        <Actions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="NewAgentAsync">New agent</MudButton>
        </Actions>
    </PageHeader>

    <div class="panel">
        @if (_agents.Count > 0)
        {
            <div class="filter-bar">
                <MudTextField @bind-Value="_search" Immediate="true" Placeholder="Search agents" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Rounded.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="filter-search" />
                <MudSwitch T="bool" @bind-Value="_showStopped" Label="Show stopped workspaces" Color="Color.Primary" />
                <MudChipSet T="string" @bind-SelectedValue="_filter" SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                    <MudChip Value="@("all")" Default="true">All @_agents.Count</MudChip>
                    <MudChip Value="@("running")">Running @_agents.Count(a => a.State is AgentState.Running or AgentState.Starting)</MudChip>
                    <MudChip Value="@("stopped")">Not running @_agents.Count(a => a.State is not (AgentState.Running or AgentState.Starting))</MudChip>
                </MudChipSet>
            </div>
        }
        <LoadingSection Loaded="Loaded" Error="@LoadError" Retry="RetryAsync" Label="Loading agents">
            <Placeholder><SkeletonList Rows="5" /></Placeholder>
            <ChildContent>
                <GroupedAgentTable Agents="Filtered" User="_user" ShowRunner="true" ShowStopped="@(_showStopped || _filter == "stopped")">
                    <EmptyContent>
                        @if (_agents.Count == 0)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="NewAgentAsync">New agent</MudButton>
                        }
                    </EmptyContent>
                </GroupedAgentTable>
            </ChildContent>
        </LoadingSection>
    </div>
    @if (Loaded)
    {
        <GroupedAgentTable Agents="Filtered" User="_user" ShowRunner="true" ShowStopped="@(_showStopped || _filter == "stopped")" AdministrativeOnly="true" />
    }
</MudContainer>

@code {
    protected override TimeSpan? RefreshInterval => TimeSpan.FromSeconds(5);
    private List<AgentDto> _agents = [];
    [SupplyParameterFromQuery(Name = "project")] public Guid? ProjectId { get; set; }
    private bool _showStopped;
    private string? _search;
    private string? _filter = "all";
    private CurrentUserDto? _user;

    private IReadOnlyList<AgentDto> Filtered => _agents
        .Where(a => ProjectId is null || WorkspaceGroups.ProjectKey(a) == ProjectId)
        .Where(a => _filter switch
        {
            "running" => a.State is AgentState.Running or AgentState.Starting,
            "stopped" => a.State is not (AgentState.Running or AgentState.Starting),
            _ => true,
        })
        .Where(a => string.IsNullOrWhiteSpace(_search)
                    || a.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || WorkspaceGroups.ProjectName(a).Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (a.RepositoryBranch?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (a.RepositoryUrl?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || a.RunnerName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || a.OwnerName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ByLastReply()
        .ToList();

    protected override async Task LoadAsync()
    {
        _user = await Me.GetAsync();
        _agents = (await Api.ListAgentsAsync()).ForAgentList(_user).ToList();
    }

    private Task NewAgentAsync() => Dialogs.ShowAsync<NewAgentDialog>();
}
