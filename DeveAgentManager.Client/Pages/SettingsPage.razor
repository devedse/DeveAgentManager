@page "/settings"
@inject ManagerApi Api
@inject ISnackbar Snackbar
@inject ThemeService Theme
@inject SignedInUser Me

<PageTitle>My settings · DeveAgentManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="page">
    <PageHeader Title="My settings" Help="Yours only, stored encrypted. Your agents and shells use them on every Runner you can use. The Manager's own settings are under Manager settings." />

    @if (_user?.Has(UserRoles.SettingsManager) == true)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
            The settings that are the same for everyone (providers, the shared Setup Profile, harness settings) are under <MudLink Href="manager-settings">Manager settings</MudLink>.
        </MudAlert>
    }

    <div class="panel panel-flush">
        <MudTabs @ref="_tabs" Elevation="0" ApplyEffectsToContainer="true" Class="panel-tabs" TabPanelsClass="panel-tab-content" KeepPanelsAlive="true" MinimumTabWidth="0">
            <MudTabPanel Text="Git and GitHub" Icon="@Icons.Custom.Brands.GitHub">
                <LoadingSection Loaded="_settings is not null && _profile is not null" Error="@_loadError" Retry="LoadAsync" Label="Loading your settings">
                <Placeholder><SkeletonForm Fields="3" /></Placeholder>
                <ChildContent>
                @if (_settings is not null && _profile is not null)
                {
                    <div class="settings-section">
                        <div class="help-heading"><MudText Typo="Typo.subtitle1" Class="section-title">Git identity</MudText>
                            <HelpTip Label="Git identity">Your agents and shells commit with this name and email. Without one, git asks for it.</HelpTip></div>
                        <div class="form-row">
                            <MudTextField @bind-Value="_profile.GitUserName" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            <MudTextField @bind-Value="_profile.GitUserEmail" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        </div>
                        <div class="settings-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Save" Disabled="_saving" OnClick="SaveProfileAsync">Save</MudButton>
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="help-heading"><MudText Typo="Typo.subtitle1" Class="section-title">GitHub token</MudText>
                            <HelpTip Label="GitHub token">Your agents and shells clone and push with it. Prefer a fine-grained token limited to the repositories your agents may work on.
                            Only yours: people you share a Runner with don't push with it, and without a token nobody else's is used.</HelpTip></div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Agents on the Runners you use can read this token, and so can the people you share those Runners with. Limit its repository access.</MudText>
                        <div class="form-row form-row-center">
                            <MudTextField @bind-Value="_token" Label="Token" Placeholder="@(_settings.HasGitHubToken ? "•••••••• (saved; enter a new one to replace it)" : "github_pat_...")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          InputType="InputType.Password" Class="flex-grow-1 mono-input" Immediate="true"
                                          HelperText="@TokenHint" Error="@TokenLooksWrong" ErrorText="@TokenHint" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving || string.IsNullOrWhiteSpace(_token)" OnClick="() => SaveTokenAsync(_token)">Save</MudButton>
                            @if (_settings.HasGitHubToken)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_saving" OnClick="() => SaveTokenAsync(null)">Remove</MudButton>
                            }
                        </div>
                    </div>
                }
                </ChildContent>
                </LoadingSection>
            </MudTabPanel>

            <MudTabPanel Text="Environment" Icon="@Icons.Material.Rounded.DataObject">
                <LoadingSection Loaded="_profile is not null" Error="@_loadError" Retry="LoadAsync" Label="Loading your settings">
                <Placeholder><SkeletonForm Fields="3" /></Placeholder>
                <ChildContent>
                @if (_profile is not null)
                {
                    <div class="settings-section">
                        <div class="section-title-row">
                            <div class="help-heading"><MudText Typo="Typo.subtitle1" Class="section-title">Environment variables</MudText>
                                <HelpTip Label="Environment variables">Available to your agents and shells, for example <code>ANTHROPIC_API_KEY</code> or <code>OPENAI_API_KEY</code> for pi.
                                Anyone with access to the same Runner can read them there.</HelpTip></div>
                            <MudSwitch T="bool" @bind-Value="_showSecrets" Color="Color.Primary" Label="Show values" Size="Size.Small" />
                        </div>
                        @foreach (var variable in _profile.EnvironmentVariables)
                        {
                            <div class="form-row form-row-center">
                                <MudTextField @bind-Value="variable.Name" Placeholder="NAME" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mono-input env-name" Immediate="true"
                                              Error="@(_profile.Problem(variable) is not null)" ErrorText="@_profile.Problem(variable)" />
                                <MudTextField @bind-Value="variable.Value" Placeholder="value" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="@(_showSecrets ? InputType.Text : InputType.Password)" Class="flex-grow-1 mono-input" Immediate="true" />
                                <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="() => _profile.EnvironmentVariables.Remove(variable)" aria-label="Remove" />
                            </div>
                        }
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.Add" Size="Size.Small" OnClick="() => _profile.EnvironmentVariables.Add(new SetupEnvironmentVariable())">Add variable</MudButton>
                        <div class="settings-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Save" Disabled="_saving" OnClick="SaveProfileAsync">Save</MudButton>
                        </div>
                    </div>
                }
                </ChildContent>
                </LoadingSection>
            </MudTabPanel>

            <MudTabPanel Text="SSH keys" Icon="@Icons.Material.Rounded.Key">
                <LoadingSection Loaded="_profile is not null" Error="@_loadError" Retry="LoadAsync" Label="Loading your settings">
                <Placeholder><SkeletonForm Fields="2" /></Placeholder>
                <ChildContent>
                @if (_profile is not null)
                {
                    <div class="settings-section">
                        <div class="help-heading"><MudText Typo="Typo.subtitle1" Class="section-title">SSH keys</MudText>
                            <HelpTip Label="SSH keys">To log in to the Runners you can use yourself (<code>ssh @(_info?.RunnerUsername ?? "remoteman")@@host</code>). They are added to each of those Runners
                            and removed when your access ends. Paste a public key: the contents of a <code>.pub</code> file.</HelpTip></div>
                        @foreach (var (key, index) in _profile.SshKeys.Select((k, i) => (k, i)).ToList())
                        {
                            <div class="form-row form-row-center">
                                <MudTextField T="string" Value="key" ValueChanged="value => _profile.SshKeys[index] = value" Placeholder="ssh-ed25519 AAAA… you@laptop" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Class="flex-grow-1 mono-input" Immediate="true" Error="@(UserProfile.SshKeyProblem(key) is not null)" ErrorText="@UserProfile.SshKeyProblem(key)" />
                                <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="() => _profile.SshKeys.RemoveAt(index)" aria-label="Remove key" />
                            </div>
                        }
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.Add" Size="Size.Small" Disabled="_profile.SshKeys.Count >= UserProfile.MaxSshKeys" OnClick="() => _profile.SshKeys.Add(string.Empty)">Add key</MudButton>
                        <div class="settings-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Save" Disabled="_saving" OnClick="SaveProfileAsync">Save</MudButton>
                        </div>
                    </div>
                }
                </ChildContent>
                </LoadingSection>
            </MudTabPanel>

            <MudTabPanel Text="Harness logins" Icon="@Icons.Material.Rounded.ManageAccounts">
                <AccountsPanel />
            </MudTabPanel>

            <MudTabPanel Text="Models" Icon="@Icons.Material.Rounded.Psychology">
                <ModelDefaultsPanel />
            </MudTabPanel>

            <MudTabPanel @ref="_petTab" Text="Damagochi" Icon="@Icons.Material.Rounded.Pets"><PetSettingsPanel /></MudTabPanel>

            <MudTabPanel Text="Appearance" Icon="@Icons.Material.Rounded.Contrast">
                <div class="settings-section">
                    <div class="help-heading"><MudText Typo="Typo.subtitle1" Class="section-title">Theme</MudText>
                        <HelpTip Label="Theme">Saved in this browser. <b>System</b> follows the device's light or dark mode, also when it changes. Terminals and logs stay dark,
                        and VS Code follows the device.</HelpTip></div>
                    <MudToggleGroup T="string" Value="Theme.Mode" ValueChanged="Theme.SetModeAsync" Color="Color.Primary" Outlined="true" Class="theme-choice">
                        <MudToggleItem Value="ThemeService.System"><MudIcon Icon="@Icons.Material.Rounded.BrightnessAuto" Size="Size.Small" Class="mr-2" />System</MudToggleItem>
                        <MudToggleItem Value="ThemeService.Light"><MudIcon Icon="@Icons.Material.Rounded.LightMode" Size="Size.Small" Class="mr-2" />Light</MudToggleItem>
                        <MudToggleItem Value="ThemeService.Dark"><MudIcon Icon="@Icons.Material.Rounded.DarkMode" Size="Size.Small" Class="mr-2" />Dark</MudToggleItem>
                    </MudToggleGroup>
                </div>
            </MudTabPanel>
        </MudTabs>
    </div>
</MudContainer>

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    private MudTabs? _tabs;
    private MudTabPanel? _petTab;
    private bool _openPetTab;
    protected override void OnParametersSet() => _openPetTab = Tab == "damagochi";
    protected override async Task OnAfterRenderAsync(bool first) {
        if (_openPetTab && _tabs is not null && _petTab is not null) { _openPetTab = false; await _tabs.ActivatePanelAsync(_petTab); }
    }
    private CurrentUserDto? _user;
    private ManagerInfoDto? _info;
    private MySettingsDto? _settings;
    private UserProfile? _profile;
    private bool _showSecrets;
    private bool _saving;
    private string? _token;

    private string? _loadError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            _user = await Me.GetAsync();
            _info = await Api.InfoAsync();
            _settings = await Api.GetMySettingsAsync();
            _profile = _settings.Profile;
        }
        catch (ApiException ex)
        {
            _loadError = ex.Message;
        }
        catch (HttpRequestException)
        {
            _loadError = LoadingSection.Unreachable;
        }
    }

    /// <summary>The identity, variables and keys are saved together; the Runners you use get them in the background.</summary>
    private async Task SaveProfileAsync()
    {
        _saving = true;
        try
        {
            _profile = await Api.SaveMyProfileAsync(_profile!);
            Snackbar.Add("Saved. Your Runners get it now; agents that already run use it from their next start.", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveTokenAsync(string? token)
    {
        _saving = true;
        try
        {
            await Api.SaveGitHubTokenAsync(token);
            _token = null;
            _settings = _settings! with { HasGitHubToken = token is not null };
            Snackbar.Add(token is null ? "GitHub token removed." : "GitHub token saved. Your Runners get it now; agents that already run use it from their next start.",
                token is null ? Severity.Info : Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    /// <summary>What kind of GitHub token was entered, from its prefix (GitHub's token formats).</summary>
    private string? TokenHint => _token?.Trim() switch
    {
        null or "" => "Fine-grained (github_pat_...) or classic (ghp_...).",
        var token when token.StartsWith("github_pat_", StringComparison.Ordinal) => "Fine-grained token.",
        var token when token.StartsWith("ghp_", StringComparison.Ordinal) => "Classic token: it reaches every repository you can. A fine-grained one can be limited.",
        var token when token.StartsWith("gho_", StringComparison.Ordinal) || token.StartsWith("ghu_", StringComparison.Ordinal) => "An OAuth or app token; it works while it is valid.",
        _ => "This doesn't look like a GitHub token: they start with github_pat_ or ghp_.",
    };

    private bool TokenLooksWrong => !string.IsNullOrWhiteSpace(_token) && !_token.Trim().StartsWith("gh", StringComparison.Ordinal) && !_token.Trim().StartsWith("github_pat_", StringComparison.Ordinal);
}
