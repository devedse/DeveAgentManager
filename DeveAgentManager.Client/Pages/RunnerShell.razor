@page "/runners/{RunnerId:guid}/shell"
@layout TerminalLayout
@inject ManagerApi Api

<PageTitle>Shell @(_runner?.Name) · DeveAgentManager</PageTitle>

<div class="terminal-page">
    <div class="terminal-toolbar">
        <MudIconButton Href="@($"runners/{RunnerId}")" Icon="@Icons.Material.Rounded.ArrowBack" Size="Size.Small" aria-label="Back" />
        <div class="terminal-title">
            <span class="terminal-name">Shell</span>
            @if (_runner is null)
            {
                <Skeleton Width="180px" Height="10px" Class="mt-1" />
            }
            else
            {
                <span class="terminal-context">@_runner.Username@@@_runner.Name · <span class="mono">@_runner.Host</span></span>
            }
        </div>
        <MudSpacer />
        <span class="terminal-hint d-none d-md-inline">Shift+drag selects · Ctrl+C copies a selection</span>
    </div>
    <TerminalView RunnerId="RunnerId" />
</div>

@code {
    [Parameter]
    public Guid RunnerId { get; set; }

    private RunnerDto? _runner;

    protected override async Task OnInitializedAsync() => _runner = await Api.GetRunnerAsync(RunnerId);
}
