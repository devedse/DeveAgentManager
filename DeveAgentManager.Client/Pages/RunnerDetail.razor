@page "/runners/{RunnerId:guid}"
@inherits LiveComponent
@inject IDialogService Dialogs
@inject NavigationManager Navigation
@inject SignedInUser Me

<PageTitle>@(_runner?.Name ?? "Runner") · DeveAgentManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="page">
    @if (_runner is null)
    {
        <LoadingSection Loaded="Loaded" Error="@LoadError" Retry="RetryAsync" Label="Loading the Runner">
            <Placeholder><SkeletonDetail /></Placeholder>
            <ChildContent>
                <EmptyState Icon="@Icons.Material.Rounded.SearchOff" Title="Runner not found" Text="It may have been deleted.">
                    <MudButton Href="runners" Variant="Variant.Outlined">Back to Runners</MudButton>
                </EmptyState>
            </ChildContent>
        </LoadingSection>
    }
    else
    {
        var operation = _runner.Operation;
        var provider = _info?.Providers.FirstOrDefault(p => p.Id == _runner.ProviderId);
        var status = _runner.Status;
        var ready = _runner.State == RunnerState.Ready && operation is null;
        var manage = _runner.Access >= RunnerAccess.Manage;

        <PageHeader Title="@_runner.Name" Overline="Runner" BackHref="runners">
            <TitleContent>
                <StatusPill Style="StateStyles.For(_runner.State)" Text="@operation" />
            </TitleContent>
            <Actions>
                <MudButton Href="@($"runners/{_runner.Id}/shell")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.Terminal" Disabled="!ready">Shell</MudButton>
                @if (_runner.Kind == RunnerKind.Desktop)
                {
                    <MudButton Href="@($"runners/{RunnerId}/desktop")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.DesktopWindows" Disabled="!ready">Desktop</MudButton>
                }
                @if (_runner.ToolIds.Contains("vscode"))
                {
                    <MudButton Href="@($"runners/{_runner.Id}/vscode")" Variant="Variant.Outlined" StartIcon="@(Tool("vscode")?.Icon ?? Icons.Material.Rounded.Code)" Disabled="!ready">VS Code</MudButton>
                }
                <RunnerPowerActions Runner="_runner" Provider="provider" Started="() => _tab = 1" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" Disabled="!ready" OnClick="NewAgentAsync">New agent</MudButton>
            </Actions>
        </PageHeader>

        @if (_runner.State == RunnerState.Error && _runner.StateMessage is not null && operation is null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-4">
                <div class="alert-title">Something went wrong</div>
                <div>@_runner.StateMessage</div>
                <div class="alert-hint">Check the setup log, then use <b>Update all</b> (or <b>Start</b>) to try again.</div>
            </MudAlert>
        }
        else if (operation is not null || StateStyles.For(_runner.State).Busy)
        {
            <div class="progress-banner mb-4">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                <div class="flex-grow-1">
                    <div class="progress-title">@(operation ?? StateStyles.For(_runner.State).Text)...</div>
                    <div class="progress-text">@(_runner.StateMessage ?? "Working")</div>
                </div>
                @if (manage && operation is not null && operation != "Deleting")
                {
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => RunAsync(() => Api.CancelOperationAsync(RunnerId))">Cancel</MudButton>
                }
            </div>
        }
        else if (manage && _runner.State == RunnerState.Ready && _runner.SetupVersion < _info?.SetupVersion)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Dense="true">
                This Runner was set up with setup script version @_runner.SetupVersion; the current version is @_info!.SetupVersion.
                Use <b>Update all</b> to update it.
            </MudAlert>
        }

        <MudGrid Spacing="4">
            <MudItem xs="12" lg="8">
                <div class="panel panel-flush">
                    <MudTabs @bind-ActivePanelIndex="_tab" Elevation="0" ApplyEffectsToContainer="true" Class="panel-tabs" TabPanelsClass="panel-tab-content" MinimumTabWidth="0">
                        <MudTabPanel Text="Agents" Icon="@Icons.Material.Rounded.SmartToy" BadgeData="@(VisibleAgents.Count > 0 ? VisibleAgents.Count : null)" BadgeColor="Color.Primary">
                            <GroupedAgentTable Agents="VisibleAgents" User="_user" EmptyText="@(ready ? "Start an agent to work on a repository on this Runner." : "Agents can start once the Runner is ready.")">
                                <EmptyContent>
                                    @if (ready)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" OnClick="NewAgentAsync">New agent</MudButton>
                                    }
                                </EmptyContent>
                            </GroupedAgentTable>
                        </MudTabPanel>
                        <MudTabPanel Text="Setup log" Icon="@Icons.Material.Rounded.Notes">
                            <RunnerLogView RunnerId="_runner.Id" Height="560px" />
                        </MudTabPanel>
                        <MudTabPanel Text="Activity" Icon="@Icons.Material.Rounded.History">
                            <RunnerActivityView Runner="_runner" />
                        </MudTabPanel>
                    </MudTabs>
                </div>
                @if (_tab == 0)
                {
                    <GroupedAgentTable Agents="VisibleAgents" User="_user" AdministrativeOnly="true" />
                }
            </MudItem>
            <MudItem xs="12" lg="4">
                @if (_runner.Kind == RunnerKind.Desktop)
                {
                    <div class="panel mb-4">
                        <div class="panel-header">
                            <div class="help-heading"><MudText Typo="Typo.h6">Desktop</MudText>
                                <HelpTip Label="Runner desktop">Desktop setup configures automatic login and refreshes the display environment before Bash commands, so GUI apps open on the real shared desktop. Use Desktop to view it or save snapshots. Re-run setup updates existing runners and preserves a logged-in desktop. Restart existing agents to load the automatic environment refresh.</HelpTip></div>
                            <MudIconButton Icon="@Icons.Material.Rounded.Refresh" Size="Size.Small" Disabled="_refreshingDesktop || !ready" OnClick="RefreshDesktopAsync" aria-label="Refresh desktop status" />
                        </div>
                        @if (_desktop is null || _refreshingDesktop)
                        {
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                        }
                        else
                        {
                            <MudText Color="@(_desktop.State == "ready" && _desktop.AutomationAvailable ? Color.Success : Color.Warning)">@DesktopTitle</MudText>
                            @if (_desktop.State != "ready" || !_desktop.AutomationAvailable)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@_desktop.Message</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@_desktop.SessionType?.ToUpperInvariant() · @_desktop.Display</MudText>
                            }
                        }
                    </div>
                }
                @if (_user is not null)
                {
                    <RunnerAccessPanel Runner="_runner" User="_user" />
                }
                <div class="panel mb-4"><RunnerTimeZoneEditor RunnerId="RunnerId" ReadOnly="!manage" /></div>
                @if (_runner.State == RunnerState.Ready && status is not null)
                {
                    <div class="panel mb-4">
                        <div class="panel-header">
                            <MudText Typo="Typo.h6">Resources</MudText>
                            @if (status.Uptime is { } uptime)
                            {
                                <span class="mud-text-secondary text-small">up @uptime.Humanize(2)</span>
                            }
                        </div>
                        <UsageBars Status="status" />
                        <RunnerUsageChart RunnerId="RunnerId" />
                    </div>
                }
                <div class="panel mb-4">
                    <div class="panel-header">
                        <MudText Typo="Typo.h6">Details</MudText>
                        @* Resources and the address are live (asked every 15 seconds); the software versions are read at setup. *@
                        <MudTooltip Text="Read the software versions from the Runner again">
                            <MudIconButton Icon="@(_refreshing ? null : Icons.Material.Rounded.Refresh)" Size="Size.Small" Disabled="!ready || _refreshing" OnClick="RefreshDetailsAsync"
                                           aria-label="@(_refreshing ? "Refreshing runner details" : "Refresh runner details")" aria-busy="@(_refreshing ? "true" : "false")">
                                @if (_refreshing)
                                {
                                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Style="width:20px;height:20px" />
                                }
                            </MudIconButton>
                        </MudTooltip>
                    </div>
                    <dl class="details">
                        <dt>Owner</dt>
                        <dd>@_runner.OwnerName</dd>
                        <dt>Your access</dt>
                        <dd>@AccessText(_runner.Access)</dd>
                        <dt>Provider</dt>
                        <dd>@(provider?.DisplayName ?? _runner.ProviderId)</dd>
                        @if (_runner.MachineId is not null && _runner.ProviderId != "existing")
                        {
                            <dt>Machine</dt>
                            <dd class="mono">VM @_runner.MachineId</dd>
                        }
                        @if (_runner.TemplateId is not null)
                        {
                            <dt>Template</dt>
                            <dd>@_runner.TemplateId</dd>
                        }
                        <dt>Address</dt>
                        <dd class="mono">@(_runner.Host is null ? "-" : $"{_runner.Username}@{_runner.Host}{(_runner.SshPort == 22 ? "" : $":{_runner.SshPort}")}")</dd>
                        @if (_runner.Cores > 0)
                        {
                            <dt>Size</dt>
                            <dd>@_runner.Cores CPU · @(_runner.MemoryMb / 1024.0) GB RAM · @_runner.DiskGb GB disk</dd>
                        }
                        <dt>Software</dt>
                        <dd>@(_runner.InstalledVersions ?? "-")</dd>
                        <dt>Last setup</dt>
                        <dd>@(_runner.LastSetupAt?.Humanize() ?? "never")</dd>
                        <dt>Created</dt>
                        <dd>@_runner.CreatedAt.Humanize()</dd>
                        @if (_runner.HostKeyFingerprint is not null)
                        {
                            <dt>Host key</dt>
                            <dd class="mono small-break">@_runner.HostKeyFingerprint</dd>
                        }
                    </dl>
                </div>

                @* Maintenance, out of the header: each operation says what it does. Progress shows in the banner and the setup log. *@
                @if (manage)
                {
                <div class="panel">
                    <div class="panel-header">
                        <div class="help-heading"><MudText Typo="Typo.h6">Operations</MudText><HelpTip Label="Runner updates"><p>Check for available tools and system packages here. Hold an Update button for three seconds to install it; Update all in the header updates everything and runs setup again.</p></HelpTip></div>
                        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Refresh" Disabled="@(!ready || _checkingUpdates || _runner.Updates?.Checking == true)" OnClick="CheckUpdatesAsync">Check now</MudButton>
                    </div>
                    <RunnerUpdateStatus Runner="_runner" />
                    <div class="operation-list">
                        @foreach (var harnessId in _runner.HarnessIds)
                        {
                            var harness = Harness(harnessId);
                            <div class="operation">
                                <MudIcon Icon="@(harness.Icon ?? Icons.Material.Rounded.Upgrade)" Class="operation-icon" />
                                <div class="operation-text">
                                    <div class="operation-name help-heading"><span>Update @harness.DisplayName</span><HelpTip Label="Maintenance operation">The latest @harness.DisplayName and its packages, then Manager settings → @harness.DisplayName (packages, model, settings).</HelpTip></div>
                                    <RunnerSoftwareVersion Runner="_runner" SoftwareId="@harnessId" />
                                </div>
                                <HoldButton Text="Update" ActiveText="Updating" Icon="@Icons.Material.Rounded.Upgrade" Size="Size.Small" Disabled="!ready"
                                            Help="@($"Installs the latest {harness.DisplayName}, updates its packages and applies its Manager settings. Running agents keep their current version until restarted.")"
                                            OnConfirmed="() => UpdateHarnessAsync(harness)" />
                            </div>
                        }
                        @foreach (var harness in (_info?.Harnesses ?? []).Where(h => !_runner.HarnessIds.Contains(h.Id)))
                        {
                            <div class="operation">
                                <MudIcon Icon="@(harness.Icon ?? Icons.Material.Rounded.AddCircleOutline)" Class="operation-icon" />
                                <div class="operation-text">
                                    <div class="operation-name help-heading"><span>Install @harness.DisplayName</span><HelpTip Label="Maintenance operation">@harness.Description</HelpTip></div>
                                </div>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="!ready" OnClick="() => InstallHarnessAsync(harness)">Install</MudButton>
                            </div>
                        }
                        @foreach (var tool in _info?.Tools ?? [])
                        {
                            var installed = _runner.ToolIds.Contains(tool.Id);
                            <div class="operation">
                                <MudIcon Icon="@(tool.Icon ?? Icons.Material.Rounded.Extension)" Class="operation-icon" />
                                <div class="operation-text">
                                    <div class="operation-name help-heading"><span>@(installed ? "Update" : "Install") @tool.DisplayName</span><HelpTip Label="Maintenance operation">@(installed ? $"The latest {tool.DisplayName}. If it is open, it reloads with the new version." : tool.Description)</HelpTip></div>
                                    @if (installed) { <RunnerSoftwareVersion Runner="_runner" SoftwareId="@tool.Id" /> }
                                </div>
                                @if (installed)
                                {
                                    <HoldButton Text="Update" ActiveText="Updating" Icon="@Icons.Material.Rounded.Upgrade" Size="Size.Small" Disabled="!ready"
                                                Help="@($"Installs the latest {tool.DisplayName}. Its editor reloads with the new version when opened again.")" OnConfirmed="() => InstallToolAsync(tool, true)" />
                                }
                                else { <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="!ready" OnClick="() => InstallToolAsync(tool, false)">Install</MudButton> }
                            </div>
                        }
                        <div class="operation">
                            <MudIcon Icon="@Icons.Material.Rounded.SystemUpdate" Class="operation-icon" />
                            <div class="operation-text">
                                <div class="operation-name help-heading"><span>Update system packages</span><HelpTip Label="Update system packages">
                                    <p>Runs apt-get update and apt-get dist-upgrade: the latest version of every Debian or Ubuntu package, which can add or remove packages and install a new kernel. Update all does this too.</p>
                                    <p>Running agents keep running. When an update needs a restart, such as a new kernel, the setup log says so; restart the Runner to finish it.</p>
                                </HelpTip></div>
                                @if (_runner.Updates?.SystemPackageCount is { } packages)
                                { <div class="operation-description">@packages packages available@(_runner.Updates.SystemError is not null ? " · Last check failed" : "")</div> }
                                else if (ready && _runner.Updates?.SystemError is null)
                                { <div class="operation-description" role="status" aria-busy="true"><Skeleton Width="120px" /><span class="visually-hidden">Checking system packages</span></div> }
                                else { <div class="operation-description">@(_runner.Updates?.SystemError ?? "Packages not checked")</div> }
                            </div>
                            <HoldButton Text="Update" ActiveText="Updating" Icon="@Icons.Material.Rounded.SystemUpdate" Size="Size.Small" Disabled="!ready"
                                        Help="Updates Debian or Ubuntu packages with apt-get dist-upgrade, including any new dependencies or package removals it requires. Running agents keep running. The log says when the system reports a restart is needed."
                                        OnConfirmed="UpdateSystemPackagesAsync" />
                        </div>
                        <div class="operation">
                            <MudIcon Icon="@Icons.Material.Rounded.Build" Class="operation-icon" />
                            <div class="operation-text">
                                <div class="operation-name help-heading"><span>Re-run setup</span><HelpTip Label="Re-run setup">Everything again: the system packages, tools, tmux and git config, the shared Setup Profile, harnesses and their packages, and each person's own git identity, GitHub token, environment and SSH keys. Safe to repeat.</HelpTip></div>
                                <div class="operation-description">Same as Update all. @SetupVersionText</div>
                            </div>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="operation is not null || _runner.State == RunnerState.Stopped" OnClick="RerunSetupAsync">Run</MudButton>
                        </div>
                        <div class="operation">
                            <MudIcon Icon="@Icons.Material.Rounded.Key" Class="operation-icon" />
                            <div class="operation-text">
                                <div class="operation-name">Forget SSH host key</div>
                                <div class="operation-description">After the machine was reinstalled and its key changed. The next connection trusts the key it sees.</div>
                            </div>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_runner.HostKeyFingerprint is null" OnClick="ForgetHostKeyAsync">Forget</MudButton>
                        </div>
                        @if (_runner.Access >= RunnerAccess.Owner)
                        {
                            <div class="operation operation-danger">
                                <MudIcon Icon="@Icons.Material.Rounded.Delete" Class="operation-icon" />
                                <div class="operation-text">
                                    <div class="operation-name">Delete Runner</div>
                                    <div class="operation-description">Stops everyone's agents on it and removes it from the Manager@(provider?.Capabilities.CanDestroy == true ? ", optionally with the VM" : ""). Conversations are kept.</div>
                                </div>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Disabled="operation is not null" OnClick="DeleteAsync">Delete</MudButton>
                            </div>
                        }
                    </div>
                </div>
                }
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    protected override bool ShowsRunnerUsage => true;

    [Parameter]
    public Guid RunnerId { get; set; }

    private ManagerInfoDto? _info;
    private CurrentUserDto? _user;
    private IReadOnlyList<AgentDto> VisibleAgents => (_runner?.Agents ?? []).ForAgentList(_user).ByLastReply().ToList();
    private RunnerDto? _runner;
    private DesktopStatusDto? _desktop;
    private DateTime _desktopReadAt;
    private bool _refreshingDesktop;
    private string DesktopTitle => _desktop?.State switch { "ready" => "Desktop ready", "login-required" => "Login required", "setup-required" => "Setup required", _ => "Desktop unavailable" };

    private async Task RefreshDesktopAsync()
    {
        if (_refreshingDesktop) return;
        _refreshingDesktop = true;
        try { _desktop = await Api.GetDesktopStatusAsync(RunnerId); }
        catch (Exception) { _desktop = new("unavailable", "Could not read desktop status. Check the runner connection."); }
        finally { _desktopReadAt = DateTime.UtcNow; _refreshingDesktop = false; }
    }
    private int _tab;
    private bool _tabChosen;

    /// <summary>Operations started here whose result is reported when they end.</summary>
    private readonly HashSet<string> _waitingFor = [];

    private string SetupVersionText => (_runner?.SetupVersion, _info?.SetupVersion) switch
    {
        ({ } ran, { } current) when ran >= current => $"Setup script version {ran} (current).",
        ({ } ran, { } current) => $"Set up with version {ran}; the current version is {current}.",
        (null, { } current) => $"Setup script version unknown; the current version is {current}.",
        _ => "",
    };

    protected override async Task OnInitializedAsync()
    {
        Live.OperationFinished += OnOperationFinished;
        await base.OnInitializedAsync();
    }

    protected override bool IsRelevant(ManagerEvent managerEvent) => managerEvent.RunnerId == RunnerId;

    protected override async Task LoadAsync()
    {
        var version = ++_runnerLoadVersion;
        _info ??= await Api.InfoAsync();
        _user = await Me.GetAsync();
        var runner = await Api.GetRunnerAsync(RunnerId);
        if (version != _runnerLoadVersion) return;
        _runner = runner;
        if (_runner?.Kind == RunnerKind.Desktop && DateTime.UtcNow - _desktopReadAt >= TimeSpan.FromSeconds(15))
            await RefreshDesktopAsync();
        if (_runner is not null && !_tabChosen)
        {
            // Show the log while a Runner is being set up, and the agents afterwards.
            _tab = _runner.Agents.Count == 0 && _runner.State != RunnerState.Ready ? 1 : 0;
            _tabChosen = true;
        }
    }

    private static string AccessText(RunnerAccess access) => access switch
    {
        RunnerAccess.Owner => "Owner (or runner manager): everything",
        RunnerAccess.Manage => "Manage",
        _ => "Use: your own agents, the shell, VS Code and the desktop",
    };

    private HarnessDto Harness(string harnessId) =>
        _info?.Harnesses.FirstOrDefault(h => h.Id == harnessId) ?? new HarnessDto(harnessId, harnessId, "", false, false, null, null);

    /// <summary>Starts something on the Runner and shows its setup log.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            await action();
            _tab = 1;
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RerunSetupAsync()
    {
        var running = _runner!.Agents.Count(a => a.State == AgentState.Running);
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            $"Re-run setup on '{_runner.Name}'?",
            "The system packages are updated (apt-get dist-upgrade), then everything is installed and configured again: base packages, tmux and git config, the shared Setup Profile (files, script), the harnesses and tools in their latest version, the harnesses' packages, and each person's own git identity, GitHub token, environment and SSH keys. Each step is safe to repeat."
            + (_runner.Kind == RunnerKind.Desktop ? " Desktop autologin and UI tools are configured too. An already logged-in desktop is left running; the login screen may restart to apply autologin." : "")
            + (running > 0 ? $" The {running} running {(running == 1 ? "agent keeps" : "agents keep")} running; restart {(running == 1 ? "it" : "them")} afterwards to use updated harnesses and packages." : ""),
            yesText: "Re-run setup", cancelText: "Cancel");
        if (confirmed == true)
        {
            await RunAsync(() => Api.RerunSetupAsync(RunnerId));
        }
    }

    private long _runnerLoadVersion;
    private bool _checkingUpdates;
    private async Task CheckUpdatesAsync()
    {
        _checkingUpdates = true;
        try
        {
            await Api.CheckRunnerUpdatesAsync(RunnerId);
            // A refresh started before the accepted check may still return the old cached status.
            ++_runnerLoadVersion;
            if (_runner is not null) _runner = _runner with { Updates = (_runner.Updates ?? new RunnerUpdatesDto([])) with { Checking = true } };
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
        catch (HttpRequestException) { Snackbar.Add(LoadingSection.Unreachable, Severity.Error); }
        finally { _checkingUpdates = false; }
    }

    private async Task UpdateSystemPackagesAsync()
    {
        _waitingFor.Add("update");
        await RunAsync(() => Api.UpdateSystemPackagesAsync(RunnerId));
    }

    private async Task UpdateHarnessAsync(HarnessDto harness)
    {
        _waitingFor.Add("update");
        await RunAsync(() => Api.UpdateHarnessAsync(RunnerId, harness.Id));
    }

    private bool _refreshing;

    private async Task RefreshDetailsAsync()
    {
        _refreshing = true;
        try
        {
            await Api.RefreshRunnerDetailsAsync(RunnerId);
            Snackbar.Add("Details read from the Runner.", Severity.Success);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _refreshing = false;
        }
    }

    private RunnerToolDto? Tool(string toolId) => _info?.Tools.FirstOrDefault(t => t.Id == toolId);

    private async Task InstallToolAsync(RunnerToolDto tool, bool update)
    {
        _waitingFor.Add(update ? "update" : "install");
        await RunAsync(() => Api.InstallToolAsync(RunnerId, tool.Id, update));
    }

    private async Task InstallHarnessAsync(HarnessDto harness)
    {
        _waitingFor.Add("install");
        await RunAsync(() => Api.InstallHarnessAsync(RunnerId, harness.Id));
    }

    /// <summary>The result of an update or install started from this page.</summary>
    private void OnOperationFinished(OperationFinished finished)
    {
        if (finished.RunnerId != RunnerId || !_waitingFor.Remove(finished.Operation))
        {
            return;
        }

        var what = finished.Operation == "install" ? "Installing" : "Updating";
        _ = InvokeAsync(() => Snackbar.Add(finished.Error is null ? $"{what} finished on '{finished.RunnerName}'." : $"{what} failed: {finished.Error}",
            finished.Error is null ? Severity.Success : Severity.Error));
    }

    private async Task NewAgentAsync() =>
        await Dialogs.ShowAsync<NewAgentDialog>("New agent", new DialogParameters<NewAgentDialog> { { d => d.RunnerId, RunnerId } });

    private async Task ForgetHostKeyAsync()
    {
        try
        {
            await Api.ForgetHostKeyAsync(RunnerId);
            Snackbar.Add("Host key forgotten. The next connection trusts the key it sees.", Severity.Info);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync()
    {
        var provider = _info?.Providers.FirstOrDefault(p => p.Id == _runner!.ProviderId);
        var destroys = provider?.Capabilities.CanDestroy == true && _runner!.MachineId is not null;
        var message = destroys
            ? $"This deletes VM {_runner!.MachineId} and its disks on {provider!.DisplayName}, including every agent and all work on it that was not pushed."
            : "The Runner is removed from the Manager and its agents are stopped. The machine itself is left alone.";
        var confirmed = await Dialogs.ShowMessageBoxAsync($"Delete '{_runner!.Name}'?", message, yesText: destroys ? "Delete VM" : "Remove", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteRunnerAsync(RunnerId, destroyMachine: true);
            Snackbar.Add($"Deleting '{_runner.Name}'...", Severity.Info);
            Navigation.NavigateTo("runners");
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    public override void Dispose()
    {
        Live.OperationFinished -= OnOperationFinished;
        base.Dispose();
    }
}
