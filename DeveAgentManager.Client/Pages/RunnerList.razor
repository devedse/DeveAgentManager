@page "/runners"
@inherits LiveComponent
@inject IDialogService Dialogs
@inject SignedInUser Me

<PageTitle>Runners · DeveAgentManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="page">
    <PageHeader Title="Runners" Subtitle="The machines you can use for agents: yours, and those others gave you access to.">
        <Actions>
            @if (CanCreate)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.AddToQueue" OnClick="NewRunnerAsync">New Runner</MudButton>
            }
        </Actions>
    </PageHeader>

    @if (Loaded && _runners.Count == 0 && CanCreate)
    {
        <div class="panel">
            <EmptyState Icon="@Icons.Material.Rounded.Dns" Title="No Runners yet" Text="A Runner is a VM cloned from your Proxmox template (or a machine you already have), set up with tmux, Node and the harnesses.">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.AddToQueue" OnClick="NewRunnerAsync">Create your first Runner</MudButton>
            </EmptyState>
        </div>
    }
    else if (Loaded && _runners.Count == 0)
    {
        <div class="panel">
            <EmptyState Icon="@Icons.Material.Rounded.Dns" Title="No Runner yet" Text="Agents run on Runners. Ask a runner manager to give you access to one." />
        </div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var runner in _runners)
            {
                var status = runner.Status;
                var operation = runner.Operation;
                var provider = _info?.Providers.FirstOrDefault(p => p.Id == runner.ProviderId);
                <a class="runner-card" href="runners/@runner.Id">
                    <div class="runner-card-header">
                        <div class="runner-card-icon">
                            <MudIcon Icon="@(runner.Kind == RunnerKind.Desktop ? Icons.Material.Rounded.DesktopWindows : Icons.Material.Rounded.Dns)" />
                        </div>
                        <div class="runner-card-titles">
                            <div class="runner-card-name">@runner.Name</div>
                            <div class="runner-card-provider">@(provider?.DisplayName ?? runner.ProviderId)@(runner.MachineId is not null && runner.ProviderId != "existing" ? $" · VM {runner.MachineId}" : "")</div>
                        </div>
                        <StatusPill Style="StateStyles.For(runner.State)" Text="@operation" />
                    </div>

                    @if (runner.State == RunnerState.Error && runner.StateMessage is not null)
                    {
                        <div class="runner-card-error">@runner.StateMessage</div>
                    }
                    else if (operation is not null || StateStyles.For(runner.State).Busy)
                    {
                        <div class="runner-card-progress">
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Size="Size.Small" />
                            <span>@(runner.StateMessage ?? operation)</span>
                        </div>
                    }

                    <div class="runner-card-facts">
                        <div><span class="fact-label">Address</span><span class="fact-value mono">@(runner.Host ?? "-")</span></div>
                        @if (runner.Cores > 0)
                        {
                            <div><span class="fact-label">Size</span><span class="fact-value">@runner.Cores CPU · @(runner.MemoryMb / 1024.0) GB · @runner.DiskGb GB</span></div>
                        }
                        <div><span class="fact-label">Agents</span><span class="fact-value">@runner.Agents.Count(a => a.State == AgentState.Running) running · @runner.Agents.Count total</span></div>
                        @if (runner.OwnerId != _user?.Id)
                        {
                            <div><span class="fact-label">Owner</span><span class="fact-value">@runner.OwnerName</span></div>
                        }
                    </div>

                    @if (runner.State == RunnerState.Ready && status is { CpuUsage: not null })
                    {
                        <UsageBars Status="status" />
                    }

                    @if (runner.InstalledVersions is not null)
                    {
                        <div class="runner-card-versions">@runner.InstalledVersions</div>
                    }
                </a>
            }
        </div>
    }
</MudContainer>

@code {
    private ManagerInfoDto? _info;
    private CurrentUserDto? _user;
    private List<RunnerDto> _runners = [];

    private bool CanCreate => _user?.Has(UserRoles.RunnerCreator) == true;

    protected override async Task LoadAsync()
    {
        _user = await Me.GetAsync();
        _info ??= await Api.InfoAsync();
        _runners = await Api.ListRunnersAsync();
    }

    private Task NewRunnerAsync() => Dialogs.ShowAsync<NewRunnerDialog>();
}
