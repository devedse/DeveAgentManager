@page "/password"
@layout EmptyLayout
@attribute [ExcludeFromInteractiveRouting]
@inject IHttpContextAccessor Http

<PageTitle>@Title · DeveAgentManager</PageTitle>

@* A page of the Manager itself (not the Portal app), so it also works while a new password is required before anything else. *@
<div class="login-page">
    <div class="login-glow"></div>
    <form method="post" action="account/password" class="login-card">
        <AntiforgeryToken />
        <div class="login-brand">
            <img src="favicon.svg" alt="" width="44" height="44" />
            <div>
                <div class="login-title">@Title</div>
                <div class="login-subtitle">@_user?.DisplayName (@_user?.Username)</div>
            </div>
        </div>

        @if (_user?.MustChangePassword == true)
        {
            <div class="login-hint login-hint-top">Choose a password of your own before you continue. Your current password is the one you just signed in with.</div>
        }

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="login-error">@Error</div>
        }

        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <input type="hidden" name="username" autocomplete="username" value="@_user?.Username" />
        <label class="login-label" for="current">Current password</label>
        <input class="login-input" id="current" name="currentPassword" type="password" autocomplete="current-password" required autofocus />
        <label class="login-label" for="new">New password</label>
        <input class="login-input" id="new" name="newPassword" type="password" autocomplete="new-password" minlength="@DeveAgentManager.Core.Users.UserService.MinPasswordLength" required />
        <label class="login-label" for="confirm">New password again</label>
        <input class="login-input" id="confirm" name="confirmPassword" type="password" autocomplete="new-password" minlength="@DeveAgentManager.Core.Users.UserService.MinPasswordLength" required />
        <div class="login-note">At least @DeveAgentManager.Core.Users.UserService.MinPasswordLength characters. Your other sign-ins end; this one continues.</div>
        <button type="submit" class="login-button">Change password</button>
        @if (_user?.MustChangePassword != true)
        {
            <a class="login-link" href="@(DeveAgentManager.Api.SignIn.LocalUrl(ReturnUrl))">Cancel</a>
        }
    </form>
    <form method="post" action="account/logout" class="login-signout">
        <AntiforgeryToken />
        <button type="submit" class="login-link">Sign out</button>
    </form>
</div>

@code {
    private DeveAgentManager.Core.Users.CurrentUser? _user;

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private string Title => _user?.MustChangePassword == true ? "Choose a new password" : "Change password";

    protected override void OnInitialized() => _user = DeveAgentManager.Api.SignIn.Current(Http.HttpContext);
}
