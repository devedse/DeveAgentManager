@page "/settings"
@inject RunnerService Runners
@inject AgentService Agents
@inject RunnerSetupService Setup
@inject SettingsStore Settings
@inject ManagerSshKey SshKey
@inject ManagerOptions Options
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<PageTitle>Settings · DeveAgentManager</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="page">
    <PageHeader Title="Settings" Subtitle="Values set in the compose file are shown read-only. Everything else is stored encrypted in /data." />

    <div class="panel panel-flush">
        <MudTabs Elevation="0" ApplyEffectsToContainer="true" Class="panel-tabs" TabPanelsClass="panel-tab-content" KeepPanelsAlive="true">
            <MudTabPanel Text="Providers" Icon="@Icons.Material.Rounded.Cloud">
                @foreach (var provider in Runners.Providers.OrderBy(p => p.Capabilities.RequiresConnectionDetails))
                {
                    <div class="settings-section">
                        <div class="settings-section-header">
                            <div>
                                <MudText Typo="Typo.h6">@provider.DisplayName</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    @(provider.Capabilities.RequiresConnectionDetails ? "Add a Linux machine you already have. Nothing to configure." : "Clones Runners from a template VM over the Proxmox API.")
                                </MudText>
                            </div>
                            <StatusPill Style="@(provider.IsConfigured ? new StateStyle("Configured", Tone.Success) : new StateStyle("Not configured", Tone.Warning))" />
                        </div>

                        @if (provider.GetSettings() is { Count: > 0 } providerSettings)
                        {
                            <dl class="details details-wide">
                                @foreach (var setting in providerSettings)
                                {
                                    <dt class="mono">@setting.Name</dt>
                                    <dd class="mono">@(setting.Value ?? "(not set)")</dd>
                                }
                            </dl>
                        }

                        <div class="settings-actions">
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Rounded.NetworkCheck" Disabled="_checking.Contains(provider.Id)" OnClick="() => CheckAsync(provider)">
                                @(_checking.Contains(provider.Id) ? "Testing..." : "Test connection")
                            </MudButton>
                        </div>

                        @if (_checks.TryGetValue(provider.Id, out var checks))
                        {
                            <div class="check-list">
                                @foreach (var check in checks)
                                {
                                    <div class="check check-@check.Status.ToString().ToLowerInvariant()">
                                        <MudIcon Size="Size.Small" Icon="@(check.Status switch { CheckStatus.Ok => Icons.Material.Rounded.CheckCircle, CheckStatus.Warning => Icons.Material.Rounded.Warning, _ => Icons.Material.Rounded.Cancel })" />
                                        <div>
                                            <div class="check-name">@check.Name</div>
                                            <div class="check-message">@check.Message</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </MudTabPanel>

            <MudTabPanel Text="Setup Profile" Icon="@Icons.Material.Rounded.Checklist">
                @if (_profile is not null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                        Applied to every Runner when it is set up, and again when you use <b>Re-run setup</b>: git identity, API keys, login and settings files (pi plugins), and a script.
                    </MudText>

                    <div class="settings-section">
                        <MudText Typo="Typo.subtitle1" Class="section-title">Git identity</MudText>
                        <div class="form-row">
                            <MudTextField @bind-Value="_profile.GitUserName" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            <MudTextField @bind-Value="_profile.GitUserEmail" Label="Email" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        </div>
                    </div>

                    <div class="settings-section">
                        <div class="section-title-row">
                            <MudText Typo="Typo.subtitle1" Class="section-title">Environment variables</MudText>
                            <MudSwitch T="bool" @bind-Value="_showSecrets" Color="Color.Primary" Label="Show values" Size="Size.Small" />
                        </div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Available to every agent, for example <code>ANTHROPIC_API_KEY</code> or <code>OPENAI_API_KEY</code> for pi.</MudText>
                        @foreach (var variable in _profile.EnvironmentVariables)
                        {
                            <div class="form-row form-row-center">
                                <MudTextField @bind-Value="variable.Name" Placeholder="NAME" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mono-input env-name" />
                                <MudTextField @bind-Value="variable.Value" Placeholder="value" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="@(_showSecrets ? InputType.Text : InputType.Password)" Class="flex-grow-1 mono-input" />
                                <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="() => _profile.EnvironmentVariables.Remove(variable)" aria-label="Remove" />
                            </div>
                        }
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.Add" Size="Size.Small" OnClick="() => _profile.EnvironmentVariables.Add(new SetupEnvironmentVariable())">Add variable</MudButton>
                    </div>

                    <div class="settings-section">
                        <MudText Typo="Typo.subtitle1" Class="section-title">Files</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                            Written to every Runner, e.g. <code>~/.pi/agent/settings.json</code> with your pi packages or <code>~/.pi/agent/AGENTS.md</code> with your instructions.
                        </MudText>

                        <div class="import-box">
                            <MudIcon Icon="@Icons.Material.Rounded.Download" Color="Color.Primary" />
                            <div class="import-text">
                                <div class="check-name">Import a login from a Runner</div>
                                <div class="check-message">Log in once in a Runner's terminal (for pi: <code>/login</code>), then copy that login and settings here.</div>
                            </div>
                            <MudSelect T="Guid?" @bind-Value="_importRunnerId" Label="Runner" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="import-select">
                                @foreach (var runner in _readyRunners)
                                {
                                    <MudSelectItem T="Guid?" Value="runner.Id">@runner.Name</MudSelectItem>
                                }
                            </MudSelect>
                            <MudSelect T="string" @bind-Value="_importHarnessId" Label="Harness" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="import-select">
                                @foreach (var harness in Agents.Harnesses)
                                {
                                    <MudSelectItem Value="harness.Id">@harness.DisplayName</MudSelectItem>
                                }
                            </MudSelect>
                            <MudButton Variant="Variant.Outlined" Disabled="_importRunnerId is null || _importHarnessId is null || _importing" OnClick="ImportAsync">
                                @(_importing ? "Importing..." : "Import")
                            </MudButton>
                        </div>

                        @foreach (var file in _profile.Files)
                        {
                            <div class="file-card">
                                <div class="form-row form-row-center">
                                    <MudTextField @bind-Value="file.Path" Label="Path on the Runner" Placeholder="~/.pi/agent/settings.json" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1 mono-input" />
                                    <MudTextField @bind-Value="file.Mode" Label="Mode" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mode-field mono-input" />
                                    <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="() => _profile.Files.Remove(file)" aria-label="Remove" />
                                </div>
                                <MudTextField @bind-Value="file.Content" Label="Content" Variant="Variant.Outlined" Lines="6" MaxLines="24" Class="mono-input mt-2" />
                            </div>
                        }
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.Add" Size="Size.Small" OnClick="() => _profile.Files.Add(new SetupFile())">Add file</MudButton>
                    </div>

                    <div class="settings-section">
                        <MudText Typo="Typo.subtitle1" Class="section-title">Script</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Bash, run as the Runner Account at the end of setup. For example <code>pi install npm:some-package</code> or <code>sudo apt-get install -y dotnet-sdk-10.0</code>.</MudText>
                        <MudTextField @bind-Value="_profile.Script" Variant="Variant.Outlined" Lines="6" MaxLines="30" Placeholder="#!/usr/bin/env bash" Class="mono-input" />
                    </div>

                    <div class="settings-actions sticky-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Save" Disabled="_saving" OnClick="SaveProfileAsync">Save Setup Profile</MudButton>
                    </div>
                }
            </MudTabPanel>

            <MudTabPanel Text="GitHub" Icon="@Icons.Custom.Brands.GitHub">
                <div class="settings-section">
                    <MudText Typo="Typo.subtitle1" Class="section-title">Personal access token</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        Used on Runners to clone and push private repositories. Prefer a fine-grained token limited to the repositories agents may work on,
                        because agents can read it. Applied on the next setup of each Runner.
                    </MudText>
                    @if (Settings.GitHubPatFromCompose)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">Set with <code>GITHUB_PAT</code> in the compose file.</MudAlert>
                    }
                    else
                    {
                        <div class="form-row form-row-center">
                            <MudTextField @bind-Value="_pat" Label="Token" Placeholder="@(_hasPat ? "•••••••• (saved; enter a new one to replace it)" : "github_pat_...")" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          InputType="InputType.Password" Class="flex-grow-1 mono-input" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving || string.IsNullOrWhiteSpace(_pat)" OnClick="SavePatAsync">Save</MudButton>
                            @if (_hasPat)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="_saving" OnClick="RemovePatAsync">Remove</MudButton>
                            }
                        </div>
                    }
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Manager" Icon="@Icons.Material.Rounded.Info">
                <div class="settings-section">
                    <MudText Typo="Typo.subtitle1" Class="section-title">SSH key</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">The Manager logs in to Runners with this key. It is injected into new VMs automatically; add it to <code>~/.ssh/authorized_keys</code> to use a machine without a password.</MudText>
                    <div class="code-box">
                        <code>@SshKey.PublicKey</code>
                        <MudIconButton Icon="@Icons.Material.Rounded.ContentCopy" Size="Size.Small" OnClick="CopyKeyAsync" aria-label="Copy" />
                    </div>
                </div>
                <div class="settings-section">
                    <MudText Typo="Typo.subtitle1" Class="section-title">Configuration</MudText>
                    <dl class="details details-wide">
                        <dt class="mono">RUNNER_USERNAME</dt>
                        <dd class="mono">@Options.RunnerUsername</dd>
                        <dt class="mono">RUNNER_PASSWORD</dt>
                        <dd class="mono">••••••••</dd>
                        <dt class="mono">ADMIN_USERNAME</dt>
                        <dd class="mono">@Options.AdminUsername</dd>
                        <dt class="mono">RUNNER_DEFAULT_*</dt>
                        <dd>@Options.DefaultCores CPU · @(Options.DefaultMemoryMb / 1024) GB RAM · @Options.DefaultDiskGb GB disk</dd>
                        <dt class="mono">DATA_DIR</dt>
                        <dd class="mono">@Options.DataDirectory</dd>
                    </dl>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">Back up the data folder: it holds the database, the SSH key and the keys that decrypt the stored secrets.</MudText>
                </div>
            </MudTabPanel>
        </MudTabs>
    </div>
</MudContainer>

@code {
    private readonly HashSet<string> _checking = [];
    private readonly Dictionary<string, IReadOnlyList<ProviderCheck>> _checks = [];
    private SetupProfile? _profile;
    private List<Runner> _readyRunners = [];
    private Guid? _importRunnerId;
    private string? _importHarnessId;
    private bool _importing;
    private bool _showSecrets;
    private bool _saving;
    private string? _pat;
    private bool _hasPat;

    protected override async Task OnInitializedAsync()
    {
        _profile = await Settings.GetSetupProfileAsync();
        _hasPat = await Settings.GetGitHubPatAsync() is not null;
        _readyRunners = (await Runners.ListAsync()).Where(r => r.State == RunnerState.Ready).ToList();
        _importRunnerId = _readyRunners.FirstOrDefault()?.Id;
        _importHarnessId = Agents.Harnesses.FirstOrDefault()?.Id;
    }

    private async Task CheckAsync(IRunnerProvider provider)
    {
        _checking.Add(provider.Id);
        try
        {
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(60));
            _checks[provider.Id] = await provider.CheckAsync(timeout.Token);
        }
        catch (Exception ex)
        {
            _checks[provider.Id] = [new ProviderCheck("Test", CheckStatus.Failed, ex.Message)];
        }
        finally
        {
            _checking.Remove(provider.Id);
        }
    }

    private async Task SaveProfileAsync()
    {
        _saving = true;
        try
        {
            await Settings.SaveSetupProfileAsync(_profile!);
            _profile = await Settings.GetSetupProfileAsync();
            Snackbar.Add("Setup Profile saved. It is applied the next time a Runner is set up.", Severity.Success);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ImportAsync()
    {
        var runner = _readyRunners.First(r => r.Id == _importRunnerId);
        _importing = true;
        try
        {
            var imported = await Setup.ImportHarnessFilesAsync(runner, _importHarnessId!);
            if (imported.Count == 0)
            {
                Snackbar.Add($"No login or settings files found on '{runner.Name}'. Log in there first.", Severity.Warning);
                return;
            }

            // Keep unsaved edits to the rest of the profile, but take the imported files.
            var saved = await Settings.GetSetupProfileAsync();
            _profile!.Files.RemoveAll(f => imported.Contains(f.Path));
            _profile.Files.AddRange(saved.Files.Where(f => imported.Contains(f.Path)));
            Snackbar.Add($"Imported {string.Join(", ", imported)} from '{runner.Name}'.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _importing = false;
        }
    }

    private async Task SavePatAsync()
    {
        _saving = true;
        try
        {
            await Settings.SaveGitHubPatAsync(_pat);
            _pat = null;
            _hasPat = true;
            Snackbar.Add("GitHub token saved. Use Re-run setup on existing Runners to apply it.", Severity.Success);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemovePatAsync()
    {
        await Settings.SaveGitHubPatAsync(null);
        _hasPat = false;
        Snackbar.Add("GitHub token removed.", Severity.Info);
    }

    private async Task CopyKeyAsync()
    {
        await JS.InvokeVoidAsync("damUi.copy", SshKey.PublicKey);
        Snackbar.Add("Public key copied.", Severity.Success);
    }
}
