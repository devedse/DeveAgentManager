@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Sign in · DeveAgentManager</PageTitle>

<div class="login-page">
    <div class="login-glow"></div>
    <form method="post" action="account/login" class="login-card">
        <AntiforgeryToken />
        <div class="login-brand">
            <img src="favicon.svg" alt="" width="44" height="44" />
            <div>
                <div class="login-title">Deve<span class="brand-accent">AgentManager</span></div>
                <div class="login-subtitle">Coding agents on your own machines</div>
            </div>
        </div>

        @if (Failed)
        {
            <div class="login-error">Wrong username or password, or too many attempts: wait a few minutes.</div>
        }

        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        <label class="login-label" for="username">Username</label>
        <input class="login-input" id="username" name="username" autocomplete="username" autocapitalize="none" required autofocus />
        <label class="login-label" for="password">Password</label>
        <input class="login-input" id="password" name="password" type="password" autocomplete="current-password" required />
        <div class="help-heading login-label-row">
            <label class="login-label" for="code">Authenticator code</label>
            <StaticHelpTip Label="Authenticator code">
                <p>Only if you turned on an authenticator app under Account security: the six-digit code from the app, or one of
                your recovery codes. Otherwise leave it empty.</p>
            </StaticHelpTip>
        </div>
        <input class="login-input" id="code" name="code" autocomplete="one-time-code" />
        <label class="login-remember">
            <input type="checkbox" name="remember" checked />
            <span>Keep me signed in</span>
        </label>
        <button type="submit" class="login-button">Sign in</button>

        <div class="login-note">On first start, use the setup code from the Manager's startup log as the initial password.</div>
    </form>
</div>

@code {


    [SupplyParameterFromQuery(Name = "failed")]
    private string? FailedValue { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    private string? ReturnUrl { get; set; }

    private bool Failed => FailedValue == "1";


}
