@* The Portal's HelpTip (?) for the Manager's own static pages (sign-in, account security), which run no Blazor in the
   browser: a native popover, opened by tap, click or keyboard and closed by Esc or a click elsewhere. *@
<span class="help-tip">
    <button type="button" class="static-help-button" popovertarget="@_id" aria-label="@($"Help about {Label}")">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" /></svg>
    </button>
    <div id="@_id" popover="auto" class="static-help-popover" role="tooltip">
        <div class="static-help-title">@Label</div>
        @ChildContent
    </div>
</span>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private readonly string _id = "help-" + Guid.NewGuid().ToString("N")[..8];
}
