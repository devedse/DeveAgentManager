@* Packages, default model and extra settings for one harness (Setup Profile). Sections a harness doesn't have are left out. *@

@if (Support.HasPackages)
{
<div class="settings-section">
    <MudText Typo="Typo.subtitle1" Class="section-title">Packages</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        Installed on every Runner with <code>@(Harness.Id) install</code>: extensions, skills, prompt templates and themes.
        Packages you remove here are removed from the Runners too. Browse packages on <a href="@Support.DocsUrl" target="_blank" rel="noopener">@Support.DocsUrl.Replace("https://", "")</a>.
        Running agents load new packages after a restart (or <code>/reload</code> in pi).
    </MudText>

    @for (var i = 0; i < Config.Packages.Count; i++)
    {
        var index = i;
        <div class="form-row form-row-center">
            <MudTextField T="string" Value="Config.Packages[index]" ValueChanged="value => Config.Packages[index] = value" Placeholder="@Support.PackageExample"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1 mono-input" />
            <MudIconButton Icon="@Icons.Material.Rounded.Close" Size="Size.Small" OnClick="() => Config.Packages.RemoveAt(index)" aria-label="Remove" />
        </div>
    }
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.Add" Size="Size.Small" OnClick="() => Config.Packages.Add(string.Empty)">Add package</MudButton>

    @if (Support.SuggestedPackages.Where(p => !Config.Packages.Contains(p.Source)).ToList() is { Count: > 0 } suggestions)
    {
        <div class="package-suggestions">
            <span class="mud-text-secondary">Add:</span>
            @foreach (var suggestion in suggestions)
            {
                <MudTooltip Text="@suggestion.Description">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Rounded.Add" OnClick="() => Config.Packages.Add(suggestion.Source)">
                        <span class="mono">@suggestion.Source</span>
                    </MudChip>
                </MudTooltip>
            }
        </div>
    }
</div>

}

<div class="settings-section">
    <MudText Typo="Typo.subtitle1" Class="section-title">Default model</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        What new agents start with. <b>Leave empty to let @Harness.DisplayName choose</b>: it picks what fits your plan and moves on to new models by itself.
        @if (Support.ModelSuggestions is { Count: > 0 })
        {
            <span>Aliases like <code>@Support.ModelSuggestions[0]</code> always mean the latest model of that family.</span>
        }
        You can still switch in a session (<code>/model</code>).
    </MudText>
    <div class="form-row">
        @if (Support.HasProvider)
        {
            <MudTextField @bind-Value="Config.DefaultProvider" Label="Provider" Placeholder="anthropic" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1 mono-input" />
        }
        <MudAutocomplete T="string" @bind-Value="Config.DefaultModel" Label="Model" Placeholder="@($"{Harness.DisplayName} chooses")" SearchFunc="SearchModelsAsync"
                         CoerceValue="true" CoerceText="false" Clearable="true" ResetValueOnEmptyText="true" MaxItems="50" Strict="false"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1 mono-input"
                         HelperText="@(ModelsLoading ? "Loading the models from a Runner..." : Models.Count > 0 ? $"{Models.Count} models offered by {Harness.DisplayName} on your Runner, or type any name." : null)">
            <ItemTemplate Context="model">
                <span class="mono">@model</span>
                @if (Models.FirstOrDefault(m => m.Id == model) is { } choice && choice.Name != model)
                {
                    <span class="mud-text-secondary"> · @choice.Name</span>
                }
            </ItemTemplate>
        </MudAutocomplete>
        <MudSelect T="string" @bind-Value="Config.DefaultThinkingLevel" Label="@Support.EffortName" Placeholder="Default" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="thinking-select">
            @foreach (var level in EffortLevels)
            {
                <MudSelectItem Value="level">@level@(SelectedModel?.DefaultEffort == level ? " (model default)" : "")</MudSelectItem>
            }
        </MudSelect>
    </div>
</div>

@if (Support.HasExtraSettings)
{
<div class="settings-section">
    <MudText Typo="Typo.subtitle1" Class="section-title">Extra settings</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        JSON merged into <code>@Support.SettingsFile</code> on every Runner: objects are merged, other values replaced, settings you don't list are kept.
        For example <code>@Support.SettingsExample</code>@(Support.HasPackages ? " or a package's own settings" : "").
    </MudText>
    <MudTextField @bind-Value="Config.Settings" Variant="Variant.Outlined" Lines="5" MaxLines="30" Placeholder="{ }" Class="mono-input"
                  Error="@(SettingsError is not null)" ErrorText="@SettingsError" Immediate="true" DebounceInterval="400" />
</div>

}

@if (Support.HasKeybindings)
{
<div class="settings-section">
    <MudText Typo="Typo.subtitle1" Class="section-title">Keybindings</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        JSON merged into <code>@Support.KeybindingsFile</code>, like <code>{ "app.clipboard.pasteImage": [] }</code>.
        With <code>@@pi-archimedes/image-paste</code> in the packages, pi's own image paste binding is cleared automatically (as that package asks), unless you set it here.
    </MudText>
    <MudTextField @bind-Value="Config.Keybindings" Variant="Variant.Outlined" Lines="3" MaxLines="20" Placeholder="{ }" Class="mono-input"
                  Error="@(KeybindingsError is not null)" ErrorText="@KeybindingsError" Immediate="true" DebounceInterval="400" />
</div>

}

@code {
    [Parameter, EditorRequired]
    public IHarness Harness { get; set; } = default!;

    [Parameter, EditorRequired]
    public HarnessConfig Config { get; set; } = default!;

    private HarnessConfigSupport Support => Harness.ConfigSupport!;

    /// <summary>The models the harness offers (its catalog on a Runner), besides <see cref="HarnessConfigSupport.ModelSuggestions"/>.</summary>
    [Parameter]
    public IReadOnlyList<ModelChoice> Models { get; set; } = [];

    [Parameter]
    public bool ModelsLoading { get; set; }

    private ModelChoice? SelectedModel => Models.FirstOrDefault(m => m.Id == Config.DefaultModel);

    private IReadOnlyList<string> EffortLevels => SelectedModel is { Efforts.Count: > 0 } model ? model.Efforts : Support.ThinkingLevels;

    private Task<IEnumerable<string>> SearchModelsAsync(string? text, CancellationToken cancellationToken)
    {
        var all = (Support.ModelSuggestions ?? []).Concat(Models.Select(m => m.Id)).Distinct();
        return Task.FromResult(string.IsNullOrWhiteSpace(text) ? all : all.Where(m => m.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase)));
    }

    private string? SettingsError => Check(new HarnessConfig { Settings = Config.Settings });

    private string? KeybindingsError => Check(new HarnessConfig { Keybindings = Config.Keybindings });

    private static string? Check(HarnessConfig config)
    {
        try
        {
            config.Validate();
            return null;
        }
        catch (ArgumentException ex)
        {
            return ex.Message;
        }
    }
}
