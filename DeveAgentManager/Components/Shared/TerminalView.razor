@using System.Text
@implements IAsyncDisposable
@inject TerminalService Terminals
@inject AgentService AgentService
@inject IJSRuntime JS
@inject ILogger<TerminalView> Logger
@inject ISnackbar Snackbar

<div class="terminal-frame">
    <div class="terminal-host">
        <Xterm @ref="_xterm" Options="_options" Addons="_addons" Class="terminal-xterm"
               OnFirstRender="OnFirstRenderAsync" OnData="OnData" OnBinary="OnBinary" OnResize="OnResize" OnTitleChange="OnTitleChange" />
    </div>

    @if (_overlay is not null)
    {
        <div class="terminal-overlay">
            <div class="terminal-overlay-card">
                @if (_connecting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                }
                else
                {
                    <MudIcon Icon="@(_error ? Icons.Material.Rounded.ErrorOutline : Icons.Material.Rounded.LinkOff)" Color="@(_error ? Color.Error : Color.Default)" />
                }
                <MudText Typo="Typo.body2">@_overlay</MudText>
                @if (!_connecting)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="ReconnectAsync">Reconnect</MudButton>
                }
            </div>
        </div>
    }
</div>

@* On-screen keys for phones and tablets: one row that always fits (no scrolling), the keys pi needs most first. *@
<div class="terminal-keys">
    @foreach (var (label, sequence, title) in Keys)
    {
        <button type="button" class="terminal-key" title="@title" aria-label="@title" @onclick="() => SendAsync(sequence)" @onclick:preventDefault="true">@label</button>
    }
    @* Opened in the browser (terminal.js), so the file picker runs in the tap itself: browsers only open it for a user action. *@
    <button type="button" class="terminal-key" data-dam-action="image" title="Send an image (screenshot, photo)" aria-label="Send an image">
        <MudIcon Icon="@Icons.Material.Rounded.AttachFile" Size="Size.Small" />
    </button>
    <button type="button" class="terminal-key @(_touchInput ? "terminal-key-on" : "")"
            title="@(_touchInput ? "Phone keyboard fix is on: autocorrect, swipe typing and Backspace work as in other apps. Tap to type straight into the terminal." : "Phone keyboard fix is off. Tap to turn it on.")"
            aria-label="Phone keyboard fix" aria-pressed="@(_touchInput ? "true" : "false")"
            @onclick="ToggleTouchInputAsync" @onclick:preventDefault="true">
        <MudIcon Icon="@(_touchInput ? Icons.Material.Rounded.Keyboard : Icons.Material.Rounded.KeyboardHide)" Size="Size.Small" />
    </button>
</div>

@code {
    // On-screen keys for phones and tablets, where these are hard or impossible to type.
    private static readonly (string Label, string Sequence, string Title)[] Keys =
    [
        ("Esc", "\u001b", "Escape"), ("Tab", "\t", "Tab"), ("^C", "\u0003", "Ctrl+C"),
        ("←", "\u001b[D", "Left"), ("↑", "\u001b[A", "Up"), ("↓", "\u001b[B", "Down"), ("→", "\u001b[C", "Right"),
        ("⇧⏎", "\u001b[13;2u", "New line (Shift+Enter)"), ("⏎", "\r", "Enter"),
    ];

    private readonly HashSet<string> _addons = ["addon-fit", "addon-web-links"];
    private readonly TerminalOptions _options = new()
    {
        CursorBlink = true,
        CursorStyle = CursorStyle.Bar,
        FontFamily = AppTheme.MonoFont,
        FontSize = 14,
        Scrollback = 10000,
        AllowProposedApi = true,
        MacOptionIsMeta = true,
        Theme = new Theme
        {
            Background = "#0a0d13",
            Foreground = "#d8dee9",
            Cursor = "#8b7dff",
            CursorAccent = "#0a0d13",
            SelectionBackground = "#8b7dff55",
            Black = "#1b2130", BrightBlack = "#4b5467",
            Red = "#f87171", BrightRed = "#fca5a5",
            Green = "#34d399", BrightGreen = "#6ee7b7",
            Yellow = "#fbbf24", BrightYellow = "#fcd34d",
            Blue = "#60a5fa", BrightBlue = "#93c5fd",
            Magenta = "#c084fc", BrightMagenta = "#d8b4fe",
            Cyan = "#2dd4bf", BrightCyan = "#5eead4",
            White = "#d8dee9", BrightWhite = "#f8fafc",
        },
    };

    private Xterm _xterm = default!;
    private bool _touchInput;
    private static readonly byte[] KickedMarker = Encoding.UTF8.GetBytes(AgentService.KickedMarker);

    private bool _detachedElsewhere;
    private bool _kicked;
    private bool _reportedConnected;
    private bool _sizeClaimed;
    private DotNetObjectReference<TerminalView>? _self;
    private TerminalConnection? _connection;
    private CancellationTokenSource _lifetime = new();
    private string? _overlay = "Connecting...";
    private bool _connecting = true;
    private bool _error;

    /// <summary>Attach to this agent's tmux session.</summary>
    [Parameter]
    public Guid? AgentId { get; set; }

    /// <summary>Or open a plain shell on this Runner.</summary>
    [Parameter]
    public Guid? RunnerId { get; set; }

    /// <summary>With <see cref="RunnerId"/>: run this command instead of a shell (e.g. a harness's login).</summary>
    [Parameter]
    public string? Command { get; set; }

    /// <summary>Tell the program when the terminal is resized. Off for programs that were given a size of their own.</summary>
    [Parameter]
    public bool ForwardResize { get; set; } = true;

    /// <summary>Everything the program prints, as text (with its escape sequences).</summary>
    [Parameter]
    public EventCallback<string> OutputReceived { get; set; }

    [Parameter]
    public EventCallback<string> TitleChanged { get; set; }

    [Parameter]
    public EventCallback Disconnected { get; set; }

    /// <summary>Raised once the terminal is attached and its <see cref="Tty"/> is known.</summary>
    [Parameter]
    public EventCallback Connected { get; set; }

    /// <summary>This terminal's tty on the Runner (e.g. /dev/pts/3): tells it apart from the agent's other viewers.</summary>
    public string? Tty => _connection?.Tty;

    public async Task SendAsync(string data)
    {
        // Through the browser, so the phone keyboard input knows the line changed; it arrives back in OnData.
        await JS.InvokeVoidAsync("damTerminal.sendKey", _xterm.Id, data);
    }

    private async Task ToggleTouchInputAsync()
    {
        _touchInput = await JS.InvokeAsync<bool>("damTerminal.toggleTouchInput", _xterm.Id);
    }

    public async Task ReconnectAsync()
    {
        CloseConnection();
        await _xterm.Reset();
        await ConnectAsync();
    }

    private async Task OnFirstRenderAsync()
    {
        _self = DotNetObjectReference.Create(this);
        _touchInput = await JS.InvokeAsync<bool>("damTerminal.init", _xterm.Id, _self);
        StateHasChanged();
        // Connecting to an agent takes it over from its other terminals, so a tab in the background (reloaded after a
        // Manager restart, say) waits until it is looked at instead of taking the agent away from the screen in use.
        try
        {
            // With a token, not the default one-minute timeout: a tab can stay in the background for hours.
            await JS.InvokeVoidAsync("damTerminal.whenVisible", _lifetime.Token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or JSDisconnectedException)
        {
            return;
        }

        await ConnectAsync();
    }

    private async Task ConnectAsync()
    {
        _detachedElsewhere = false;
        _kicked = false;
        _reportedConnected = false;
        _sizeClaimed = false;
        _overlay = "Connecting...";
        _connecting = true;
        _error = false;
        StateHasChanged();

        try
        {
            await JS.InvokeVoidAsync("damTerminal.fit", _xterm.Id);
            var columns = Math.Max(20, await _xterm.GetColumns());
            var rows = Math.Max(5, await _xterm.GetRows());
            var token = _lifetime.Token;
            _connection = AgentId is { } agentId
                ? await Terminals.OpenAgentAsync(agentId, columns, rows, token)
                : Command is { } command
                    ? await Terminals.OpenCommandAsync(RunnerId ?? throw new InvalidOperationException("Set RunnerId."), command, columns, rows, token)
                    : await Terminals.OpenShellAsync(RunnerId ?? throw new InvalidOperationException("Set AgentId or RunnerId."), columns, rows, token);

            _overlay = null;
            _connecting = false;
            var connection = _connection;
            _ = Task.Factory.StartNew(() => PumpAsync(connection, token), CancellationToken.None, TaskCreationOptions.LongRunning, TaskScheduler.Default).Unwrap();
            await JS.InvokeVoidAsync("damTerminal.focus", _xterm.Id);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogInformation(ex, "Could not open terminal");
            _overlay = ex.Message;
            _connecting = false;
            _error = true;
        }

        StateHasChanged();
    }

    private async Task PumpAsync(TerminalConnection connection, CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                var data = connection.Read();
                if (data.Length == 0)
                {
                    break;
                }

                // tmux's goodbye when another terminal took over the agent (attach -d)...
                _detachedElsewhere |= data.AsSpan().IndexOf("[detached (from session"u8) >= 0;
                // ...or what a terminal prints when another screen disconnected it (Viewers).
                if (data.AsSpan().IndexOf(KickedMarker) >= 0)
                {
                    _kicked = true;
                    data = Encoding.UTF8.GetBytes(Encoding.UTF8.GetString(data).Replace(AgentService.KickedMarker, ""));
                }

                if (!ReferenceEquals(connection, _connection))
                {
                    continue;
                }

                if (!_reportedConnected && connection.Tty is not null)
                {
                    _reportedConnected = true;
                    await InvokeAsync(() => Connected.InvokeAsync());
                }

                await InvokeAsync(async () =>
                {
                    await _xterm.Write(data);
                    if (OutputReceived.HasDelegate)
                    {
                        await OutputReceived.InvokeAsync(Encoding.UTF8.GetString(data));
                    }
                });
            }
        }
        catch (Exception ex) when (!token.IsCancellationRequested)
        {
            Logger.LogDebug(ex, "Terminal output stopped");
        }

        if (token.IsCancellationRequested || !ReferenceEquals(connection, _connection))
        {
            return;
        }

        try
        {
            await InvokeAsync(async () =>
            {
                _overlay = AgentId is null ? (Command is null ? "The shell was closed." : "Finished.")
                    : _kicked ? "Another screen disconnected this one. The agent keeps running; reconnect to continue here."
                    : _detachedElsewhere ? "This screen was disconnected from the agent (tmux detached it). Reconnect to continue here."
                    : "Disconnected from the agent. It keeps running on the Runner.";
                StateHasChanged();
                await Disconnected.InvokeAsync();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page was closed.
        }
    }

    /// <summary>
    /// An image was pasted, dropped or picked in the browser: store it on the Runner and return its path, which the browser
    /// then pastes into the terminal. Null when it failed (the reason is shown).
    /// </summary>
    [JSInvokable]
    public async Task<string?> UploadImageAsync(string fileName, string contentType, long size, IJSStreamReference data)
    {
        if (size > TerminalService.MaxImageBytes)
        {
            Snackbar.Add($"'{fileName}' is too big: images can be up to {TerminalService.MaxImageBytes / 1024 / 1024} MB.", Severity.Error);
            return null;
        }

        var progress = Snackbar.Add($"Uploading {DescribeImage(fileName, size)}...", Severity.Info, options => options.VisibleStateDuration = 60_000);
        try
        {
            await using var stream = await data.OpenReadStreamAsync(TerminalService.MaxImageBytes, _lifetime.Token);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer, _lifetime.Token);
            var path = await Terminals.UploadImageAsync(AgentId, RunnerId, contentType, buffer.ToArray(), _lifetime.Token);
            Logger.LogInformation("Pasted image {File} ({Bytes} bytes) as {Path}", fileName, size, path);
            return path;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogInformation(ex, "Could not upload image {File}", fileName);
            Snackbar.Add($"Could not send the image: {ex.Message}", Severity.Error);
            return null;
        }
        finally
        {
            if (progress is not null)
            {
                Snackbar.Remove(progress);
            }
        }
    }

    private static string DescribeImage(string fileName, long size) =>
        $"{(string.IsNullOrWhiteSpace(fileName) ? "image" : fileName)} ({(size >= 1024 * 1024 ? $"{size / 1024.0 / 1024.0:0.0} MB" : $"{Math.Max(1, size / 1024)} KB")})";

    private void OnData(string data)
    {
        var connection = _connection;
        connection?.Write(Encoding.UTF8.GetBytes(data));

        // A terminal that joined while others were attached only watches; typing here makes it set the size.
        if (AgentId is { } agentId && connection?.Tty is { } tty && !_sizeClaimed && !TerminalInput.IsTerminalReply(data))
        {
            _sizeClaimed = true;
            _ = ClaimSizeAsync(agentId, tty);
        }
    }

    private async Task ClaimSizeAsync(Guid agentId, string tty)
    {
        try
        {
            await AgentService.ClaimSizeAsync(agentId, tty, _lifetime.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogDebug(ex, "Could not give terminal {Tty} the size", tty);
            _sizeClaimed = false;
        }
    }

    private void OnBinary(string data) => _connection?.Write(Encoding.Latin1.GetBytes(data));

    private void OnResize(ResizeEventArgs size)
    {
        if (ForwardResize)
        {
            _connection?.Resize(size.Columns, size.Rows);
        }
    }

    private Task OnTitleChange(string title) => TitleChanged.InvokeAsync(title);

    private void CloseConnection()
    {
        var connection = _connection;
        _connection = null;
        connection?.Dispose();
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        CloseConnection();
        _lifetime.Dispose();
        _self?.Dispose();
        try
        {
            await JS.InvokeVoidAsync("damTerminal.dispose", _xterm.Id);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException)
        {
            // The browser is already gone, or this was the server-side prerender (no browser to talk to).
        }
    }
}
