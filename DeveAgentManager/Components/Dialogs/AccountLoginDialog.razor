@using System.Text
@using System.Text.RegularExpressions
@using DeveAgentManager.Core.Accounts
@inject AccountService Accounts
@inject RunnerService Runners
@inject ISnackbar Snackbar

@* Connects a harness account: log in with a subscription in a terminal on a Runner, paste a token, or enter an API key. *@
<MudDialog>
    <TitleContent>
        <div class="dialog-title">
            <MudIcon Icon="@Icons.Material.Rounded.Key" Color="Color.Primary" />
            <span>@(Existing is null ? $"Connect {Harness.DisplayName}" : $"Reconnect '{Existing.Name}'")</span>
        </div>
    </TitleContent>
    <DialogContent>
        <MudToggleGroup T="string" @bind-Value="_method" Color="Color.Primary" Size="Size.Small" Class="mb-4" CheckMark="false">
            <MudToggleItem Value="@("login")">Log in (subscription)</MudToggleItem>
            @if (Support.PasteHint is not null)
            {
                <MudToggleItem Value="@("paste")">Paste token</MudToggleItem>
            }
            <MudToggleItem Value="@("apikey")">API key</MudToggleItem>
        </MudToggleGroup>

        @if (Existing is null)
        {
            <MudTextField @bind-Value="_name" Label="Name" Placeholder="@(_method == "apikey" ? "API key" : "Personal")" HelperText="To tell accounts apart, e.g. Personal or Work."
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" Immediate="true" />
        }

        @switch (_method)
        {
            case "login":
                @if (_runners.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                        The login runs in a terminal on a Runner with @Harness.DisplayName. Install it on a ready Runner first (Runner → Operations).
                    </MudAlert>
                }
                else if (_loginCommand is null)
                {
                    <MudText Typo="Typo.body2" Class="mb-3">Logs in with your @Support.SubscriptionName, once. The login is then used on every Runner.</MudText>
                    <MudSelect T="Guid" @bind-Value="_runnerId" Label="Runner to log in from" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var runner in _runners)
                        {
                            <MudSelectItem Value="runner.Id">@runner.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                else
                {
                    <MudAlert Severity="@(_captured ? Severity.Success : Severity.Normal)" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                        @(_captured ? "Logged in. Saving the account..." : Support.LoginHelp)
                    </MudAlert>
                    <div class="login-terminal">
                        <TerminalView RunnerId="_runnerId" Command="@_loginCommand" ForwardResize="false" OutputReceived="OnOutputAsync" />
                    </div>
                }

                break;
            case "paste":
                <MudText Typo="Typo.body2" Class="mb-3">@Support.PasteHint</MudText>
                <MudTextField @bind-Value="_secret" Label="Token" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Class="mono-input" Immediate="true" />
                break;
            case "apikey":
                <MudText Typo="Typo.body2" Class="mb-3">Billed per use instead of a subscription. Agents get it as <code>@Support.ApiKeyName</code>.</MudText>
                <MudTextField @bind-Value="_secret" Label="@Support.ApiKeyName" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Class="mono-input" Immediate="true" />
                break;
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">@(_captured ? "Close" : "Cancel")</MudButton>
        @if (_method == "login")
        {
            @if (_loginCommand is null && _runners.Count > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Login" OnClick="StartLogin">Start login</MudButton>
            }
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy || string.IsNullOrWhiteSpace(_secret)" OnClick="SaveTypedAsync">Save</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    private const string DoneMarker = "__DAM_LOGIN_OK__";

    // Escape sequences (colors, cursor moves, OSC) come between the characters of what the login prints.
    private static readonly Regex Escapes = new(@"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(\x07|\x1b\\)|\x1b[()][A-Za-z0-9]|\x1b[=>]", RegexOptions.Compiled);

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string HarnessId { get; set; } = "";

    /// <summary>Set to log in again for an existing account.</summary>
    [Parameter]
    public Account? Existing { get; set; }

    private IHarness Harness => Accounts.GetHarness(HarnessId);

    private HarnessAccountSupport Support => Harness.AccountSupport!;

    private readonly StringBuilder _output = new();
    private List<Runner> _runners = [];
    private Guid _runnerId;
    private string _method = "login";
    private string? _name;
    private string? _secret;
    private string? _loginCommand;
    private string? _loginFolder;
    private bool _captured;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _runners = (await Runners.ListAsync()).Where(r => r.State == RunnerState.Ready && r.HarnessIds.Contains(HarnessId)).ToList();
        _runnerId = _runners.FirstOrDefault()?.Id ?? Guid.Empty;
        if (Existing?.Kind == AccountKind.ApiKey)
        {
            _method = "apikey";
        }
    }

    private void StartLogin()
    {
        _loginFolder = AccountService.NewLoginFolder();
        // The marker is printed in two parts, so it only appears once the login succeeded.
        _loginCommand = $"""
            export DAM_LOGIN_DIR="{_loginFolder}"; mkdir -p "$DAM_LOGIN_DIR"
            {Support.LoginCommand} && printf '\n%s%s\n' {DoneMarker[..8]} {DoneMarker[8..]}
            printf '\n(The login finished. You can close this window.)\n'; sleep 900
            """;
    }

    private async Task OnOutputAsync(string text)
    {
        if (_captured)
        {
            return;
        }

        _output.Append(text);
        if (_output.Length > 200_000)
        {
            _output.Remove(0, _output.Length - 100_000);
        }

        var clean = Escapes.Replace(_output.ToString(), "");
        string? secret = null;
        if (Support.TokenPattern is { } pattern && Regex.Match(clean, pattern) is { Success: true } match && match.Index + match.Length < clean.Length)
        {
            // Only once something follows it: the token may still be arriving.
            secret = match.Value;
        }
        else if (Support.LoginFile is { } file && clean.Contains(DoneMarker, StringComparison.Ordinal))
        {
            _captured = true;
            StateHasChanged();
            try
            {
                secret = await Accounts.ReadLoginFileAsync(_runners.First(r => r.Id == _runnerId), _loginFolder!, file);
            }
            catch (Exception ex)
            {
                _captured = false;
                Snackbar.Add($"Could not read the login: {ex.Message}", Severity.Error);
                return;
            }
        }

        if (secret is not null)
        {
            _captured = true;
            StateHasChanged();
            await SaveAsync(AccountKind.Subscription, secret);
        }
    }

    private Task SaveTypedAsync() => SaveAsync(_method == "apikey" ? AccountKind.ApiKey : AccountKind.Subscription, _secret ?? "");

    private async Task SaveAsync(AccountKind kind, string secret)
    {
        _busy = true;
        try
        {
            if (Existing is not null)
            {
                await Accounts.ReplaceSecretAsync(Existing.Id, kind, secret);
                Snackbar.Add($"'{Existing.Name}' is connected again. Agents use the new login from their next start.", Severity.Success);
            }
            else
            {
                var account = await Accounts.AddAsync(HarnessId, _name ?? "", kind, secret);
                Snackbar.Add($"{Harness.DisplayName} account '{account.Name}' connected.", Severity.Success);
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
