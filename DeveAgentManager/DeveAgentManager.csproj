<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Diagnostics/Protos/*.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeveAgentManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeveAgentManager.Client\DeveAgentManager.Client.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Core\DeveAgentManager.Core.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Providers.Proxmox\DeveAgentManager.Providers.Proxmox.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Harnesses.Pi\DeveAgentManager.Harnesses.Pi.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Harnesses.Claude\DeveAgentManager.Harnesses.Claude.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Harnesses.Codex\DeveAgentManager.Harnesses.Codex.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Harnesses.Grok\DeveAgentManager.Harnesses.Grok.csproj" />
  </ItemGroup>

  <!-- Compile before static web assets are discovered, including on a clean checkout. -->
  <Target Name="RestoreTypeScriptDependencies" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectDirectory)/../package.json;$(MSBuildProjectDirectory)/../package-lock.json"
          Outputs="$(MSBuildProjectDirectory)/../node_modules/.package-lock.json">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/.." Command="npm ci --ignore-scripts" />
  </Target>
  <Target Name="CompileBrowserTypeScript" BeforeTargets="PrepareForBuild" DependsOnTargets="RestoreTypeScriptDependencies" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)/.." Command="npm run build" />
    <ItemGroup>
      <EmbeddedResource Include="wwwroot/js/theme-startup.js" LogicalName="BrowserScripts.theme-startup.js" />
      <EmbeddedResource Include="wwwroot/js/editor-auth.js" LogicalName="BrowserScripts.editor-auth.js" />
      <Content Include="wwwroot/js/**/*.js" Exclude="@(Content)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
