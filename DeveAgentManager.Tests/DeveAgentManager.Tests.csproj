<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harness screens captured while they worked and while they waited, for the busy patterns. -->
    <None Include="Screens\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Js\*.cjs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\DeveAgentManager\wwwroot\js\terminal-touch-input.js" Link="Js\terminal-touch-input.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeveAgentManager.Core\DeveAgentManager.Core.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Providers.Proxmox\DeveAgentManager.Providers.Proxmox.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Client\DeveAgentManager.Client.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Harnesses.Pi\DeveAgentManager.Harnesses.Pi.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Harnesses.Claude\DeveAgentManager.Harnesses.Claude.csproj" />
    <ProjectReference Include="..\DeveAgentManager.Harnesses.Codex\DeveAgentManager.Harnesses.Codex.csproj" />
    <ProjectReference Include="..\DeveAgentManager\DeveAgentManager.csproj" />
  </ItemGroup>

</Project>
